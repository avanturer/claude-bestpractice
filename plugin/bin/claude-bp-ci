#!/usr/bin/env python3
"""Choose where the checks run. Local is the default and is installed at setup.

    claude-bp-ci status     what runs where, and what it costs
    claude-bp-ci local      install the pre-push hook
    claude-bp-ci github     switch the hosted workflow on
    claude-bp-ci github --off
    claude-bp-ci off        remove the pre-push hook

The reasoning behind the default is in `claude_bestpractice.ci`.
"""

from __future__ import annotations

import argparse
import shlex
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from claude_bestpractice import ci, config, hookio  # noqa: E402
from claude_bestpractice.gitctx import resolve_for_cli  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description="Choose where the checks run.")
    parser.add_argument(
        "command", nargs="?", default="status",
        choices=["status", "local", "github", "off", "record-green", "record-run",
                 "green-covers-tree"],
    )
    parser.add_argument(
        "ran", nargs="?", default="", help="with `record-green`, the command that passed"
    )
    parser.add_argument("--off", action="store_true", help="with `github`, switch it back off")
    parser.add_argument(
        "--print-test-command",
        action="store_true",
        help="print the project's own test command, for the pre-push hook to run",
    )
    args = parser.parse_args()
    ctx = resolve_for_cli()

    if args.command == "record-green":
        # Called by the pre-push hook after the project's own checks passed. The plugin
        # ran them and saw the exit code, which is the same standard the Stop gate uses —
        # and until #83 that observation was discarded, so the one session able to merge
        # was asked for evidence only a session in the branch's own tree could create.
        from claude_bestpractice import evidence

        # Prints. A command that performs no visible action, changes no state the caller
        # can see and says nothing is indistinguishable from a failing one — which is
        # exactly how it was reported: "whether record-green is broken or whether I am
        # calling it wrong; that ambiguity is itself the report" (#152).
        ran = args.ran.split() or ["pre-push"]
        cleared = evidence.record_green(ctx, ran)
        where = evidence._green_path(ctx)
        print(f"recorded green: {' '.join(ran)} on {ctx.branch}")
        print(f"  {where}")
        if cleared:
            print("  cleared the recorded failure for this branch")
        elif evidence.red(ctx):
            entry = evidence.red(ctx)
            print(f"  a recorded failure REMAINS: {' '.join(entry.get('command') or [])} "
                  f"on {entry.get('branch') or '?'} — only that same command passing "
                  "clears it")
        return 0

    if args.command == "record-run":
        # Called by the pre-push hook when the project's own checks FAILED. The plugin ran
        # them and saw the exit code; throwing that away is why three surfaces reported "no
        # test run has ever been observed on this branch" about a branch whose full suite
        # had just run for fourteen minutes in this very hook (#198).
        #
        # A fact, not a blocker. The red ledger is not used here on purpose: it holds a
        # merge until THE SAME COMMAND passes, and the hook's command is routinely not the
        # gate's — the hook runs `make test`, the gate drives `pytest` directly when it
        # can. A failure banked there could be cleared by neither, and a `--no-verify`
        # push removes the one later hook run that might have.
        from claude_bestpractice import evidence

        ran = args.ran.split() or ["pre-push"]
        evidence.record_run(ctx, ran, passed=False)
        print(f"recorded a FAILED run: {' '.join(ran)} on {ctx.branch}")
        print(f"  {evidence._run_path(ctx)}")
        print("  this does not block a merge; what blocks is what the gate itself ran")
        return 0

    if args.command == "green-covers-tree":
        # Exit 0 only when the suite was observed green on EXACTLY this tree. The hook
        # skips on 0 and runs on anything else, so every uncertain answer — no record, a
        # dirty tree, an unreadable stamp — costs a run rather than granting a pass.
        from claude_bestpractice import evidence

        # Says which way it went. The exit code alone reads as success in both directions
        # to anyone checking `echo $?` — 0 means covered, and 0 is also what a command
        # that did nothing returns.
        covered = evidence.green_covers_tree(ctx)
        print("covered: this tree was observed green" if covered
              else "not covered: the suite must run again on this tree")
        return 0 if covered else 1

    if args.print_test_command:
        # The hook needs the SAME command the Stop gate resolves, or the two disagree
        # about what "the tests" means and the push gate reports success over a red
        # suite. Silence when nothing is detectable; the hook treats that as "skip".
        command = config.load(ctx).test_command or config.detect_test_command(ctx.worktree_root)
        if command:
            print(shlex.join(command))
        return 0

    if args.command == "status":
        print("\n".join(ci.status_lines(ctx)))
        return 0

    if args.command == "local":
        changed, note = ci.install(ctx)
        print(note)
        if changed:
            print("every push now runs the checks first. Bypass once with: git push --no-verify")
        return 0

    if args.command == "off":
        _, note = ci.remove(ctx)
        print(note)
        return 0

    ok, note = ci.set_hosted(ctx, on=not args.off)
    print(note)
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(hookio.run_cli(main))
