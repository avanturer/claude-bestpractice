#!/usr/bin/env python3
"""Setup: make a brand-new repository work without anyone configuring anything.

Fires on `--init`/`--init-only`, not on every session start. That distinction matters
with several sessions running: plugin install state is global and lives in shared JSON,
so provisioning from SessionStart would be a concurrent read-modify-write from every
session at once.

What it does is deliberately small — derive the knowledge layer from the code, create
the plan directories, seed the stage — and it is idempotent. It never overwrites an
answer a human already gave.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from founder_os import ci, hookio, onboard, plan, stage, store  # noqa: E402
from founder_os.gitctx import resolve  # noqa: E402


def main() -> None:
    event = hookio.read_event()
    ctx = hookio.repo(event.cwd or os.getcwd())

    store.ensure_dir(store.tier_b(ctx))
    for state in plan.STATES:
        store.ensure_dir(plan.plan_dir(ctx, state))

    written = onboard.write(ctx)
    resolved, _ = stage.current(ctx)
    gaps = onboard.unanswered(ctx)

    # Local checks are the DEFAULT, installed here rather than offered. An opt-in check
    # that nobody opted into is the same as no check, and hosted minutes are a metered
    # budget that three to eight parallel sessions spend like a small team.
    hook_installed, hook_note = ci.install(ctx)

    lines = [f"founder-os is set up. Detected stage: {resolved}."]
    if hook_installed:
        lines.append(
            "Checks now run locally before every push (`founder-os-ci status` to see, "
            "`founder-os-ci github` to add hosted CI)."
        )
    if written:
        lines.append("Derived from your code: " + ", ".join(written))
    if gaps:
        # Named, never invented. A fabricated product description is worse than an
        # absent one, because the agent will believe it and build against it.
        lines.append(
            "These cannot be derived and are waiting on a human answer: "
            + "; ".join(gaps)
            + ". Ask the user for them when it is relevant, do not guess."
        )
    lines.append("Run `founder-os status` to see everything at once.")

    hookio.emit_context("Setup", "\n".join(lines), limit=1_500)


if __name__ == "__main__":
    hookio.guard(main, fail_closed=False)
