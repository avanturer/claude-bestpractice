#!/usr/bin/env python3
"""Setup: make a brand-new repository work without anyone configuring anything.

Fires on `--init`/`--init-only`, not on every session start. That distinction matters
with several sessions running: plugin install state is global and lives in shared JSON,
so provisioning from SessionStart would be a concurrent read-modify-write from every
session at once.

What it does is deliberately small — derive the knowledge layer from the code, create
the plan directories, seed the stage — and it is idempotent. It never overwrites an
answer a human already gave.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from claude_bestpractice import ci, config, hookio, onboard, plan, policy, stage, store  # noqa: E402
from claude_bestpractice.gitctx import resolve  # noqa: E402


def main() -> None:
    event = hookio.read_event()
    ctx = hookio.repo(event.cwd or os.getcwd())

    store.ensure_dir(store.tier_b(ctx))
    for state in plan.STATES:
        store.ensure_dir(plan.plan_dir(ctx, state))

    written = onboard.write(ctx)
    resolved, _ = stage.current(ctx)
    gaps = onboard.unanswered(ctx)

    # Local checks are the DEFAULT, installed here rather than offered. An opt-in check
    # that nobody opted into is the same as no check, and hosted minutes are a metered
    # budget that three to eight parallel sessions spend like a small team.
    hook_installed, hook_note = ci.install(ctx)

    # Told to auto mode once, here, because this is the derivation moment for everything
    # else too. Facts about this repository only — never a grant — so this cannot widen
    # what may proceed unattended, and the founder's own rules are carried through
    # untouched (#113).
    written_policy = policy.apply(ctx, config.load(ctx).test_command)

    lines = [f"claude-bestpractice is set up. Detected stage: {resolved}."]
    if hook_installed:
        lines.append(
            "Checks now run locally before every push (`claude-bp-ci status` to see, "
            "`claude-bp-ci github` to add hosted CI)."
        )
        # `hook_note` was computed and thrown away, so displacing the founder's own
        # pre-push hook — husky's, lefthook's — happened without a word. It chains
        # correctly now, but chaining silently is still the wrong half of the fix: the
        # one thing they must be told is that a file of theirs moved.
        if "moved to" in hook_note:
            lines.append(hook_note.split("\n", 1)[-1].strip())
    if written_policy.add:
        lines.append(
            f"Auto mode now knows what this repository is ({len(written_policy.add)} fact(s) "
            "in your settings, marked and regenerated — your own rules were not touched)."
        )
    if written_policy.dead:
        lines.append(
            f"{len(written_policy.dead)} rule(s) in permissions.allow no longer do anything "
            "here — `claude-bp policy` names them; deleting them is yours."
        )
    if written:
        lines.append("Derived from your code: " + ", ".join(written))
    if gaps:
        # Named, never invented. A fabricated product description is worse than an
        # absent one, because the agent will believe it and build against it.
        lines.append(
            "These cannot be derived and are waiting on a human answer: "
            + "; ".join(gaps)
            + ". Ask the user for them when it is relevant, do not guess."
        )
    lines.append("Run `claude-bp status` to see everything at once.")

    hookio.emit_context("Setup", "\n".join(lines), limit=1_500)


if __name__ == "__main__":
    hookio.guard(main, fail_closed=False)
