#!/usr/bin/env python3
"""The work ledger: add, claim, finish, and see what every session is doing.

State lives in directories, so `git mv` is the transition and `git log` is the
history. Nothing here needs a server, a database, or a daemon — five parallel
sessions each write their own file and merge without conflict.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from claude_bestpractice import hookio, plan, sessions  # noqa: E402
from claude_bestpractice.gitctx import resolve_for_cli  # noqa: E402


def cmd_add(ctx, title: str, body: str) -> int:
    task = plan.add(ctx, title, body, branch=ctx.branch)
    print(f"{task.id}  {task.title}")
    print(f"  {task.path.relative_to(ctx.worktree_root)}")
    return 0


def cmd_list(ctx, state: str) -> int:
    tasks = plan.load_all(ctx, state)
    if not tasks:
        print("plan is empty" if not state else f"nothing in {state}")
        return 0

    live = {rec.session_id for rec in sessions.live_sessions(ctx)}
    for name in ([state] if state else list(plan.STATES)):
        rows = [t for t in tasks if t.state == name]
        if not rows:
            continue
        print(f"\n{name.upper()}")
        for task in rows:
            mark = ""
            if task.owner:
                mark = f"  [{task.owner[:8]}{'' if task.owner in live else ' — DEAD, reclaimable'}]"
            print(f"  {task.id}  {task.title[:90]}{mark}")
    counts = plan.summary(ctx)
    print(f"\n{counts['next']} next · {counts['doing']} in flight · {counts['done']} done")
    return 0


def cmd_claim(ctx, task_id: str, session_id: str) -> int:
    task, error = plan.claim(ctx, task_id, session_id or f"cli-{ctx.branch}", ctx.branch)
    if error:
        print(error, file=sys.stderr)
        return 1
    print(f"claimed {task.id}  {task.title}")
    return 0


def cmd_done(ctx, task_id: str) -> int:
    task, error = plan.complete(ctx, task_id)
    if error:
        print(error, file=sys.stderr)
        return 1
    print(f"done {task.id}  {task.title}")
    return 0


def cmd_park(ctx, title: str, paths: str, note: str, source: str = "") -> int:
    wanted = [p.strip() for p in paths.split(",") if p.strip()]
    problems = plan.handoff_problems(wanted, note)
    if problems:
        print("not a handoff somebody else could pick up:", file=sys.stderr)
        for problem in problems:
            print(f"  - {problem}", file=sys.stderr)
        print("\n  claude-bp-plan park \"<title>\" --paths a.py,b.py --note \"<what is known, "
              "what was ruled out, where it stands>\"", file=sys.stderr)
        return 1

    missing = [p for p in wanted if not (ctx.worktree_root / p).exists()]
    if missing:
        # Named but absent is worth saying rather than refusing: a task can legitimately
        # be about a file that does not exist yet, and a gate that cannot tell the
        # difference should not be the one deciding.
        print(f"note: {', '.join(missing)} not in the tree yet")

    task = plan.park(ctx, title, body=note, branch=ctx.branch, paths=wanted, source=source)
    print(f"parked {task.id}  {task.title}")
    print(f"pick it up in another session with: claude-bp-plan show {task.id}")
    return 0


def cmd_show(ctx, task_id: str) -> int:
    task = plan.find(ctx, task_id)
    if task is None:
        print(f"no task {task_id}", file=sys.stderr)
        return 1
    print(plan.show(task))
    return 0


def cmd_adopt(ctx, brief: str, check: str, ignore: str) -> int:
    from claude_bestpractice import migrate

    if ignore:
        migrate.ignore(ctx, ignore)
        print(f"{ignore} left alone; it will not be raised again")
        return 0

    if brief or check:
        target = ctx.worktree_root / (brief or check)
        if not target.is_file():
            print(f"no such document: {brief or check}", file=sys.stderr)
            return 1
        if brief:
            print(migrate.brief(ctx, target))
            return 0
        total, migrated = migrate.coverage(ctx, target)
        left = total - migrated
        print(f"{check}: {total} open item(s), {migrated} in the ledger, {left} left")
        return 0 if left <= 0 else 1

    # Scratch notes the plugin's own absence caused: mechanical, unambiguous, imported.
    for path in migrate.parked_by_hand(ctx):
        task_id = migrate.adopt(ctx, path)
        print(f"adopted {path.relative_to(ctx.worktree_root)} -> task {task_id}")

    # Everything else is prose, and prose is the agent's job rather than a regex's.
    outstanding = []
    for path in migrate.registries(ctx):
        total, migrated = migrate.coverage(ctx, path)
        if total > migrated:
            outstanding.append((path.relative_to(ctx.worktree_root).as_posix(), total - migrated))
    if not outstanding:
        print("nothing tracked outside the ledger")
        return 0

    print("work tracked outside the ledger:\n")
    for relative, left in outstanding:
        print(f"  {relative}  —  {left} open item(s) not in the ledger")
    print("\nThese are documents, not scratch files, so nothing was moved. For each one:")
    print("  claude-bp-plan adopt --brief <file>    what to migrate, and how")
    print("  claude-bp-plan adopt --check <file>    how much is left, counted")
    print("  claude-bp-plan adopt --ignore <file>   it is curated; stop raising it")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="claude-bestpractice work ledger")
    sub = parser.add_subparsers(dest="command")

    add = sub.add_parser("add", help="add a task to next")
    add.add_argument("title")
    add.add_argument("--body", default="")

    listing = sub.add_parser("list", help="show the plan (default)")
    listing.add_argument("--state", choices=plan.STATES, default="")

    claim = sub.add_parser("claim", help="take a task and move it to doing")
    claim.add_argument("task_id")
    claim.add_argument("--session", default="")

    done = sub.add_parser("done", help="move a task to done")
    done.add_argument("task_id")

    park = sub.add_parser("park", help="hand a task to a session that has not happened yet")
    park.add_argument("title")
    park.add_argument("--paths", default="", help="comma-separated files the next session opens")
    park.add_argument("--note", default="", help="what is known, what was ruled out, where it stands")
    park.add_argument("--source", default="", help="the document this was migrated out of")

    show = sub.add_parser("show", help="everything a parked task carries")
    show.add_argument("task_id")

    adopt = sub.add_parser("adopt", help="bring work tracked outside the ledger into it")
    adopt.add_argument("--brief", default="", help="what to migrate out of this document")
    adopt.add_argument("--check", default="", help="count what is still not migrated")
    adopt.add_argument("--ignore", default="", help="this document is curated; leave it alone")

    args = parser.parse_args()
    ctx = resolve_for_cli()

    if args.command == "add":
        return cmd_add(ctx, args.title, args.body)
    if args.command == "claim":
        return cmd_claim(ctx, args.task_id, args.session)
    if args.command == "done":
        return cmd_done(ctx, args.task_id)
    if args.command == "park":
        return cmd_park(ctx, args.title, args.paths, args.note, args.source)
    if args.command == "show":
        return cmd_show(ctx, args.task_id)
    if args.command == "adopt":
        return cmd_adopt(ctx, args.brief, args.check, args.ignore)
    return cmd_list(ctx, getattr(args, "state", ""))


if __name__ == "__main__":
    raise SystemExit(hookio.run_cli(main))
