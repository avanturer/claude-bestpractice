#!/usr/bin/env python3
"""The work ledger: add, claim, finish, and see what every session is doing.

State lives in directories, so `git mv` is the transition and `git log` is the
history. Nothing here needs a server, a database, or a daemon — five parallel
sessions each write their own file and merge without conflict.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from claude_bestpractice import hookio, plan, sessions, store  # noqa: E402
from claude_bestpractice.gitctx import resolve_for_cli  # noqa: E402


def _durability_warning(ctx, what: str = "task") -> str:
    """Empty unless the ledger is being written where git cannot see it.

    Printed by the commands that write, because that is where the false claim was made:
    `parked 0017 …` followed by `pick it up in another session` is a promise the plugin
    cannot keep when an ignore rule covers the directory. Issue #66. `--ignore` makes the
    same promise in the same place — "it will not be raised again" — and needs the same
    correction when nothing will carry the decision out of this checkout.
    """
    where = store.hidden_from_git(ctx)
    if not where:
        return ""
    return (
        f"\nWARNING: git cannot see {store.TIER_A_DIRNAME}/ — hidden by {where}.\n"
        f"This {what} exists on disk and nowhere else: no commit will pick it up and\n"
        "`git worktree remove` deletes it. Nothing was lost yet — fix that rule, then\n"
        "commit the ledger. Tell the founder; the plugin will not edit an ignore file\n"
        "it did not write."
    )


def cmd_add(ctx, title: str, body: str, paths: str = "", done_when: str = "",
            after: str = "", together: str = "") -> int:
    task = plan.add(ctx, title, body, branch=ctx.branch,
                    paths=_list(paths), done_when=done_when,
                    after=_list(after), together=_list(together))
    print(f"{task.id}  {task.title}")
    print(f"  {task.path.relative_to(ctx.worktree_root)}")
    if not body and not paths:
        # Nothing marked `add` as the impoverished one, so thirteen tasks were filed with
        # it and their files backfilled by hand afterwards. Said once, at the moment the
        # difference is still cheap to fix.
        print("  no detail and no files — if another session picks this up, "
              "`claude-bp-plan park` carries what they will need")
    return 0


def _list(raw: str) -> list[str]:
    return [item.strip() for item in raw.split(",") if item.strip()]


def cmd_list(ctx, state: str) -> int:
    tasks = plan.load_all(ctx, state)
    if not tasks:
        print("plan is empty" if not state else f"nothing in {state}")
        return 0

    for name in ([state] if state else list(plan.STATES)):
        rows = [t for t in tasks if t.state == name]
        if not rows:
            continue
        print(f"\n{name.upper()}")
        for task in rows:
            note = plan.activity(ctx, task) or (f"waiting: {task.blocker}" if task.blocker else "")
            order = plan.relations(ctx, task)
            both = "; ".join(part for part in (note, order) if part)
            print(f"  {task.id}  {task.title[:90]}{'  [' + both + ']' if both else ''}")
    counts = plan.summary(ctx)
    # `ready` and not just `next`, because "what can I safely start right now" is the
    # question an implementing session opens with, and a flat count cannot answer it.
    ready = len(plan.startable(ctx))
    print(f"\n{counts['next']} next ({ready} ready to start) · {counts['doing']} in flight · "
          f"{counts.get('paused', 0)} paused · {counts['done']} done")
    return 0


def cmd_claim(ctx, task_id: str, session_id: str) -> int:
    # The session this CLI is running inside, when it is running inside one. Stamping
    # `cli-<branch>` made the owner somebody the registry had never heard of: the board
    # said "claimed by cli-main, which has no record — reclaimable" for a task a live chat
    # was working on, and the Stop demand could not be satisfied by its own instruction.
    session_id = session_id or hookio.current_session_id(str(ctx.worktree_root)) or f"cli-{ctx.branch}"
    wanted = plan.find(ctx, task_id)
    waiting = plan.blockers(ctx, wanted) if wanted else []
    task, error = plan.claim(ctx, task_id, session_id, ctx.branch)
    if error:
        print(error, file=sys.stderr)
        return 1
    print(f"claimed {task.id}  {task.title}")
    if waiting:
        # Said, not refused. Starting ahead of the order is sometimes right and the
        # session knows things this does not; starting ahead of it WITHOUT KNOWING is
        # what cost a measurement that could no longer be taken (#104).
        for other in waiting:
            found = plan.find(ctx, other)
            where = f"still in {found.state}" if found else "no such task"
            print(f"  WARNING: {other} has not landed ({where}) — this task said it "
                  f"comes after it", file=sys.stderr)
    if task.together:
        print(f"  ships in the same change as {', '.join(task.together)}", file=sys.stderr)
    return 0


def cmd_done(ctx, task_id: str) -> int:
    task, error = plan.complete(ctx, task_id)
    if error:
        print(error, file=sys.stderr)
        return 1
    print(f"done {task.id}  {task.title}")
    return 0


def cmd_park(ctx, title: str, paths: str, note: str, source: str = "",
             done_when: str = "", after: str = "", together: str = "") -> int:
    wanted = [p.strip() for p in paths.split(",") if p.strip()]
    problems = plan.handoff_problems(wanted, note)
    if problems:
        print("not a handoff somebody else could pick up:", file=sys.stderr)
        for problem in problems:
            print(f"  - {problem}", file=sys.stderr)
        print("\n  claude-bp-plan park \"<title>\" --paths a.py,b.py --note \"<what is known, "
              "what was ruled out, where it stands>\"", file=sys.stderr)
        return 1

    missing = [p for p in wanted if not (ctx.worktree_root / p).exists()]
    if missing:
        # Named but absent is worth saying rather than refusing: a task can legitimately
        # be about a file that does not exist yet, and a gate that cannot tell the
        # difference should not be the one deciding.
        print(f"note: {', '.join(missing)} not in the tree yet")

    task = plan.park(ctx, title, body=note, branch=ctx.branch, paths=wanted, source=source,
                     done_when=done_when, after=_list(after), together=_list(together))
    print(f"parked {task.id}  {task.title}")
    warning = _durability_warning(ctx)
    if warning:
        # Deliberately not a non-zero exit: the file WAS written, and a caller that reads
        # failure here would park the same task again. The claim is what gets corrected,
        # not the outcome — "pick it up in another session" is the sentence that was false.
        print(warning, file=sys.stderr)
        return 0
    print(f"pick it up in another session with: claude-bp-plan show {task.id}")
    return 0


def cmd_show(ctx, task_id: str) -> int:
    task = plan.find(ctx, task_id)
    if task is None:
        print(f"no task {task_id}", file=sys.stderr)
        return 1
    print(plan.show(task))
    return 0


def cmd_adopt(ctx, brief: str, check: str, ignore: str) -> int:
    from claude_bestpractice import migrate

    if ignore:
        # Several at once: a repository that has kept its registries by hand has more
        # than one of them, and five invocations to say one thing is a tax on the
        # decision rather than a record of it.
        wanted = [p.strip() for p in ignore.split(",") if p.strip()]
        # Said, not refused. A typo must not read as done — but refusing an absent path
        # deadlocks the one flow that needs this most: the write gate refuses to CREATE a
        # registry and names this command as the way to say "this one is mine", and the
        # file does not exist yet precisely because the gate just refused it (#103).
        # `park` settled the same question the same way: name it, record it, move on.
        missing = [r for r in wanted if not (ctx.worktree_root / r).is_file()]
        if missing:
            print(f"note: {', '.join(missing)} not in the tree yet")
        for relative in wanted:
            migrate.ignore(ctx, relative)
            print(f"{relative} left alone; it will not be raised again")
        warning = _durability_warning(ctx, "decision")
        if warning:
            print(warning, file=sys.stderr)
        return 0

    if brief or check:
        target = ctx.worktree_root / (brief or check)
        if not target.is_file():
            print(f"no such document: {brief or check}", file=sys.stderr)
            return 1
        if brief:
            print(migrate.brief(ctx, target))
            return 0
        if migrate.is_ignored(ctx, check):
            # Said once, and then contradicted by the next command with a non-zero exit a
            # script could act on. Whichever answer is right, the pair cannot both be.
            print(f"{check}: curated by hand — left alone, and nothing is counted "
                  "against it.")
            where = migrate.ignored_by(ctx, check)
            print(f"Recorded in {where or store.TIER_A_DIRNAME + '/' + migrate.IGNORED} — "
                  "delete that entry to have it counted again.")
            return 0
        text = target.read_text(encoding="utf-8", errors="replace")
        total, migrated = migrate.coverage(ctx, target)
        if migrate.unenumerable(text):
            # Reporting "0 left" here would be a green light nobody earned.
            print(f"{check}: {migrated} task(s) in the ledger from this document.")
            print(f"How many remain is unknown — this recognises only {migrate.RECOGNISED},")
            print("and this document is not one. Read it rather than trusting a count.")
            return 0
        left = total - migrated
        print(f"{check}: {total} open item(s), {migrated} in the ledger, {left} left")
        return 0 if left <= 0 else 1

    # Scratch notes the plugin's own absence caused: mechanical, unambiguous, imported.
    for path in migrate.parked_by_hand(ctx):
        task_id = migrate.adopt(ctx, path)
        print(f"adopted {path.relative_to(ctx.worktree_root)} -> task {task_id}")

    # Everything else is prose, and prose is the agent's job rather than a regex's.
    outstanding = []
    for path in migrate.registries(ctx):
        total, migrated = migrate.coverage(ctx, path)
        if total > migrated:
            outstanding.append((path.relative_to(ctx.worktree_root).as_posix(), total - migrated))
    if not outstanding:
        # NOT "nothing tracked outside the ledger". That is a claim about the repository,
        # and this only ever looked for one shape — a registry keyed by id and status is
        # invisible to it and is exactly what this feature is for. A false all-clear is
        # worse than no answer: it is the quiet failure this whole project is written
        # against, committed by the thing that warns about it.
        print(f"no documents found tracking work in {migrate.RECOGNISED}.")
        print(migrate.INCOMPLETE)
        return 0

    print("work tracked outside the ledger:\n")
    for relative, left in outstanding:
        print(f"  {relative}  —  {left} open item(s) not in the ledger")
    print("\nThese are documents, not scratch files, so nothing was moved. For each one:")
    print("  claude-bp-plan adopt --brief <file>    what to migrate, and how")
    print("  claude-bp-plan adopt --check <file>    how much is left, counted")
    print("  claude-bp-plan adopt --ignore <file>   it is curated; stop raising it")
    # The list above is not the answer to "what is outstanding", it is the answer to
    # "what could be seen". Saying so only when the list is EMPTY got the distinction
    # exactly backwards: a one-item list is what a reader believes.
    print(f"\n{migrate.INCOMPLETE}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="claude-bestpractice work ledger")
    sub = parser.add_subparsers(dest="command")

    add = sub.add_parser("add", help="add a task to next")
    add.add_argument("title")
    add.add_argument("--body", default="")
    add.add_argument("--paths", default="", help="the files this touches, comma separated")
    add.add_argument("--done-when", dest="done_when", default="",
                     help="what has to be true for this to be finishable")
    add.add_argument("--after", default="",
                     help="task ids that must land before this one is correct")
    add.add_argument("--with", dest="together", default="",
                     help="task ids this must ship together with")

    listing = sub.add_parser("list", help="show the plan (default)")
    listing.add_argument("--state", choices=plan.STATES, default="")
    paused = sub.add_parser("pause", help="stop work and say what would restart it")
    paused.add_argument("id")
    paused.add_argument("--blocker", required=True,
                        help="the decision, credential, merge or answer this waits on")
    resumed = sub.add_parser("resume", help="return a paused task to the queue")
    resumed.add_argument("id")
    amended = sub.add_parser("update", help="amend what a task knows, keeping its identity")
    amended.add_argument("id")
    amended.add_argument("--note", default="", help="replace the handoff")
    amended.add_argument("--paths", default="", help="replace the files, comma separated")
    amended.add_argument("--done-when", dest="done_when", default="",
                         help="what has to be true for this to be finishable")

    claim = sub.add_parser("claim", help="take a task and move it to doing")
    claim.add_argument("task_id")
    claim.add_argument("--session", default="")

    done = sub.add_parser("done", help="move a task to done")
    done.add_argument("task_id")

    park = sub.add_parser("park", help="hand a task to a session that has not happened yet")
    park.add_argument("title")
    park.add_argument("--paths", default="", help="comma-separated files the next session opens")
    park.add_argument("--note", default="", help="what is known, what was ruled out, where it stands")
    park.add_argument("--source", default="", help="the document this was migrated out of")
    park.add_argument("--done-when", dest="done_when", default="",
                      help="what has to be true for this to be finishable")
    park.add_argument("--after", default="",
                      help="task ids that must land before this one is correct")
    park.add_argument("--with", dest="together", default="",
                      help="task ids this must ship together with")

    show = sub.add_parser("show", help="everything a parked task carries")
    show.add_argument("task_id")

    adopt = sub.add_parser("adopt", help="bring work tracked outside the ledger into it")
    adopt.add_argument("--brief", default="", help="what to migrate out of this document")
    adopt.add_argument("--check", default="", help="count what is still not migrated")
    adopt.add_argument("--ignore", default="",
                       help="these documents are curated; leave them alone (comma separated)")

    args = parser.parse_args()
    ctx = resolve_for_cli()

    if args.command == "add":
        return cmd_add(ctx, args.title, args.body, args.paths, args.done_when,
                       args.after, args.together)
    if args.command == "claim":
        return cmd_claim(ctx, args.task_id, args.session)
    if args.command == "done":
        return cmd_done(ctx, args.task_id)
    if args.command == "pause":
        task, problem = plan.pause(ctx, args.id, args.blocker)
        if task is None:
            print(problem, file=sys.stderr)
            return 1
        print(f"paused {task.id} — waiting on: {task.blocker}")
        return 0

    if args.command == "resume":
        task, problem = plan.resume(ctx, args.id)
        if task is None:
            print(problem, file=sys.stderr)
            return 1
        print(f"resumed {task.id} — back in the queue")
        return 0

    if args.command == "update":
        wanted = [p.strip() for p in args.paths.split(",") if p.strip()] if args.paths else None
        task, problem = plan.amend(ctx, args.id, args.note, wanted, args.done_when)
        if task is None:
            print(problem, file=sys.stderr)
            return 1
        print(f"updated {task.id}")
        return 0

    if args.command == "park":
        return cmd_park(ctx, args.title, args.paths, args.note, args.source,
                        args.done_when, args.after, args.together)
    if args.command == "show":
        return cmd_show(ctx, args.task_id)
    if args.command == "adopt":
        return cmd_adopt(ctx, args.brief, args.check, args.ignore)
    return cmd_list(ctx, getattr(args, "state", ""))


if __name__ == "__main__":
    raise SystemExit(hookio.run_cli(main))
