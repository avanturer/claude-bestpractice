#!/usr/bin/env python3
"""SubagentStart: hand a subagent the constraints it cannot inherit.

Non-fork subagents inherit the project rule hierarchy — except the built-in Explore
and Plan agents, which skip it, and there is no setting that changes that. Output
styles and auto memory never reach any non-fork subagent at all.

With several sessions each spawning Explore and Plan, a large share of all agent turns
run with zero project rules loaded. Hooks and permission rules still apply inside them
— enforcement inherits — but awareness does not. This closes that gap with the
smallest possible payload.

Fails open: a subagent starting without a brief is worse than one that never starts.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from founder_os import hookio, knowledge, repomap  # noqa: E402
from founder_os.gitctx import resolve  # noqa: E402

# Deliberately small. This is re-paid on every spawn, and at several parallel sessions
# it is the dominant recurring cost in the whole design.
BRIEF_CHAR_BUDGET = 2_000

# A ranked map only earns its place once orientation is genuinely hard. Below this many
# files a subagent can just look, and paying for a map would be pure overhead.
REPOMAP_MIN_FILES = 40
REPOMAP_TOKEN_BUDGET = 400


def main() -> None:
    event = hookio.read_event()
    ctx = hookio.repo(event.cwd or os.getcwd())

    parts = [knowledge.subagent_brief(ctx, max_chars=BRIEF_CHAR_BUDGET)]

    # Query-biased, so each subagent gets a map of what ITS task is about rather than a
    # generic overview. This is the one thing grep structurally cannot provide.
    try:
        facts = repomap.scan(ctx)
        if len(facts) >= REPOMAP_MIN_FILES:
            query = " ".join(
                str(event.raw.get(key, "")) for key in ("agent_type", "description", "prompt")
            )
            rendered = repomap.generate(ctx, query=query, budget_tokens=REPOMAP_TOKEN_BUDGET)
            if rendered:
                parts.append("## Where things are\n" + rendered)
    except Exception:  # noqa: BLE001 - a map is a hint; never fail a spawn over one
        pass

    brief = "\n\n".join(p for p in parts if p.strip())
    if not brief.strip():
        hookio.emit_silent()

    hookio.emit_context("SubagentStart", brief, limit=BRIEF_CHAR_BUDGET + 2_000)


if __name__ == "__main__":
    hookio.guard(main, fail_closed=False)
