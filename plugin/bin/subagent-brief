#!/usr/bin/env python3
"""SubagentStart: hand a subagent the constraints it cannot inherit.

Non-fork subagents inherit the project rule hierarchy — except the built-in Explore
and Plan agents, which skip it, and there is no setting that changes that. Output
styles and auto memory never reach any non-fork subagent at all.

With several sessions each spawning Explore and Plan, a large share of all agent turns
run with zero project rules loaded. Hooks and permission rules still apply inside them
— enforcement inherits — but awareness does not. This closes that gap with the
smallest possible payload.

Fails open: a subagent starting without a brief is worse than one that never starts.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

# An old copy's command runs the newest installed copy's instead, so a chat started
# before an update is gated by the version on disk (decision 0102).
from claude_bestpractice import upgrade as _upgrade  # noqa: E402

_upgrade.handover(Path(__file__))

from claude_bestpractice import hookio, knowledge, repomap  # noqa: E402
from claude_bestpractice.gitctx import resolve  # noqa: E402

# Deliberately small. This is re-paid on every spawn, and at several parallel sessions
# it is the dominant recurring cost in the whole design.
BRIEF_CHAR_BUDGET = 2_000

# The cards of the spawning session an agent is told of, and how much of each.
CARDS_TOLD = 2
CARD_CHARS = 400


def the_card_it_works_under(ctx, session_id: str) -> str:
    """The card the session that started this agent holds, as facts: what the work is, when it
    is done, the files it names (decision 0078). "" where the session holds none.

    An agent is handed a task and nothing of the work it is part of: the files that work names
    are what the session's finish measures drift against, and an agent that cannot see them
    edits beside them. DeepSeek Harness gives a worker its ticket's scope for the same reason.
    """
    from claude_bestpractice import plan, redact, sessions

    rec = sessions.get(ctx, session_id)
    lines = []
    for card in plan.held_by(ctx, rec.session_id if rec else session_id)[:CARDS_TOLD]:
        said = f"This agent works under card {card.id}, \"{card.title}\""
        if card.done_when:
            said += f", done when {card.done_when}"
        if card.paths:
            said += f". Its files: {', '.join(card.paths[:12])}; files beyond them count as drift"
        lines.append(redact.scrub(redact.strip_control(said))[:CARD_CHARS] + ".")
    return "\n".join(lines)



def main() -> None:
    event = hookio.read_event()
    ctx = hookio.repo(event.cwd or os.getcwd())

    parts = [knowledge.subagent_brief(ctx, max_chars=BRIEF_CHAR_BUDGET)]
    try:
        parts.append(the_card_it_works_under(ctx, event.session_id))
    except Exception:  # noqa: BLE001 - the card is a hint; never fail a spawn over one
        pass

    # The map for the subagent's own task is added by the hooks module when it is spawned,
    # where its prompt is known (`repomap.for_a_task`). This event carries neither the prompt
    # nor the description, so a map ranked here was the same generic one for every task, and
    # on a repository of 2,000 sources it outran this hook's fifteen seconds on every spawn.
    task = " ".join(str(event.raw.get(key, "")) for key in ("description", "prompt")).strip()
    if task:
        try:
            parts.append(repomap.for_a_task(ctx, task))
        except Exception:  # noqa: BLE001 - a map is a hint; never fail a spawn over one
            pass
    brief = "\n\n".join(p for p in parts if p.strip())
    if not brief.strip():
        hookio.emit_silent()

    hookio.emit_context("SubagentStart", brief, limit=BRIEF_CHAR_BUDGET + 2_000)


if __name__ == "__main__":
    hookio.guard(main, fail_closed=False)
