#!/usr/bin/env python3
"""Defects this plugin hit here, and the one command that sends them.

    claude-bp-report            what was captured, and exactly what would be sent
    claude-bp-report defect "…" record a gate that refused the wrong thing
    claude-bp-report send       file them as issues against the plugin's repository

`defect` is what a blocked session does instead of interrupting the founder. A crash
files itself; a gate that runs exactly as written and refuses the wrong call cannot,
and every defect of that kind this plugin has fixed was carried by a person who stopped
their own work to write it up.

Sending lives here rather than in a hook, and that is the whole shape of this feature.
A hook that talks to the network is a hook that can be slow, can fail, and can be
stopped by an expired token — on a path that runs before every tool call. Capture is
free and always on; sending is this command, which a capture starts on its own where
reports are sent as they come (`defects.mode`): `gh` files as the owner of the reports'
repository, or the founder wrote `"report_defects": "auto"`.
"""

from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

# An old copy's command runs the newest installed copy's instead, so a chat started
# before an update is gated by the version on disk (decision 0102).
from claude_bestpractice import upgrade as _upgrade  # noqa: E402

_upgrade.handover(Path(__file__))

from claude_bestpractice import __version__, defects, hookio, sessions, store, upgrade  # noqa: E402
from claude_bestpractice.gitctx import resolve_for_cli  # noqa: E402


SEND_LOCK = "defects-send.lock"


def newer_version() -> str:
    """A version past this one, installed beside it or released, else empty.

    A report filed from an old version asks for a fix a newer one may already have. On
    disk first, as the board reads it; then the latest release, asked of the same `gh` that
    files the issues. No answer from it is no newer version: sending never waits on it.
    """
    newer = upgrade.superseded_by() or upgrade.newer_in_the_cache()
    if newer:
        return newer
    try:
        proc = subprocess.run(
            ["gh", "release", "view", "--repo", defects.REPORT_REPO,
             "--json", "tagName", "--jq", ".tagName"],
            capture_output=True, encoding="utf-8", errors="surrogateescape", timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    tag = proc.stdout.strip().removeprefix("v") if proc.returncode == 0 else ""
    return tag if tag and upgrade.version_key(tag) > upgrade.version_key(__version__) else ""


def held_line(ctx) -> str:
    """What `send` leaves, and why, so an empty send is not read as nothing captured."""
    held = defects.held_back(ctx)
    if not held:
        return ""
    versions = sorted({str(r.get("version") or "?") for r in held}, key=upgrade.version_key)
    seen_on = versions[0] if len(versions) == 1 else f"{versions[0]} to {versions[-1]}"
    return (f"{len(held)} held back: last seen on {seen_on}, not on {__version__}, whose "
            "code has changed since. A defect still here is captured again when it is hit.")


def cmd_list(ctx) -> int:
    waiting = defects.unsent(ctx)
    held = held_line(ctx)
    if not waiting:
        print(f"no defects captured on {__version__}")
        if held:
            print(held)
        return 0

    print(f"{len(waiting)} defect(s) captured, not sent:\n")
    for i, report in enumerate(waiting, start=1):
        seen = int(report.get("seen", 1))
        repeats = f"  ×{seen}" if seen > 1 else ""
        print(f"  [{i}] {defects.title(report)}{repeats}")
        # A session-filed report has no frame to name: nothing failed. Printing the
        # `where` field anyway said "at observed", which reads like a place and is not.
        if report.get("kind") != defects.OBSERVED:
            print(f"      at {report.get('where') or 'unknown'}")
    # Every body, because `send` files every one. Only the first was shown under "this is
    # the whole of what would be sent", and the next one named a client's file path in a
    # public issue that nobody had been shown.
    print(f"\nThis is the whole of what would be sent to {defects.REPORT_REPO}, "
          f"one issue per report:")
    for i, report in enumerate(waiting, start=1):
        print(f"\n  [{i}] {defects.title(report)}")
        print("\n".join("    " + line for line in defects.body(report).splitlines()))
    print("\nSend with: claude-bp-report send")
    if held:
        print(held)
    return 0


def cmd_send(ctx) -> int:
    """File what is sendable, one sender at a time.

    Every capture starts one where reports go as they come, so two run at once: each reads
    what is unsent inside the lock and marks it sent before letting go, and the second
    files only what the first had not seen.
    """
    try:
        with store.file_lock(store.tier_b(ctx, SEND_LOCK), timeout=300, stale_after=900):
            return send_unsent(ctx)
    except store.LockTimeout:
        print("another send has been running for five minutes; nothing sent",
              file=sys.stderr)
        return 1


def send_unsent(ctx) -> int:
    waiting = defects.unsent(ctx)
    if not waiting:
        print("nothing to send")
        held = held_line(ctx)
        if held:
            print(held)
        return 0
    if not shutil.which("gh"):
        print("gh is not installed, so nothing can be filed. The reports are above.",
              file=sys.stderr)
        return 1
    newer = newer_version()
    if newer:
        print(f"nothing sent: this is {__version__}, and {newer} is out, which may have "
              f"fixed what these report. Update with `{upgrade.update_command()}` and "
              "restart Claude Code; a defect still there is captured again.", file=sys.stderr)
        return 1

    sent = 0
    for report in waiting:
        proc = subprocess.run(
            ["gh", "issue", "create", "--repo", defects.REPORT_REPO,
             "--title", defects.title(report), "--body", defects.body(report),
             "--label", "bug"],
            capture_output=True, encoding="utf-8", errors="surrogateescape", timeout=120,
        )
        if proc.returncode != 0:
            print(f"could not file: {proc.stderr.strip()[:200]}", file=sys.stderr)
            continue
        url = proc.stdout.strip().splitlines()[-1] if proc.stdout.strip() else ""
        # Marked sent whatever the URL parsing did. A report filed twice is noise in
        # somebody else's repository, which is worse than a report with no link.
        defects.mark_sent(ctx, report, url)
        sent += 1
        print(url or "filed")
    return 0 if sent else 1


def last_refusal(ctx) -> str:
    """The first line of the last refusal this session was given, "" outside a session or
    where it has none: the report is then the gate's words beside the session's."""
    me = sessions.get(ctx, hookio.current_session_id(str(ctx.worktree_root)))
    return str((me.refusal or {}).get("said") or "") if me is not None else ""


def main() -> int:
    parser = argparse.ArgumentParser(description="Defects this plugin hit in this repository.")
    # The version the founder is actually running, from the one place that holds it.
    # `claude-bp-plan --version` printed nothing and exited 2, so a bug report
    # against this plugin could not state which version it was against (#210).
    parser.add_argument("--version", action="version", version=__version__)
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("list", help="show captured defects (default)")
    sub.add_parser("send", help="file them against the plugin's repository")
    filed = sub.add_parser("defect", help="record a gate that refused the wrong thing")
    filed.add_argument("what", help="what it refused, and why that is wrong")
    filed.add_argument("--gate", default="",
                       help="which gate said it, if the refusal named one")
    args = parser.parse_args()

    ctx = resolve_for_cli()
    if defects.mode(ctx) == defects.OFF:
        print("defect reporting is off for this repository")
        return 0
    if args.command == "defect":
        recorded, said = defects.observed(ctx, args.what, args.gate, last_refusal(ctx))
        print(said)
        return 0 if recorded else 1
    return cmd_send(ctx) if args.command == "send" else cmd_list(ctx)


if __name__ == "__main__":
    raise SystemExit(hookio.run_cli(main))
