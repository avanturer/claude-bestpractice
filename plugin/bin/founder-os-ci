#!/usr/bin/env python3
"""Where the gates run: locally on every push, or on a hosted runner.

Local is the default and the recommendation. Hosted minutes are a metered budget that a
several-sessions-at-once workflow burns through fast — eight sessions pushing all day is
eight times the runs — and the feedback arrives minutes after the mistake instead of
before it leaves the machine. A pre-push hook runs the same gates, for free, in time to
stop the push.

Hosted CI is still worth switching on for a repository other people pull from, because
the pre-push hook binds only the machines that installed it. Both can run at once.

    founder-os-ci status     what runs where, right now
    founder-os-ci local      install the pre-push hook
    founder-os-ci github     print how to turn the hosted workflow on
    founder-os-ci off        remove the pre-push hook
"""

from __future__ import annotations

import argparse
import os
import stat
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from founder_os.gitctx import resolve_for_cli  # noqa: E402

HOOK_NAME = "pre-push"
MARKER = "# founder-os pre-push gate"
CI_VARIABLE = "FOUNDER_OS_CI"

# `make check` when the project has one, because that is the command the founder already
# knows and maintains. Otherwise the plugin's own doctor, which needs no project setup.
HOOK_BODY = f"""#!/bin/sh
{MARKER}
# Runs the project's own checks before anything leaves this machine. Bypass with
# --no-verify when you genuinely need to push red work; that is a deliberate act and
# leaves a record in the reflog, which a silently-skipped hosted run does not.
set -e

if [ -f Makefile ] && grep -q '^check:' Makefile; then
    exec make check
fi

if command -v founder-os-doctor >/dev/null 2>&1; then
    exec founder-os-doctor
fi

echo "founder-os: no 'make check' target and no doctor on PATH — nothing to run" >&2
exit 0
"""


def hooks_dir(ctx) -> Path:
    """Honour core.hooksPath, or a repo that configured one gets a hook nothing reads."""
    configured = subprocess.run(
        ["git", "config", "--get", "core.hooksPath"],
        cwd=str(ctx.worktree_root), capture_output=True, text=True, timeout=30,
    ).stdout.strip()
    if configured:
        path = Path(configured)
        return path if path.is_absolute() else ctx.worktree_root / path
    return ctx.common_dir / "hooks"


def installed(path: Path) -> bool:
    try:
        return MARKER in path.read_text(encoding="utf-8")
    except OSError:
        return False


def install(ctx) -> int:
    directory = hooks_dir(ctx)
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / HOOK_NAME

    if path.exists() and not installed(path):
        # Never clobber someone else's hook: a pre-push that vanished is a check that
        # silently stopped running, which is the failure mode this whole project is about.
        backup = path.with_suffix(path.suffix + ".founder-os.bak")
        backup.write_text(path.read_text(encoding="utf-8", errors="replace"), encoding="utf-8")
        print(f"existing {HOOK_NAME} backed up to {backup.name}")

    path.write_text(HOOK_BODY, encoding="utf-8")
    path.chmod(path.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    print(f"installed {path}")
    print("every push now runs the checks first. Bypass once with: git push --no-verify")
    return 0


def remove(ctx) -> int:
    path = hooks_dir(ctx) / HOOK_NAME
    if not installed(path):
        print("no founder-os pre-push hook installed")
        return 0
    path.unlink(missing_ok=True)
    backup = path.with_suffix(path.suffix + ".founder-os.bak")
    if backup.exists():
        path.write_text(backup.read_text(encoding="utf-8"), encoding="utf-8")
        path.chmod(path.stat().st_mode | stat.S_IXUSR)
        backup.unlink(missing_ok=True)
        print(f"restored the previous {HOOK_NAME}")
    print("removed. Nothing checks your pushes now.")
    return 0


def github(ctx) -> int:
    workflow = ctx.worktree_root / ".github" / "workflows" / "check.yml"
    if not workflow.exists():
        print("no .github/workflows/check.yml in this repository")
        return 1
    print("The hosted workflow is present and gated behind a repository variable, so it")
    print("costs nothing until you switch it on. To enable:")
    print()
    print(f"    gh variable set {CI_VARIABLE} --body on")
    print()
    print("or Settings -> Secrets and variables -> Actions -> Variables.")
    print(f"To turn it back off:  gh variable set {CI_VARIABLE} --body off")
    return 0


def status(ctx) -> int:
    path = hooks_dir(ctx) / HOOK_NAME
    local = installed(path)
    print(f"local pre-push: {'ON — ' + str(path) if local else 'off'}")

    workflow = ctx.worktree_root / ".github" / "workflows" / "check.yml"
    if not workflow.exists():
        print("hosted CI:      no workflow in this repository")
    elif CI_VARIABLE in workflow.read_text(encoding="utf-8", errors="replace"):
        print(f"hosted CI:      present, gated on the {CI_VARIABLE} variable (off unless set to 'on')")
    else:
        print("hosted CI:      present and UNGATED — it runs on every push")

    if not local:
        print()
        print("Nothing checks a push from this machine. `founder-os-ci local` fixes that.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Choose where the gates run.")
    parser.add_argument(
        "command", nargs="?", default="status", choices=["status", "local", "github", "off"]
    )
    args = parser.parse_args()
    ctx = resolve_for_cli()
    return {"status": status, "local": install, "github": github, "off": remove}[args.command](ctx)


if __name__ == "__main__":
    raise SystemExit(main())
