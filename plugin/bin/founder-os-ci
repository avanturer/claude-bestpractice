#!/usr/bin/env python3
"""Choose where the checks run. Local is the default and is installed at setup.

    founder-os-ci status     what runs where, and what it costs
    founder-os-ci local      install the pre-push hook
    founder-os-ci github     switch the hosted workflow on
    founder-os-ci github --off
    founder-os-ci off        remove the pre-push hook

The reasoning behind the default is in `founder_os.ci`.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from founder_os import ci, hookio  # noqa: E402
from founder_os.gitctx import resolve_for_cli  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description="Choose where the checks run.")
    parser.add_argument(
        "command", nargs="?", default="status", choices=["status", "local", "github", "off"]
    )
    parser.add_argument("--off", action="store_true", help="with `github`, switch it back off")
    args = parser.parse_args()
    ctx = resolve_for_cli()

    if args.command == "status":
        print("\n".join(ci.status_lines(ctx)))
        return 0

    if args.command == "local":
        changed, note = ci.install(ctx)
        print(note)
        if changed:
            print("every push now runs the checks first. Bypass once with: git push --no-verify")
        return 0

    if args.command == "off":
        _, note = ci.remove(ctx)
        print(note)
        return 0

    ok, note = ci.set_hosted(ctx, on=not args.off)
    print(note)
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(hookio.run_cli(main))
