#!/usr/bin/env python3
"""PreCompact: persist what the window is about to destroy. Zero model calls.

Compaction is the largest measured destroyer of in-context state, and micro-compaction
never fires this event at all. So the rule is architectural: persist at WRITE time,
never at compact time, and treat this hook as a flush rather than a save point.

Exactly one surveyed tool registers PreCompact. The rest re-inject after the window
has already collapsed, which recovers nothing.

Extraction is deliberately cheap — no summarisation, no model. A stateful model
reducer in front of a durable queue is a trap: you persist the fragments and lose the
reducer state, and the leading memory plugin bills up to ~8k input tokens per tool
call for the privilege.

TRANSCRIPT HANDLING: the transcript format is documented as internal and changing
between releases, so it is used only as optional enrichment. Everything load-bearing
comes from our own session record. If the transcript cannot be read or its shape
changed, the checkpoint is still written — just thinner.
"""

from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from claude_bestpractice import hookio, provenance, redact, sessions, store  # noqa: E402
from claude_bestpractice.gitctx import changed_files, resolve  # noqa: E402

MAX_TURN_CHARS = 300
MAX_TURNS = 3


def read_user_turns(transcript_path: str) -> list[str]:
    """Best-effort extraction of recent user turns. Never raises."""
    if not transcript_path:
        return []
    try:
        text = Path(transcript_path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []

    turns: list[str] = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rec = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(rec, dict) or rec.get("type") != "user":
            continue
        if rec.get("isSidechain"):
            continue
        message = rec.get("message")
        content = message.get("content") if isinstance(message, dict) else None
        if isinstance(content, str):
            body = content
        elif isinstance(content, list):
            body = " ".join(
                str(part.get("text", ""))
                for part in content
                if isinstance(part, dict) and part.get("type") == "text"
            )
        else:
            continue
        body = body.strip()
        if body:
            turns.append(body)
    return turns


DEMANDED = "compaction-notes-demanded.json"


def _demand_the_notes_once(ctx, event, rec, changed) -> None:
    """Block the compaction once, so what only this window knows gets written down first.

    Everything else in this file is a flush: it copies what is already on disk. The gap it
    cannot close is the substance that never left the conversation — the finding reasoned
    out and never filed, the approach abandoned and never recorded. After compaction the
    model is nearly new, and that material is simply gone.

    `PreCompact` is the one event that can block, and this is the one thing worth blocking
    for. It replaces the founder having to say "prepare for the compaction" by hand, which
    is what they were doing — at the right moment, with the window still holding the
    context, and without them present.

    ONCE per session, and marked BEFORE the block is raised: a session that ignores this,
    crashes, or hits it again on the next compaction must not meet it twice. One
    unignorable interruption is the whole budget. And only when work actually happened —
    a session that changed nothing has nothing to write down.
    """
    if not changed:
        return
    # NEVER on a compaction the session did not choose. `trigger` is "auto" when the
    # harness compacts because the window is full — the session is already at the wall,
    # and blocking there costs it a turn it has no room for: it cannot compact, because
    # we refused, and it cannot proceed, because the context is spent. A gate that wedges
    # a session at its worst moment is worse than the notes it was protecting.
    #
    # "Block unless auto" rather than "block only when manual": if the field is ever
    # absent the behaviour is today's, and the change costs nothing where it is not needed.
    if str(event.raw.get("trigger", "")).strip().lower() == "auto":
        return
    path = store.tier_b(ctx, DEMANDED)
    seen = store.read_json(path, default=[])
    if not isinstance(seen, list):
        seen = []
    if event.session_id in seen:
        return
    store.write_json(path, (seen + [event.session_id])[-40:])

    task = ""
    if rec and rec.task_statement:
        task = f"\nThis session was asked: {rec.task_statement[:200]}\n"

    # Name the card and the command that writes it, not the field in the abstract. The
    # previous wording named three commands and got all three wrong: `claude-bp-attempt
    # record` is not a subcommand at all (the verb is `add`), `claim` cannot write a body,
    # and `add` files a SECOND card for a session that already holds one. This is the only
    # interruption the whole session is allowed, and it was spending it on instructions
    # that error out.
    learned = (
        '`claude-bp-plan add "<what this window was for>" '
        '--body "<what you learned that is not in the code>"`'
    )
    from claude_bestpractice import plan

    try:
        # OWNERSHIP IS REQUIRED HERE, unlike in `_carried`. Without a record `_carried`
        # carries every in-flight card, which over-reports into this window's own restore
        # and costs nothing. Naming one in the demand is different: it hands out a WRITE
        # command, and the first card in `doing` may belong to a live sibling.
        mine = [] if rec is None else [
            t for t in plan.load_all(ctx, plan.DOING) if t.owner == rec.session_id
        ]
    except Exception:  # noqa: BLE001 - the demand must survive an unreadable ledger
        mine = []
    if mine:
        card = mine[0]
        task += f"The card it holds is {card.id} {card.title}.\n"
        # `--note` REPLACES the handoff (`plan.amend`: `note.strip() or body`), so a demand
        # that called this "add what you learned" would have the window silently delete the
        # plan a `park` left behind. Say what the command does.
        learned = (f'`claude-bp-plan update {card.id} --note "<the handoff, rewritten to '
                   'carry what you learned>"` — this REPLACES the card body, so keep what '
                   'is still true')

    hookio.block(
        "claude-bestpractice: this window is about to be compacted, and after it you will be "
        "nearly new. What is on disk survives; what is only in this conversation does not.\n"
        f"{task}"
        "Write down now, before anything else — this is the last moment the material still "
        "exists. Three fields, three commands:\n"
        f"  LEARNED   — not in the code yet: {learned}\n"
        "              (this is the field a restored window is handed back; the board "
        "renders the title alone.)\n"
        '  RULED OUT — tried and abandoned: `claude-bp-attempt add "<approach>" '
        '--why "<why it failed>" --paths <files>`\n'
        "              (an approach ruled out and not written down is one the next window "
        "tries again.)\n"
        "  DECIDED   — outlives this task: say it plainly in this turn. It is harvested "
        "when the turn ends; `claude-bp-decide list` shows what was caught and "
        "`claude-bp-decide accept <n>` promotes it.\n"
        "Then let the compaction proceed. This will not be raised again in this session, so "
        "if you skip it the material is gone."
    )


# One claimed card, its body and its paths. The section is bounded because the restore
# that reads it is head-sliced: an unbounded section here would evict the opening request
# instead of the file list, which is the same defect pointing the other way.
MAX_CARRIED_CHARS = 900


def _paths_line(paths: list, room: int) -> str:
    """As many paths as fit, and a count for the rest.

    Dropping the line whole was the first answer and it was wrong: a 400-character body
    leaves under 400 for ten realistic paths, so the section that card 0064 exists to carry
    would arrive with the body and none of the files. The paths are the cheaper half and the
    more actionable one — they are where the next window opens — so they are trimmed by
    count rather than by character, and the count says what was left behind.
    """
    prefix = "  paths: "
    shown: list = []
    used = len(prefix)
    for path in paths[:10]:
        cost = len(path) + (2 if shown else 0)
        # Always keep the first, even if it alone is over: one path is a pointer and no
        # path is nothing, and the section bound still truncates the whole line if it must.
        if shown and used + cost > max(room, 0):
            break
        shown.append(path)
        used += cost
    left = len(paths) - len(shown)
    return prefix + ", ".join(shown) + (f" (+{left} more in the ledger)" if left else "")


def _carried(ctx, rec) -> list:
    """The claimed card's body and paths — the only part of the work the board cannot hand
    back by itself.

    This used to copy the queued tasks, the other sessions' cards, the last eight attempts
    and the open items as well. All four are re-injected by `board.render` into the SAME
    SessionStart payload, and injected better: attempts keyed on this session's own subject
    rather than by recency, open items filtered to fresh provenance. So the duplicates
    bought nothing and cost the only budget that matters — the restore is sliced from the
    head, so whatever sits last is what disappears.

    What is genuinely unrecoverable is this: `plan.render_for_board` prints `id` and
    `title[:80]` and never the body, and the body is exactly where `_demand_the_notes_once`
    blocks the compaction to make the session write what it learned. Measured before this
    changed: past ~21 changed files the restore contained neither.
    """
    from claude_bestpractice import plan

    out = ["", "## The work this window was doing", ""]
    try:
        # A missing record means "cannot tell whose this is", and dropping the section is
        # the wrong direction for a restore, so an unknown owner carries everything.
        mine = [t for t in plan.load_all(ctx, plan.DOING)
                if not rec or t.owner == rec.session_id]
        if not mine:
            out.append("- (this session held no card)")
        for task in mine:
            out.append(f"- CLAIMED BY THIS SESSION: {task.id} {task.title}")
            if task.body:
                out.append(f"  {task.body[:400]}")
            if task.paths:
                out.append(_paths_line(task.paths, MAX_CARRIED_CHARS - len("\n".join(out))))
    except Exception:  # noqa: BLE001 - a checkpoint that dies saves nothing
        out.append("- (the ledger could not be read)")

    # Whole lines, never a character slice. A card with ten realistic paths renders past
    # 900 chars, and cutting mid-line ends the `paths:` line inside a path — the exact
    # defect `knowledge._to_line_boundary` exists to remove, reproduced here by the same
    # change that removed it there.
    kept: list = []
    used = 0
    for line in out:
        cost = len(line) + (1 if kept else 0)
        if used + cost > MAX_CARRIED_CHARS:
            kept.append("- […the rest of the card is in the ledger]")
            break
        kept.append(line)
        used += cost
    return kept


def main() -> None:
    event = hookio.read_event()
    ctx = hookio.repo(event.cwd or os.getcwd())
    rec = sessions.get(ctx, event.session_id)

    turns = read_user_turns(event.transcript_path)
    opening = turns[0] if turns else (rec.task_statement if rec else "")
    recent = turns[-MAX_TURNS:] if turns else []

    changed = changed_files(ctx, rec.baseline_commit if rec else None)

    lines = [
        "---",
        f"kind: checkpoint",
        f"session_id: {event.session_id}",
        f"trigger: {event.raw.get('trigger', 'unknown')}",
        f"created_at: {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}",
        f"repository: {ctx.worktree_root.name}",
        f"branch: {ctx.branch}",
        f"git_sha: {ctx.head}",
        f"baseline_commit: {rec.baseline_commit if rec else ''}",
        f"capture: extractive",
        "---",
        "",
        "## Opening request",
        "",
        redact.scrub(redact.strip_control(opening))[:MAX_TURN_CHARS] or "(not captured)",
        "",
        "## Recent turns",
        "",
    ]
    if recent:
        for turn in recent:
            lines.append(f"- {redact.scrub(redact.strip_control(turn))[:MAX_TURN_CHARS]}")
    else:
        lines.append("- (transcript unavailable or in an unrecognised format)")

    # Before the file list, never after it. The file list is the one unbounded section
    # here, and the restore that reads this back is sliced from the head — so whatever
    # follows it is what a busy session loses.
    lines.extend(_carried(ctx, rec))

    lines += ["", "## Files changed since baseline", ""]
    if changed:
        # Blob hashes, not mtimes: creating a worktree or switching branches resets
        # every mtime, and this workflow does that constantly. Content survives it.
        for entry in provenance.stamp(ctx, changed[:60]):
            lines.append(f"- {entry['path']} @ {entry['blob'][:12]}")
        if len(changed) > 60:
            lines.append(f"- ... and {len(changed) - 60} more")
    else:
        lines.append("- (none)")

    stamp = time.strftime("%Y%m%d-%H%M%S", time.gmtime())
    name = f"{stamp}-{(event.session_id or 'anon')[:8]}.md"
    path = store.tier_a(ctx, "checkpoints", name)
    store.atomic_write(path, "\n".join(lines) + "\n", mode=0o644)

    _demand_the_notes_once(ctx, event, rec, changed)
    hookio.emit_silent()


if __name__ == "__main__":
    hookio.guard(main, fail_closed=False)
