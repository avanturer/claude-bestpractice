#!/usr/bin/env python3
"""PreCompact: persist what the window is about to destroy. Zero model calls.

Compaction is the largest measured destroyer of in-context state, and micro-compaction
never fires this event at all. So the rule is architectural: persist at WRITE time,
never at compact time, and treat this hook as a flush rather than a save point.

Exactly one surveyed tool registers PreCompact. The rest re-inject after the window
has already collapsed, which recovers nothing.

Extraction is deliberately cheap — no summarisation, no model. A stateful model
reducer in front of a durable queue is a trap: you persist the fragments and lose the
reducer state, and the leading memory plugin bills up to ~8k input tokens per tool
call for the privilege.

TRANSCRIPT HANDLING: the transcript format is documented as internal and changing
between releases, so it is used only as optional enrichment. Everything load-bearing
comes from our own session record. If the transcript cannot be read or its shape
changed, the checkpoint is still written — just thinner.

AND IT NEVER BLOCKS, WHICH IS NOT A JUDGEMENT ABOUT STRICTNESS. `PreCompact` is listed as
an event that can refuse, and for three releases this hook refused once per session to
make the window write down what only it knew. That refusal could never be answered.
Measured against the CLI (2.1.278) rather than read off the table: both `exit 2` and
`{"decision": "block"}` end the turn with `num_turns: 0`, zero input and output tokens,
and the text delivered as a `<synthetic>` assistant message. No model call happens at all
— so the instruction reached nobody but the founder, whose `/compact` had just been
cancelled along with the custom instructions they typed into it, and who then had to run
it a second time to get the compaction they asked for the first time.

The demand lives in the Stop gate now (`evidence-gate`, `_ask_for_the_notes_once`), which
is the one event whose refusal both reaches the model and gives it a turn to act. Nothing
here may block again: `claude-bp-doctor` runs the compaction this file used to refuse and
fails if it is refused.
"""

from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from claude_bestpractice import hookio, provenance, redact, sessions, store  # noqa: E402
from claude_bestpractice.gitctx import changed_files, resolve  # noqa: E402

MAX_TURN_CHARS = 300
MAX_TURNS = 3


def read_user_turns(transcript_path: str) -> list[str]:
    """Best-effort extraction of recent user turns. Never raises."""
    if not transcript_path:
        return []
    try:
        text = Path(transcript_path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []

    turns: list[str] = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rec = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(rec, dict) or rec.get("type") != "user":
            continue
        if rec.get("isSidechain"):
            continue
        message = rec.get("message")
        content = message.get("content") if isinstance(message, dict) else None
        if isinstance(content, str):
            body = content
        elif isinstance(content, list):
            body = " ".join(
                str(part.get("text", ""))
                for part in content
                if isinstance(part, dict) and part.get("type") == "text"
            )
        else:
            continue
        body = body.strip()
        if body:
            turns.append(body)
    return turns


# One claimed card, its body and its paths. The section is bounded because the restore
# that reads it is head-sliced: an unbounded section here would evict the opening request
# instead of the file list, which is the same defect pointing the other way.
MAX_CARRIED_CHARS = 900


def _paths_line(paths: list, room: int) -> str:
    """As many paths as fit, and a count for the rest.

    Dropping the line whole was the first answer and it was wrong: a 400-character body
    leaves under 400 for ten realistic paths, so the section that card 0064 exists to carry
    would arrive with the body and none of the files. The paths are the cheaper half and the
    more actionable one — they are where the next window opens — so they are trimmed by
    count rather than by character, and the count says what was left behind.
    """
    prefix = "  paths: "
    shown: list = []
    used = len(prefix)
    for path in paths[:10]:
        cost = len(path) + (2 if shown else 0)
        # Always keep the first, even if it alone is over: one path is a pointer and no
        # path is nothing, and the section bound still truncates the whole line if it must.
        if shown and used + cost > max(room, 0):
            break
        shown.append(path)
        used += cost
    left = len(paths) - len(shown)
    return prefix + ", ".join(shown) + (f" (+{left} more in the ledger)" if left else "")


def _carried(ctx, rec) -> list:
    """The claimed card's body and paths — the only part of the work the board cannot hand
    back by itself.

    This used to copy the queued tasks, the other sessions' cards, the last eight attempts
    and the open items as well. All four are re-injected by `board.render` into the SAME
    SessionStart payload, and injected better: attempts keyed on this session's own subject
    rather than by recency, open items filtered to fresh provenance. So the duplicates
    bought nothing and cost the only budget that matters — the restore is sliced from the
    head, so whatever sits last is what disappears.

    What is genuinely unrecoverable is this: `plan.render_for_board` prints `id` and
    `title[:80]` and never the body, and the body is exactly what the Stop gate's notes
    demand asks the session to write. Measured before this changed: past ~21 changed files
    the restore contained neither.
    """
    from claude_bestpractice import plan

    out = ["", "## The work this window was doing", ""]
    try:
        # A missing record means "cannot tell whose this is", and dropping the section is
        # the wrong direction for a restore, so an unknown owner carries everything. A
        # known one carries its cards under any id it has had (`plan.held_by`).
        mine = plan.held_by(ctx, rec.session_id) if rec else plan.load_all(ctx, plan.DOING)
        if not mine:
            out.append("- (this session held no card)")
        for task in mine:
            out.append(f"- CLAIMED BY THIS SESSION: {task.id} {task.title}")
            if task.body:
                out.append(f"  {task.body[:400]}")
            if task.paths:
                out.append(_paths_line(task.paths, MAX_CARRIED_CHARS - len("\n".join(out))))
    except Exception:  # noqa: BLE001 - a checkpoint that dies saves nothing
        out.append("- (the ledger could not be read)")

    # Whole lines, never a character slice. A card with ten realistic paths renders past
    # 900 chars, and cutting mid-line ends the `paths:` line inside a path — the exact
    # defect `knowledge._to_line_boundary` exists to remove, reproduced here by the same
    # change that removed it there.
    kept: list = []
    used = 0
    for line in out:
        cost = len(line) + (1 if kept else 0)
        if used + cost > MAX_CARRIED_CHARS:
            kept.append("- […the rest of the card is in the ledger]")
            break
        kept.append(line)
        used += cost
    return kept


def main() -> None:
    event = hookio.read_event()
    ctx = hookio.repo(event.cwd or os.getcwd())
    rec = sessions.get(ctx, event.session_id)

    turns = read_user_turns(event.transcript_path)
    opening = turns[0] if turns else (rec.task_statement if rec else "")
    recent = turns[-MAX_TURNS:] if turns else []

    changed = changed_files(ctx, rec.baseline_commit if rec else None)

    lines = [
        "---",
        f"kind: checkpoint",
        f"session_id: {event.session_id}",
        f"trigger: {event.raw.get('trigger', 'unknown')}",
        f"created_at: {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}",
        f"repository: {ctx.worktree_root.name}",
        f"branch: {ctx.branch}",
        f"git_sha: {ctx.head}",
        f"baseline_commit: {rec.baseline_commit if rec else ''}",
        f"capture: extractive",
        "---",
        "",
        "## Opening request",
        "",
        redact.scrub(redact.strip_control(opening))[:MAX_TURN_CHARS] or "(not captured)",
        "",
        "## Recent turns",
        "",
    ]
    if recent:
        for turn in recent:
            lines.append(f"- {redact.scrub(redact.strip_control(turn))[:MAX_TURN_CHARS]}")
    else:
        lines.append("- (transcript unavailable or in an unrecognised format)")

    # Before the file list, never after it. The file list is the one unbounded section
    # here, and the restore that reads this back is sliced from the head — so whatever
    # follows it is what a busy session loses.
    lines.extend(_carried(ctx, rec))

    lines += ["", "## Files changed since baseline", ""]
    if changed:
        # Blob hashes, not mtimes: creating a worktree or switching branches resets
        # every mtime, and this workflow does that constantly. Content survives it.
        for entry in provenance.stamp(ctx, changed[:60]):
            lines.append(f"- {entry['path']} @ {entry['blob'][:12]}")
        if len(changed) > 60:
            lines.append(f"- ... and {len(changed) - 60} more")
    else:
        lines.append("- (none)")

    stamp = time.strftime("%Y%m%d-%H%M%S", time.gmtime())
    name = f"{stamp}-{(event.session_id or 'anon')[:8]}.md"
    # The main checkout's, not this tree's: an untracked file here is one `git worktree
    # remove` refuses the tree over, for good.
    path = store.checkpoint_dir(ctx) / name
    store.atomic_write(path, "\n".join(lines) + "\n", mode=0o644)

    hookio.emit_silent()


if __name__ == "__main__":
    hookio.guard(main, fail_closed=False)
