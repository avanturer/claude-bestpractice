#!/usr/bin/env python3
"""UserPromptSubmit: capture the task statement. Inject nothing.

Emitting context here would be the single most expensive mistake available to this
plugin. A per-turn block is written into cache each turn and re-read on every later
turn — O(T^2) against O(T) for a session-start block. Measured in base-input
equivalents for a 1,000-token block: 6,000 once versus 164,000 per-turn at 41 turns.
So this hook writes to disk and returns silence.

What it captures is the verbatim first prompt, which is the anchor for the scope-drift
check. Verbatim matters: the one measured decomposition method that paraphrased
forward scored 41% worse by collapsing exactly the constraints that carry weight.
"""

from __future__ import annotations

import os
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from claude_bestpractice import hookio, redact, sessions  # noqa: E402
from claude_bestpractice.gitctx import resolve  # noqa: E402

MAX_TASK_CHARS = 600
MAX_TASK_PATHS = 64

# Path-shaped tokens: an explicit separator, or a bare filename with an extension.
_PATH = re.compile(r"[A-Za-z0-9_./\-]*[/][A-Za-z0-9_./\-]+|\b[A-Za-z0-9_\-]+\.[A-Za-z0-9]{1,6}\b")
_NOISE = {"e.g.", "i.e.", "etc.", "vs."}

# The harness wraps things into the prompt that the founder did not type. `ide_opened_file`
# says so itself — "This may or may not be related to the current task" — and it carries a
# path, which is the one thing this file mines a prompt for.
#
# Reported from a real session: the block named `/tmp/readonly/Bash tool output (aeqikl)`,
# that became the entire task scope, and every genuine project file was therefore drift.
# Eight consecutive blocks on correct work. Two separate leaks were reproduced here: the
# absolute path when its parent happened to exist, and — with no help from the filesystem
# at all — the closing tag itself, `/ide_opened_file`, whose parent is `/`.
#
# Named rather than pattern-matched on angle brackets: a founder pasting XML is asking for
# it to be read, not stripped.
_ENVELOPES = (
    "ide_opened_file", "ide_selection", "ide_diagnostics", "system-reminder",
    "background-task", "command-name", "command-message", "local-command-stdout",
)
_ENVELOPE_BLOCK = re.compile(
    r"<(" + "|".join(_ENVELOPES) + r")\b[^>]*>.*?</\1\s*>", re.S | re.I
)
_ENVELOPE_OPEN = re.compile(
    r"<(?:" + "|".join(_ENVELOPES) + r")\b[^>]*>.*?(?:\n|$)", re.S | re.I
)


def strip_envelopes(text: str) -> str:
    """Remove what the harness injected, leaving what the founder actually typed.

    An unclosed opener takes the rest of its block with it rather than being left behind
    as a bare tag — the tag alone is enough, because `</ide_opened_file>` is path-shaped.
    """
    text = _ENVELOPE_BLOCK.sub(" ", text)
    return _ENVELOPE_OPEN.sub(" ", text).strip()


def extract_paths(text: str, root: Path) -> list[str]:
    """Paths the task actually refers to, and only ones inside this worktree.

    Only tokens that resolve to something on disk, or name a directory, are kept. A
    prompt mentioning `README.md` in passing should not widen the allowed blast radius
    to the whole repository, and a token that matches nothing is almost always prose.

    Containment is not tidiness. `root / "/tmp/x"` is `/tmp/x` — an absolute token
    discards the root entirely — and the directory fallback then accepted anything whose
    parent existed anywhere on the machine, up to and including `/`. Every path here is
    compared against repository-relative filenames, so one that is not in the repository
    can never match anything and turns the whole check into "all of it is drift".
    """
    try:
        base = root.resolve()
    except OSError:
        return []

    found: list[str] = []
    for raw in _PATH.findall(text):
        token = raw.strip(".,;:()[]\"'`")
        if not token or token in _NOISE or len(token) < 3:
            continue
        candidate = root / token
        try:
            inside = candidate.resolve().relative_to(base)
        except (ValueError, OSError):
            continue
        if not str(inside) or str(inside).startswith(".."):
            continue
        if candidate.exists():
            found.append(token.rstrip("/"))
            continue
        parent = candidate.parent
        if parent != root and parent.is_dir():
            found.append(token.rstrip("/"))
    return sorted(set(found))


def main() -> None:
    event = hookio.read_event()
    ctx = hookio.repo(event.cwd or os.getcwd())

    rec = sessions.get(ctx, event.session_id)
    if rec is None:
        rec = sessions.adopt(ctx, event.session_id)

    prompt = strip_envelopes(event.prompt or "")
    if prompt:
        # Scrubbed AT CAPTURE, because this string does not stay here. It fans out to the
        # session record, the sibling sessions' board, `claude-bp status`, every scope-
        # drift message, and the attempt filed on an unverified finish — which is Tier A,
        # committed. A founder who opens a session by pasting "deploy with
        # STRIPE_KEY=sk_live_..." had that key written verbatim into a file bound for git,
        # by the plugin whose pre-write gate exists to refuse exactly that write.
        #
        # Control characters go too: this text is rendered into an injected block, and an
        # ANSI escape or an RTL override in it is a way to make the board lie.
        safe = redact.scrub(redact.strip_control(prompt))
        # The statement follows the founder rather than freezing at the first thing they
        # said. It used to be written once and never again, so a session that had long
        # since moved on was still being measured against "посмотри заново бд" — and every
        # drift message quoted it back. Reported from a real session.
        #
        # Paths ACCUMULATE where the statement replaces. A later instruction naming more
        # files genuinely widens what is in scope, and dropping the earlier ones would make
        # the files the founder first asked for into drift. Bounded, because unbounded
        # growth in a session record is how a fail-closed gate gets slow.
        merged = sorted(set(rec.task_paths) | set(extract_paths(prompt, ctx.worktree_root)))
        # Marked when cut, because the drift refusal quotes this back as "Task was:" and a
        # fragment presented as the whole instruction is a claim the founder cannot check.
        # Reported as issue #41, where "…перезапустил д" was shown as the task.
        statement = safe[:MAX_TASK_CHARS]
        if len(safe) > MAX_TASK_CHARS:
            statement += " […truncated; this is not the whole instruction]"
        sessions.touch(
            ctx,
            event.session_id,
            task_statement=statement,
            # Paths from the ORIGINAL: redaction rewrites credential-shaped tokens, and a
            # filename is not a credential. Scrubbing first would lose real paths.
            task_paths=merged[:MAX_TASK_PATHS],
        )
    else:
        sessions.touch(ctx, event.session_id)

    hookio.emit_silent()


if __name__ == "__main__":
    hookio.guard(main, fail_closed=False)
