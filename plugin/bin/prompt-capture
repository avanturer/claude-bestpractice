#!/usr/bin/env python3
"""UserPromptSubmit: capture the task statement. Inject nothing.

Emitting context here would be the single most expensive mistake available to this
plugin. A per-turn block is written into cache each turn and re-read on every later
turn — O(T^2) against O(T) for a session-start block. Measured in base-input
equivalents for a 1,000-token block: 6,000 once versus 164,000 per-turn at 41 turns.
So this hook writes to disk and returns silence.

What it captures is the verbatim first prompt, which is the anchor for the scope-drift
check. Verbatim matters: the one measured decomposition method that paraphrased
forward scored 41% worse by collapsing exactly the constraints that carry weight.
"""

from __future__ import annotations

import os
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from claude_bestpractice import config, hookio, inbox, redact, sessions  # noqa: E402
from claude_bestpractice.gitctx import resolve  # noqa: E402

MAX_TASK_CHARS = 600
MAX_TASK_PATHS = 64

# Path-shaped tokens: an explicit separator, or a bare filename with an extension.
_PATH = re.compile(r"[A-Za-z0-9_./\-]*[/][A-Za-z0-9_./\-]+|\b[A-Za-z0-9_\-]+\.[A-Za-z0-9]{1,6}\b")
_NOISE = {"e.g.", "i.e.", "etc.", "vs."}

# The harness wraps things into the prompt that the founder did not type. `ide_opened_file`
# says so itself — "This may or may not be related to the current task" — and it carries a
# path, which is the one thing this file mines a prompt for.
#
# Reported from a real session: the block named `/tmp/readonly/Bash tool output (aeqikl)`,
# that became the entire task scope, and every genuine project file was therefore drift.
# Eight consecutive blocks on correct work. Two separate leaks were reproduced here: the
# absolute path when its parent happened to exist, and — with no help from the filesystem
# at all — the closing tag itself, `/ide_opened_file`, whose parent is `/`.
#
# Named rather than pattern-matched on angle brackets: a founder pasting XML is asking for
# it to be read, not stripped.
_ENVELOPES = (
    "ide_opened_file", "ide_selection", "ide_diagnostics", "system-reminder",
    "background-task", "command-name", "command-message", "local-command-stdout",
    # Added after `<task-notification>` — a shape not on this list — was taken as the task
    # and quoted back at a session whose 136 changed files were then all drift (#118). The
    # list is the cheap half of that fix; `is_harness_block` is the half that does not
    # depend on having guessed every name the harness will ever use.
    "task-notification", "github-webhook-activity", "untrusted_external_data",
    "command-args", "local-command-caveat",
)
_ENVELOPE_BLOCK = re.compile(
    r"<(" + "|".join(_ENVELOPES) + r")\b[^>]*>.*?</\1\s*>", re.S | re.I
)
_ENVELOPE_OPEN = re.compile(
    r"<(?:" + "|".join(_ENVELOPES) + r")\b[^>]*>.*?(?:\n|$)", re.S | re.I
)


def strip_envelopes(text: str) -> str:
    """Remove what the harness injected, leaving what the founder actually typed.

    An unclosed opener takes the rest of its block with it rather than being left behind
    as a bare tag — the tag alone is enough, because `</ide_opened_file>` is path-shaped.
    """
    text = _ENVELOPE_BLOCK.sub(" ", text)
    return _ENVELOPE_OPEN.sub(" ", text).strip()


# Most turns in a real session are not statements of work — they are the founder saying
# "keep going". Taking the last turn unconditionally meant the field that names what a
# session is doing held the least informative sentence they typed. Measured on a live
# repository: three concurrent sessions whose tasks read «Делай», «обнови», and a merge
# question, with the second provisioning a branch called `feat/obnovi-70e44134`. The
# transliteration is its own trap — «Делай» renders as `delay`, an English word meaning
# the opposite of what the session was doing.
#
# The deny-list carries the work; the floor is only a backstop for acknowledgements
# nobody thought of. Set where it clears every entry on the list and still admits a
# terse but real instruction ("почини баг в auth").
MIN_STATEMENT_CHARS = 16

_CONTINUATION = re.compile(
    r"(?i)^(?:"
    r"делай|давай|сделай|поехали|начинай|продолжай|продолжи|дальше|ещё|еще|"
    r"обнови|обновись|проверь|исправь|го|ок|окей|окей\.|ага|да|ну|хорошо|"
    r"супер|отлично|спасибо|пж|плиз|"
    r"go|go ahead|ok|okay|k|yes|yep|yeah|sure|please|thanks|thx|"
    r"continue|proceed|next|do it|just do it|keep going|carry on|"
    r"fix it|update|retry|again|more"
    r")$"
)


# The whole message is one XML element and nothing else: `<tag …> … </tag>` with no prose
# outside it. Every block the harness injects has that shape, and a founder does not type
# it — when they paste XML they paste it INTO a sentence, which is why this asks about the
# whole message rather than about brackets appearing anywhere in it.
_ONE_BLOCK = re.compile(r"\A<([a-z][\w-]*)\b[^>]*>.*</\1\s*>\Z", re.S | re.I)


# Every spelling this plugin speaks in. A message of its own arriving back as the session's
# task statement is the plugin quoting itself as the thing to be measured against — reported
# from a session where the drift block did exactly that.
#
# Refusals begin `claude-bestpractice:`; a delivered fact carries an inbox marker. The second
# was missing once, and the note — `[claude-bestpractice] another session is blocked on
# store.py…` — is long and names a path, so it passed every test this file applies for a
# statement of work. The plugin's own fact became the recipient's task: quoted back by every
# drift refusal, used to name their branch, adding ITS paths to their scope. #106, #118 and
# #166, through the one door this plugin built itself, because two markers for one voice had
# drifted apart by one character.
#
# So: imported rather than spelled a second time, and ALL of `inbox.MARKERS` rather than the
# current one. A rename does not reach the sessions already running — while an upgrade lands,
# a sibling on the previous release still delivers with the marker it knows, and this reader
# is the only thing between that note and the same defect.
_OUR_OWN_VOICE = "claude-bestpractice:"
_OUR_VOICES = (_OUR_OWN_VOICE, *inbox.MARKERS)


def is_harness_block(text: str) -> bool:
    """Was this written by the harness rather than by the founder?

    A name list cannot answer this, and trying was the defect: `background-task` was on it
    and `task-notification` was not, so a background-task completion notice became the
    session's task statement — and the scope-drift refusal then quoted a tool-use id back
    at an agent that had no way to satisfy it, in the middle of unattended overnight work
    (#118). This asks about the SHAPE, which does not change when the harness adds a block.

    Nothing is stripped on the strength of this. It decides only whether the text may
    become the record of what the founder asked for.
    """
    stripped = text.strip()
    if not stripped:
        return False
    return stripped.startswith(_OUR_VOICES) or bool(_ONE_BLOCK.match(stripped))


def is_statement_of_work(prompt: str, paths: list[str]) -> bool:
    """Does this prompt say what the session is doing, or only that it should carry on?

    Naming a file settles it: a prompt that points at code is about that code however
    short it is. Otherwise a bare continuation is rejected outright, and everything else
    has to clear a length floor — a rule that cannot be exactly right and does not need
    to be, because the cost of a wrong answer is asymmetric. Rejecting a real instruction
    leaves the previous one standing, which is stale; accepting «ок» destroys the only
    record of what this session is for, and that record is committed on an unverified
    finish.
    """
    text = " ".join(prompt.split())
    if is_pasted_output(prompt) or is_harness_block(prompt):
        return False
    # A switch line is the founder's word on a gate, and the reader that wants it has
    # already taken it a few lines above. Struck out here rather than merely ranked below
    # a real statement: `worktree_setup bash infra/scripts/worktree_db_init.sh` names a
    # path, and naming a path is what settles this question first (#166).
    if config.is_only_a_switch(prompt):
        return False
    if paths:
        return True
    if _CONTINUATION.match(text.strip(" .!?,…").lower()):
        return False
    return len(text) >= MIN_STATEMENT_CHARS


# A shell prompt, a traceback, a log line. Pasting output is showing the session something,
# never instructing it.
_PASTED = (
    # `[$#]` then whitespace OR end of line: scrubbing strips trailing spaces, so the
    # final `user@host:~$ ` of a pasted session lost the space that anchored this and
    # stopped counting — leaving one hit where there were two, and the paste read as an
    # instruction again.
    re.compile(r"^\s*(?:\(\S+\)\s*)?[\w.-]+@[\w.-]+:[^\n]*[$#](?:\s|$)", re.M),
    re.compile(r"^\s*Traceback \(most recent call last\):", re.M),
    re.compile(r"^\s*(?:npm ERR!|error TS\d|FAILED |=+ (?:FAILURES|ERRORS) =+)", re.M),
    re.compile(r"^\s*\[\d{4}-\d\d-\d\d[T ]\d\d:\d\d", re.M),
)


def is_pasted_output(prompt: str) -> bool:
    """Terminal output pasted as a message, which is not a statement of work.

    The founder pastes the tail of a deploy run; it becomes the session's task; every
    scope-drift refusal then quotes `Task was: (.venv) hedge@AVANTURER-PC:~/dev/...` back
    at an agent that cannot possibly satisfy it, and the founder is pulled in to type a
    filename before any further work can be reported (#106).

    The FIRST line decides, because that is where an instruction lives. "this failed, look:
    <traceback>" is an instruction with evidence attached and must stay one; a ratio rule
    got that wrong on exactly the length the founder actually types.
    """
    lines = [line for line in prompt.splitlines() if line.strip()]
    if not lines or not any(pattern.match(lines[0]) for pattern in _PASTED):
        return False
    hits = sum(1 for line in lines if any(pattern.match(line) for pattern in _PASTED))
    return hits >= 2 or len(lines) == 1


def extract_paths(text: str, root: Path) -> list[str]:
    """Paths the task actually refers to, and only ones inside this worktree.

    Only tokens that resolve to something on disk, or name a directory, are kept. A
    prompt mentioning `README.md` in passing should not widen the allowed blast radius
    to the whole repository, and a token that matches nothing is almost always prose.

    Containment is not tidiness. `root / "/tmp/x"` is `/tmp/x` — an absolute token
    discards the root entirely — and the directory fallback then accepted anything whose
    parent existed anywhere on the machine, up to and including `/`. Every path here is
    compared against repository-relative filenames, so one that is not in the repository
    can never match anything and turns the whole check into "all of it is drift".
    """
    try:
        base = root.resolve()
    except OSError:
        return []

    found: list[str] = []
    for raw in _PATH.findall(text):
        token = raw.strip(".,;:()[]\"'`")
        if not token or token in _NOISE or len(token) < 3:
            continue
        candidate = root / token
        try:
            inside = candidate.resolve().relative_to(base)
        except (ValueError, OSError):
            continue
        if not str(inside) or str(inside).startswith(".."):
            continue
        if candidate.exists():
            found.append(token.rstrip("/"))
            continue
        parent = candidate.parent
        if parent != root and parent.is_dir():
            found.append(token.rstrip("/"))
    return sorted(set(found))


def main() -> None:
    event = hookio.read_event()
    ctx = hookio.repo(event.cwd or os.getcwd())

    rec = sessions.get(ctx, event.session_id)
    if rec is None:
        rec = sessions.adopt(ctx, event.session_id)

    prompt = strip_envelopes(event.prompt or "")
    if prompt:
        # Scrubbed AT CAPTURE, because this string does not stay here. It fans out to the
        # session record, the sibling sessions' board, `claude-bp status`, every scope-
        # drift message, and the attempt filed on an unverified finish — which is Tier A,
        # committed. A founder who opens a session by pasting "deploy with
        # STRIPE_KEY=sk_live_..." had that key written verbatim into a file bound for git,
        # by the plugin whose pre-write gate exists to refuse exactly that write.
        #
        # Control characters go too: this text is rendered into an injected block, and an
        # ANSI escape or an RTL override in it is a way to make the board lie.
        safe = redact.scrub(redact.strip_control(prompt))
        # A gate switch the founder asked for, in their own words, written where no
        # session can reach it. This is the whole authorisation for `claude-bp set`: the
        # remedy every gate names has to be one the session can perform and cannot perform
        # alone, and the founder saying it is the only thing that satisfies both (#108).
        config.record_switches(ctx, config.switches_in(safe))
        # Acceptance travels the same road as a switch, and for the same reason: it is
        # the founder's own word, recorded where the session being gated cannot write it.
        #
        # THE FOUNDER'S WORD ONLY. `is_harness_block` already knows this plugin's own
        # voice and the harness's block shapes, and it was wired into the task statement
        # alone — so a grant, the one thing the gated party must never be able to write,
        # was reachable from any text that arrived as a user turn. The inbox delivers this
        # plugin's notes exactly that way, which is how the same mistake landed on the
        # task statement in #106, #118, #166 and again in v1.52.0. On this path it does
        # not cost a stale statement, it merges to a deploying trunk (#192).
        if not is_harness_block(prompt):
            config.record_switches(ctx, config.approvals_in(safe))
        # An update that landed AFTER this session started. The board says this at session
        # start and could never say it afterwards — which is the one moment it is needed,
        # because the founder updates mid-session and the running hooks stay behind. They
        # then write the line a refusal asked for, watch the old capture eat it, and
        # reasonably conclude the fix does not work (#166).
        #
        # A fact about this clone, so it travels the way every other fact does: queued for
        # this session's own inbox, deduplicated on the claim, delivered on the next tool
        # call (decision 0009). Checked here rather than per tool call — once per founder
        # message is enough for something that changes when they run an installer.
        from claude_bestpractice import inbox, upgrade

        # No `if` in front of it: `inbox.post` refuses an empty claim already, and a
        # guard no mutation can kill is a line that only looks like care.
        inbox.post(ctx, event.session_id, upgrade.stale_line())
        # Paths ACCUMULATE where the statement replaces. A later instruction naming more
        # files genuinely widens what is in scope, and dropping the earlier ones would make
        # the files the founder first asked for into drift. Bounded, because unbounded
        # growth in a session record is how a fail-closed gate gets slow.
        fresh = extract_paths(prompt, ctx.worktree_root)
        merged = sorted(set(rec.task_paths) | set(fresh))
        updates: dict[str, object] = {"task_paths": merged[:MAX_TASK_PATHS]}
        # The statement follows the founder rather than freezing at the first thing they
        # said. It used to be written once and never again, so a session that had long
        # since moved on was still being measured against "посмотри заново бд" — and every
        # drift message quoted it back. But "follows the founder" was implemented as
        # "takes the last turn unconditionally", which is how a session's task became
        # «Делай». It follows the founder's *instructions*; a nod is not one.
        # The `or` is for a session that has no statement at all — a first turn, or one
        # resumed with nothing remembered. There, «Делай» is still better than a blank
        # board, and it is the only case that can still yield a branch named after a
        # continuation.
        # The blank-board fallback does NOT extend to a paste. "«Делай» is better than
        # nothing" is true; "the task is `(.venv) hedge@AVANTURER-PC:~$ ./deploy.sh`" is
        # not — that string is what every scope-drift refusal then quotes back at an agent
        # that cannot satisfy it. And an empty statement is the honest state here: it
        # leaves `task_paths` empty, which disables the drift check rather than enforcing
        # it against a shell prompt (#106).
        # The fallback does not extend to a harness block either, and for the same reason
        # as a paste: «Делай» is better than nothing, a tool-use id is not (#118).
        if is_statement_of_work(safe, fresh) or (
            not rec.task_statement
            and safe
            and not is_pasted_output(safe)
            and not is_harness_block(safe)
            and not config.is_only_a_switch(safe)
        ):
            # Marked when cut, because the drift refusal quotes this back as "Task was:"
            # and a fragment presented as the whole instruction is a claim the founder
            # cannot check. Reported as issue #41, where "…перезапустил д" was shown.
            statement = safe[:MAX_TASK_CHARS]
            if len(safe) > MAX_TASK_CHARS:
                statement += " […truncated; this is not the whole instruction]"
            updates["task_statement"] = statement
            # And onto the board, now rather than at the first write. Between those two
            # moments every sibling deciding what is safe to touch read an empty board
            # while somebody was already working — and the card, when it came, described
            # work already done instead of claiming work about to happen.
            # No paste guard here, though the first draft had one: `is_statement_of_work`
            # already refuses every paste and every harness block, and the fallback branch
            # excludes them too — so the statement can never BE a paste, and a second
            # check for it is a line no mutation can kill. The property still matters and
            # is still tested; it is guarded one layer up, where it belongs.
            if config.load(ctx).require_task:
                from claude_bestpractice import plan

                plan.open_for(ctx, statement, event.session_id)
        # Paths from the ORIGINAL: redaction rewrites credential-shaped tokens, and a
        # filename is not a credential. Scrubbing first would lose real paths.
        sessions.touch(ctx, event.session_id, **updates)
    else:
        sessions.touch(ctx, event.session_id)

    hookio.emit_silent()


if __name__ == "__main__":
    hookio.guard(main, fail_closed=False)
