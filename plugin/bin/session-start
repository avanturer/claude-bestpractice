#!/usr/bin/env python3
"""SessionStart: reap the dead, register this session, inject the board.

Fails OPEN. A crash here means no context, which is recoverable. Blocking a session
from starting because a coordination nicety broke would be worse than the problem.

Matcher must include `compact` and `resume`: rules re-injected verbatim after a
compaction restore compliance to 0% violation, and compaction is the single largest
destroyer of in-context rules (0% -> 30% after one round, 78% after four).
"""

from __future__ import annotations

import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from claude_bestpractice import board, ci, config, hookio, knowledge, limits, migrate, onboard, plan, policy, pullrequest, sessions, stage, store, upgrade, worktree  # noqa: E402
from claude_bestpractice.gitctx import GitContext, resolve, stash_baseline  # noqa: E402


def send_captured_defects(ctx, cfg) -> None:
    """Fire the sender and walk away, when this repository asked for `auto`.

    Detached and never waited on. The session must not pay for a network call, and it
    must not fail because one did — the whole point of capture living on disk is that the
    report survives whether or not this succeeds.
    """
    from claude_bestpractice import defects

    if cfg.report_defects != defects.AUTO or not defects.unsent(ctx):
        return
    try:
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve().parent / "claude-bp-report"), "send"],
            cwd=str(ctx.worktree_root),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
        )
    except OSError:
        return


def build_record(ctx: GitContext, event: hookio.HookEvent) -> sessions.SessionRecord:
    existing = sessions.get(ctx, event.session_id)
    now = time.time()
    baseline = stash_baseline(ctx)
    pid, pid_trust = sessions.resolve_owner()

    if existing:
        # A resume or post-compaction restart keeps its identity, its task statement
        # and its baseline. Re-deriving the baseline here would silently move the
        # review anchor and make the diff since "start of work" wrong.
        existing.heartbeat_at = now
        existing.pid = pid
        # Re-stamped, never merged: this is what upgrades a record written by a version
        # that recorded the hook's shell wrapper and called it the session's owner.
        existing.pid_trust = pid_trust
        existing.branch = ctx.branch
        return existing

    # A session resumed after a crash was already reaped by a sibling, so `existing` is
    # gone. Recover what it knew rather than starting from HEAD, which would silently
    # place every commit it had already made outside the gate's reach.
    remembered = sessions.reaped_memory(ctx, event.session_id)

    return sessions.SessionRecord(
        session_id=event.session_id or f"anon-{os.getpid()}",
        pid=pid,
        pid_trust=pid_trust,
        worktree=ctx.worktree_root.as_posix(),
        branch=ctx.branch,
        baseline_commit=str(remembered.get("baseline_commit") or baseline),
        task_statement=str(remembered.get("task_statement") or ""),
        task_paths=list(remembered.get("task_paths") or []),
        started_at=now,
        heartbeat_at=now,
        model=str(event.raw.get("model") or ""),
        effort=str((event.raw.get("effort") or {}).get("level", "") if isinstance(event.raw.get("effort"), dict) else ""),
    )


_AUTONOMY_LINES = {
    "vibecode": (
        "mode: vibecode — do it yourself. Read the PR, search the web, take credentials "
        "from the environment, pick between options and record why. Ask the founder only "
        "for what is genuinely theirs: money, legal exposure, product direction. Show "
        "outcomes, never diffs."
    ),
    "pair": (
        "mode: pair — propose before anything structural: schema, dependencies, public "
        "interfaces. Small fixes still go straight in."
    ),
}


def _autonomy_line(mode: str) -> str:
    """One line, because this is the half of the contract no program can check.

    Everything else in this board is a fact the harness enforces. This is advice, and
    saying so is the difference between a rule and a suggestion the model quietly drops.
    """
    return _AUTONOMY_LINES.get(mode, _AUTONOMY_LINES["vibecode"])


def _config_line(ctx: GitContext, complaints: list) -> str:
    """What in the founder's config no gate can read, said where somebody will see it.

    A `config.json` that did not parse was read as no config at all — every key at its
    default, `enabled: false` included — and the one reader that says so had no caller
    outside the tests. Sessions are refused the file, so the line is the founder's to act on.
    """
    if not complaints:
        return ""
    more = f" (+{len(complaints) - 1} more in `claude-bp status`)" if len(complaints) > 1 else ""
    return (f"\nconfig: {complaints[0]}{more}. {config.config_path(ctx)} is the founder's to "
            "fix — tell them; no session may edit it.")


def _armed_line(ctx: GitContext) -> str:
    """Arm the push gate on the first session that finds it missing, and say so once.

    `Setup` only fires on `--init`, so installing the plugin into an existing repository
    — the path the README leads with — left `claude plugin list` saying enabled and no
    hook guarding any push. This is where that gets closed.

    Costs nothing against the always-on context budget: it returns empty on every session
    after the one that installs the hook, which is all of them.
    """
    armed, note = ci.ensure(ctx)
    if not armed:
        return ""
    if note == "refreshed":
        # A different fact from arming, and saying "now runs before every push" here would
        # be false — it already did. What changed is that it is no longer the old version's
        # copy, which matters because one of those had an `exit 0` in it.
        return (
            "\nthe pre-push hook was updated to this version of the plugin "
            "(`claude-bp-ci status` to see what it runs)"
        )

    # Name what will actually run, or say that nothing will. The line used to read "checks
    # now run before every push" in every repository — including one with no `make check`
    # target and no detectable runner, where the hook reaches `claude-bp-ci` and
    # `claude-bp-doctor` by name, finds neither on a marketplace user's PATH, and exits 0.
    # A promise larger than the fact is the exact failure this project is written against,
    # and it was this project making it. Reported from a real install.
    from claude_bestpractice.config import detect_test_command

    makefile = ctx.worktree_root / "Makefile"
    if makefile.is_file() and any(
        line.startswith("check:") for line in makefile.read_text(
            encoding="utf-8", errors="replace").splitlines()
    ):
        what = "`make check`"
    else:
        command = detect_test_command(ctx.worktree_root)
        what = "`" + " ".join(command) + "`" if command else ""

    if not what:
        return (
            "\na pre-push hook is installed, but this repository has no `make check` target "
            "and no detectable test runner, so it will refuse nothing until it does. "
            "`claude-bp-ci status` to see."
        )
    line = f"\n{what} now runs before every push (`claude-bp-ci off` if you do not want it)"
    if "moved to" in note:
        # A file of theirs moved. Chaining it correctly is not a licence to do it silently.
        line += "\n" + note.split("\n", 1)[-1].strip()
    return line


def _reclaimed_line(returned: list) -> str:
    """Say that the work came back, because the alternative is filing it twice.

    A session that restarted has no memory of losing the claim; it sees an unowned task
    that looks like its own work and, told by the Stop gate that nothing on the board is
    its, files a second one. Naming the ids here is what makes that unnecessary.
    """
    if not returned:
        return ""
    return (
        f"\nreclaimed: {', '.join(returned)} — this session held it before the restart "
        "and it was still free. Carry on with it; do not file it again."
    )


def _swept_line(removed: list) -> str:
    """Say what was deleted. Deleting directories is the only destructive thing this
    plugin does on its own initiative, and it was the only one it did not report — while
    it announces every worktree it CREATES. Reported from a real run: the count went from
    six to five with nothing said anywhere.

    To someone returning to a tree they had committed in, a directory that is simply gone
    reads as lost work, so the line leads with the part that makes that false. Empty on
    every session that swept nothing, which is nearly all of them.
    """
    if not removed:
        return ""
    return (
        f"\nremoved {len(removed)} unused worktree(s) no live session was in — their "
        "branches are kept, so nothing committed is gone; `git branch` lists them."
    )


# What a restored checkpoint may cost. Compaction has just freed the whole window, so this
# is the cheapest moment in a session to spend a little — and it is spent nowhere else:
# every other session start returns nothing from here.
MAX_RESTORED = 2_400


def _restored_line(ctx: GitContext, event) -> str:
    """After a compaction, hand back what the window just destroyed.

    The checkpoint was written on every compaction since the first release and never read.
    That is the pattern `provenance` opens by naming as how memory features fail — capture
    on every checkpoint, never look again — and this plugin was doing it to itself.

    Only on `compact`. A resume did not lose anything, and a startup has nothing to lose,
    so this costs the always-on budget nothing at all.
    """
    if str(event.raw.get("source") or "") != "compact":
        return ""
    text = store.newest_checkpoint(ctx, event.session_id)
    if not text:
        return ""
    body = text.split("---", 2)[-1].strip()
    if len(body) > MAX_RESTORED:
        # Name the directory. "on disk" without a path is a pointer to nowhere, and the
        # session it is addressed to has just been compacted and knows least of anyone.
        where = store.tier_a(ctx, "checkpoints")
        try:
            where = where.relative_to(ctx.worktree_root)
        except ValueError:
            pass
        body = body[:MAX_RESTORED] + f"\n[…truncated; the whole checkpoint is in {where}/]"
    return (
        "\n\nRESTORED AFTER COMPACTION — this is what the window held before it was "
        "compacted, written at the time by this plugin rather than summarised now. Treat it "
        "as the record of what was asked and what was underway, and keep working from it:\n"
        + body
    )


def _denied_line(ctx: GitContext) -> str:
    """What auto mode refused, so the next fix can be aimed rather than guessed.

    This plugin decides one half of the permission question and the classifier decides the
    other, and until the `PermissionDenied` event existed nothing here could see the other
    half. Every "it asked me again" arrived as a screenshot.

    Empty in a repository where nothing has been denied, which is the steady state once
    the vouch covers the work.
    """
    denials = store.read_json(store.tier_b(ctx, "auto-mode-denials.json"), default=[])
    if not isinstance(denials, list) or not denials:
        return ""
    recent = denials[-3:]
    shown = "; ".join(f"{d.get('tool', '?')} {str(d.get('detail') or '')[:40]}".strip()
                      for d in recent)
    return (
        f"\nAUTO MODE REFUSED {len(denials)} call(s) here, most recently: {shown}. "
        "This gate did not vouch for those, so the classifier decided. If one of them is "
        "ordinary work in this repository, say so — the answer is a narrower rule, never a "
        "broader one."
    )


def _stranded_line(ctx: GitContext) -> str:
    """Trees nobody is in that the sweep cannot clear, because they hold work.

    The sweep removes what it can, silently and correctly. What it refuses is what piles
    up — and until this, nothing said so. Empty in a repository whose trees are all either
    occupied or clean, which is the steady state (#123).
    """
    left = worktree.stranded(ctx)
    if not left:
        return ""
    shown = ", ".join(Path(p).name for p in left[:3])
    more = f" (+{len(left) - 3} more)" if len(left) > 3 else ""
    return (
        f"\nABANDONED WORKTREES: {len(left)} tree(s) nobody is in are holding uncommitted "
        f"work — {shown}{more}. The sweep will not delete work, so they stay until someone "
        "decides: finish and merge, or `git worktree remove --force`. Ask the founder "
        "before discarding anything."
    )


def _removable_line(ctx: GitContext) -> str:
    """Trees standing over a branch that is already in, that this plugin may not remove.

    It removes its OWN the moment the work in them lands (`worktree.release_mine`), and it
    will not touch a directory another tool made — so what is left is named. Fifteen of the
    thirty-eight trees on the reporting repository were in exactly this state, with a
    project rule that said to remove them and nothing that did (#220).

    Empty once the trees are the plugin's own, which is the steady state it is now driving
    towards, and empty in any clone with one checkout.
    """
    left = worktree.needs_a_decision(ctx)
    if not left:
        return ""
    merged = [(path, branch) for path, branch in left if branch]
    adrift = [path for path, branch in left if not branch]
    shown = ", ".join(f"{Path(path).name} ({branch})" for path, branch in merged[:3])
    more = f" (+{len(merged) - 3} more)" if len(merged) > 3 else ""
    said = (
        f"\nTREES NOBODY IS IN: {len(merged)} whose branch is already in the trunk — "
        f"{shown}{more}; nothing in them is unmerged, so "
        f"`git -C {worktree.main_checkout(ctx)} worktree remove <path>` and "
        "`git branch -d <branch>` lose nothing. This plugin removes the trees IT made and "
        "leaves these."
    ) if merged else "\nTREES NOBODY IS IN:"
    if adrift:
        # A detached HEAD is worse than a stale tree and reads the same from outside: the
        # commits in it are on no branch, so removing the directory is what loses them.
        said += (
            f" {len(adrift)} on a DETACHED HEAD ({', '.join(Path(p).name for p in adrift[:3])})"
            " — whatever was committed there is on no branch and goes with the directory. "
            "`git -C <path> log --oneline -3` says what is in one; `git -C <path> branch "
            "<name>` keeps it."
        )
    return said


def _unfinished_line(ctx: GitContext, cfg) -> str:
    """Work that will never arrive on its own: a branch with no pull request, a PR nobody
    has touched.

    Both were invisible from inside a session. A branch with one commit and no pull request
    was found a hundred and twenty-six commits behind the trunk, fixing a problem that had
    since been reported twice more; three open pull requests had sat for a month. The board
    showed neither, and neither did anything else a session reads (#220).

    One line for both, because they are one subject, and two names of each: this is a prompt
    to finish something, not a report to work through. Empty in a repository whose branches
    all have pull requests and whose pull requests are all moving.
    """
    branches = pullrequest.branches_without_one(ctx, cfg.branch_without_pr_hours)
    stale = pullrequest.idle(ctx, cfg.pull_request_idle_days)
    if not branches and not stale:
        return ""
    items = [f"{name} ({age / 24:.0f}d, no pull request this clone has seen)"
             if age >= 48 else f"{name} ({age:.0f}h, no pull request this clone has seen)"
             for name, age in branches[:2]]
    # A number of 0 means the obligation was recorded before anything learned the number —
    # `gh pr create` in a shell this gate could not parse. "PR #0" is a lie the branch is not.
    items += [f"{f'PR #{number}' if number else 'a pull request'} on {branch} "
              f"({days:.0f}d, no movement)" for number, branch, days in stale[:2]]
    over = len(branches) + len(stale) - len(items)
    return (
        f"\nNOBODY IS COMING BACK TO THESE: {'; '.join(items)}"
        + (f" (+{over} more)" if over > 0 else "")
        + ". A branch nothing points at is work that never arrives. Check with "
        "`gh pr list --head <branch>`, open one with `claude-bp-ship --pr`, or delete the "
        "branch — and tell the founder before deleting anything that was not merged."
    )


def _knowledge_line(ctx: GitContext) -> str:
    """Say so when this repository has no knowledge layer. Once, and then never.

    `Setup` fires on `--init`, and `claude-bp status` is a command the founder runs, so on
    the ordinary install path nothing ever told a session the layer was missing. Verified:
    a fresh session on a fresh repository went and edited code, and the layer was still
    absent afterwards — the mechanism that asks the founder the three things only they know
    was correct and never reached.

    Costs nothing after the layer exists, which is every session but the first few.
    """
    found = onboard.shape(ctx)
    if found == onboard.OURS:
        return ""
    if found == onboard.ANOTHER:
        # There IS a layer; it is in a different shape, in the same folder. Saying it is
        # absent told a founder to start what they had finished months ago (#112).
        rules = knowledge.existing_rules(ctx)
        cost = knowledge.instruction_bytes(ctx)
        return (
            f"\nknowledge layer: {len(rules)} instruction file(s) already here, {cost} bytes "
            "loaded into every turn, not in this plugin's shape. READ them before writing "
            "any rule of your own, and put a new one where the existing ones are. "
            "`claude-bp init` would add a second layer beside them; the founder decides that."
        )
    return (
        "\nno knowledge layer here yet: run `claude-bp init`, then ASK THE FOUNDER for the "
        "placeholders it leaves — what this is, who it is for, its non-goals. Those cannot "
        "be derived from code and must not be invented."
    )


def _stale_rules_line(ctx: GitContext) -> str:
    """Standing instructions whose subject has left the repository.

    A rule file has no expiry and no test, and the failure is quiet: an instruction naming
    a path that was moved months ago is followed, or worked around, by every session that
    reads it. Reported and never edited — deciding what the founder meant by a line is
    judgement a path check does not have (#113, decision 0007).

    Empty in every repository whose rules still match the tree, which is nearly all of them.
    """
    stale = knowledge.stale_rules(ctx)
    if not stale:
        return ""
    return (
        f"\nSTANDING RULES OUT OF DATE: {'; '.join(stale[:3])}"
        + (f" (+{len(stale) - 3} more)" if len(stale) > 3 else "")
        + ". Tell the founder; do not quietly work around them and do not edit their file."
    )


def _worktree_line(ctx: GitContext, cfg, session_id: str = "") -> str:
    """Standing instruction, because a refusal is not one.

    `EnterWorktree` refuses to act on its own judgement — its description says to use it
    ONLY when explicitly instructed by the user or by project instructions in CLAUDE.md or
    memory, and never when "worktree" is not mentioned there. This plugin's requirement
    lived exclusively in the pre-tool refusal, which arrives AFTER a write is blocked and
    does not persist. So the agent read "do not ask, just move" at the moment of failure
    and started the next task with no standing instruction — asking the founder again, or
    editing the main checkout and being refused again. Forty-two refusals across four
    transcripts of one day, each provisioning a branch nobody asked for (#81).

    Named explicitly, `EnterWorktree` and the path, because that tool's own gate is what
    has to be satisfied. Empty for a session already in a worktree and for a repository
    that has switched the rule off, which together are the steady state.

    The path is the one this plugin already provisioned for this session, when there is
    one. The line said "with the path" and named none, so a session restarted outside its
    tree had to invent the argument — and one that had already moved invented its own
    working directory, which `EnterWorktree` refuses as "is the current working
    directory". A wasted call, and outside `.claude/worktrees/` it also costs a
    permission prompt the founder then has to answer.
    """
    if not cfg.require_worktree or ctx.is_worktree:
        return ""
    standing = worktree.mine(ctx, session_id)
    where = f" `{standing}`" if standing else ""
    return (
        f"\nworktree: work happens in your own worktree{where}, never in this main checkout. "
        "Moving there is THIS PROJECT'S INSTRUCTION and needs no permission — use "
        "`EnterWorktree` with the path, or `cd`, and do not ask the founder about it. "
        "One tree per session."
    )


def _hidden_line(ctx: GitContext) -> str:
    """Say it when git cannot see the layer this plugin calls committed.

    The failure it reports is otherwise undetectable from inside the plugin: every command
    reports success, because every command is asking the filesystem, and the filesystem is
    fine. Only git disagrees, and nothing was looking. Reported as issue #66 after thirty
    parked tasks turned out to be one `git worktree remove` from gone.

    Costs nothing against the always-on budget in any repository where nothing hides it,
    which is nearly all of them.
    """
    where = store.hidden_from_git(ctx)
    if not where:
        return ""
    source = where.split(":", 1)[0]
    # The COUNT, because "a layer is hidden" is an abstraction and "eleven records die with
    # this clone" is a decision. Measured from what git actually tracks rather than from
    # what the exclude rule says, so a file committed before the rule appeared is not
    # counted as lost — several are, and reporting them would make the number untrustworthy.
    lost = store.ignored_tier_a(ctx)
    cost = f"{len(lost)} record(s) not in git" if lost else "nothing lost yet"
    return (
        f"\nGIT CANNOT SEE `{store.TIER_A_DIRNAME}/` — hidden by {where}; {cost}. The config "
        "the gates read, the stage ratchet and the attempts a later session must not blindly "
        f"redo are being written where nothing will ever commit them. Fix the rule in {source}; "
        "the plugin does not edit it, because it did not write it. (The task ledger is "
        "deliberately out of git and is not counted here — its files live in the main "
        "checkout and outlive every worktree.)"
    )


def main() -> None:
    event = hookio.read_event()
    ctx = hookio.repo(event.cwd or os.getcwd())

    store.ensure_dir(store.tier_b(ctx))
    reaped = sessions.reap(ctx, exclude=event.session_id)

    me = build_record(ctx, event)
    sessions.register(ctx, me)

    # Before the board is built, so what it says is in flight is true when it is read.
    # A process restart leaves the session id alone and the pid dead, so a sibling's
    # reaper correctly released this session's claim and it comes back owning nothing —
    # after which the first Stop refuses the turn and tells it to file a NEW task for work
    # already on the board (#131). Only what is still free is taken back.
    returned = plan.reclaim(ctx, me.session_id)

    others = sessions.live_sessions(ctx, exclude=me.session_id)

    # The plugin creates worktrees unasked, so clearing away the ones nobody is in is the
    # plugin's job too — nine accumulated on one repository in a single run, each an empty
    # branch over an empty directory. Only trees it provisioned, only for sessions that are
    # gone, and only via `git worktree remove` and `git branch -d`, both of which refuse
    # rather than destroy when there is anything there.
    swept = worktree.reap_unused(ctx, {rec.session_id for rec in others} | {me.session_id})
    leases = {rec.session_id: sessions.leases_held_by(ctx, rec.session_id) for rec in others}

    # Repairs are the plugin's own state and run themselves. Adoption rewrites files in
    # the founder's repository and does not — it is surfaced by `_knowledge_line` and
    # applied by one command.
    repaired = migrate.repair(ctx)

    cfg, complaints = config.load_checked(ctx)
    # Work that stopped moving. `reap` covers the session that DIED; this covers the
    # commoner case — a live chat that claimed 0007, moved on, and left it reading `doing`
    # on every board for the rest of the week. Before the board is rendered, because the
    # point is that the board's account of what is in flight is true when it is read.
    if cfg.task_idle_hours > 0:
        plan.sweep_idle(ctx, cfg.task_idle_hours)
    # The other half. `sweep_idle` returns stalled work TO the queue and nothing has ever
    # taken anything out of it, so `next` only ever grew. Set aside, not deleted: one
    # `claude-bp-plan resume` brings it straight back.
    plan.sweep_queue(ctx, cfg.task_queue_stale_days)

    resolved_stage, _signals = stage.current(ctx, cfg.stage_override)
    send_captured_defects(ctx, cfg)

    body = board.render(ctx, me, others, len(reaped), leases)
    body += f"\nstage: {resolved_stage} (computed from the repository, not configured)"
    body += "\n" + _autonomy_line(cfg.autonomy)
    body += _config_line(ctx, complaints)
    body += _armed_line(ctx)
    body += _swept_line(swept)
    body += _reclaimed_line(returned)
    body += _stranded_line(ctx)
    # Both empty in the steady state, and the steady state is what the removal above
    # produces: a tree whose work is in and whose cards are closed is gone before this
    # line could name it.
    body += _removable_line(ctx)
    body += _unfinished_line(ctx, cfg)
    body += _denied_line(ctx)
    # Silent until a status line has run once, and silent again when the numbers go stale.
    body += limits.line(ctx)
    body += _restored_line(ctx, event)
    body += _knowledge_line(ctx)
    body += _stale_rules_line(ctx)
    # Silent until the layer actually grew, and silent again once it is trimmed back.
    body += knowledge.rules_growth(ctx)
    body += _hidden_line(ctx)
    line = _worktree_line(ctx, cfg, event.session_id)
    body += line
    # Only alongside the rule itself. Empty once the founder has added the permission, and
    # empty for a session already in a worktree, which is not about to be prompted.
    body += worktree.permission_advice(ctx, event.session_id) if line else ""
    # Empty in every repository whose tasks already live in the ledger, which is the
    # steady state — this only speaks while a workaround is still lying around.
    # Brought up to date here rather than named as a command, because the command was
    # refused by the classifier it exists to inform (#116). Writes nothing when nothing
    # moved, which is every session after the first.
    body += policy.refresh(ctx, cfg.test_command)
    # What this upgrade actually changed here, and only when it changed something.
    body += migrate.repaired_line(repaired)
    loose = migrate.line(ctx)
    body += f"\n{loose}" if loose else ""
    # Empty on every session that is running what is installed, which is all of them
    # except the ones that just updated and did not restart.
    body += upgrade.stale_line()

    hookio.emit_context("SessionStart", body)


if __name__ == "__main__":
    hookio.guard(main, fail_closed=False)
