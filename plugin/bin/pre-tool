#!/usr/bin/env python3
"""PreToolUse: the fuses. Counters, loop detection, secret pre-write scan, leases.

Fails CLOSED. This gate's entire value is refusing things; a crash that silently
allows is the failure mode that makes a security plugin decorative.

Denials are returned as `permissionDecision: deny` with a reason rather than exit 2.
That talks to the model, which self-corrects silently — the founder is never
interrupted. Reserve exit 2 for a gate whose failure must be loud.

Never reads TOOL_NAME or TOOL_INPUT from the environment. Those variables do not
exist; shipped plugins that read them enforce nothing.
"""

from __future__ import annotations

import functools
import os
import shlex
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import json  # noqa: E402
import re  # noqa: E402

from claude_bestpractice import ci, config, evidence, gitpolicy, hookio, inbox, pullrequest, redact, sessions, shellcmd, stage, store, subagents, vouch, worktree  # noqa: E402
from claude_bestpractice.gitctx import resolve  # noqa: E402

WRITE_TOOLS = {"Write", "Edit", "MultiEdit", "NotebookEdit"}
SIGNATURE_HISTORY = 64

# The files that decide what the gates do. Everything else under .claude/claude-bestpractice/ is
# the agent's to write — tasks, decisions, dead ends are all meant to be written by it.
# These are not: they are the rules, and the party being ruled does not amend them.
PROTECTED_STATE = (
    ".claude/claude-bestpractice/config.json",
    ".claude/claude-bestpractice/stage/",
    ".claude/claude-bestpractice/slop-budget.json",
    # The record of a failing suite. Not on this list until round six, while every
    # elaborate defence of *clearing* it was being built — and the gate's own denial text
    # told the agent "everything else under .claude/claude-bestpractice/ is yours to write", which
    # was true and was an instruction. `rm .claude/claude-bestpractice/failing-suite.json` was
    # allowed, silently, and ended the whole argument in one call.
    ".claude/claude-bestpractice/failing-suite.json",
    ".claude/claude-bestpractice/last-green.json",
)

# The OTHER half of the enforcement state. `config.json` was refused as "the plugin's own
# enforcement state" while everything under the git common directory — session records,
# baselines, the block counter — stayed writable, and `evidence-gate` trusts all of it.
# Reported as issue #32, with two working bypasses of a gate that was blocking a red suite:
#
#   1. commit the broken change, then set `baseline_commit` to the new HEAD. `changed_files`
#      comes back empty, the suite is never run, and NOTHING is recorded — no unverified
#      entry, no open item. The next session sees a clean history. This is the serious one.
#   2. set `tool_signatures._consecutive_blocks` to the ceiling. One integer, and the turn
#      ends as "finishing UNVERIFIED after 4 blocked attempts" — indistinguishable from a
#      session that genuinely hit it.
#
# The threat model is not a malicious founder. It is an agent that has been blocked four
# times looking for the shortest way to end the turn, in a directory whose path this
# plugin PRINTS on the board, holding plain JSON whose field names say what they do.
#
# Resolved rather than repo-relative: in a worktree the common directory lives in the main
# checkout, so this path is not under our tree at all and no relative rule would see it.
def _protected_absolute(ctx) -> list:
    """Paths outside the working tree that are still the plugin's own state."""
    return [store.tier_b(ctx), ci.hook_path(ctx)]


def _protected_state(relpath: str) -> bool:
    # NOT lstrip("./") — that strips CHARACTERS, so it eats the leading dot of `.claude`
    # and nothing ever matches. The check silently passed everything and the test that
    # caught it was an end-to-end run, not the unit test, which is the whole lesson here.
    rel = relpath.replace("\\", "/")
    while rel.startswith("./"):
        rel = rel[2:]
    # `rm -rf .claude/claude-bestpractice/stage` names the DIRECTORY, with no trailing slash, so a
    # prefix entry of ".../stage/" matched nothing and the whole stage ratchet could be
    # deleted in one command. Match the directory itself as well as its contents.
    if any(
        rel == p or rel == p.rstrip("/") or rel.startswith(p.rstrip("/") + "/")
        for p in PROTECTED_STATE
    ):
        return True
    # And an ANCESTOR of anything protected. `rm -rf .claude/claude-bestpractice` names neither a
    # protected file nor a protected directory, and takes every one of them with it —
    # a rule that guards the leaves and not the branch guards nothing.
    return any(p.startswith(rel.rstrip("/") + "/") for p in PROTECTED_STATE)


# `"claude-bestpractice@claude-bestpractice": false`, as it reads in a file a session is
# part-way through writing. The JSON parse below is the real reader; this catches the
# fragment an `Edit` or a heredoc carries, where there is no whole document to parse.
_SWITCHED_OFF = re.compile(
    r'"' + re.escape(config.PLUGIN_KEY) + r'"\s*:\s*false', re.I
)


# `.env`, `.env.local`, `.env.production` — the files whose entire purpose is to hold what
# this scan refuses. Anything with another name is judged as source, which is what it is.
def _is_env_file(name: str) -> bool:
    """Whether this file name is an environment file rather than source."""
    return name == worktree.ENV_FILE or name.startswith(worktree.ENV_FILE + ".")


def _a_credential_belongs_here(ctx, targets: list) -> bool:
    """An env file git ignores, which is where the scan's own advice sends a credential.

    The scan exists to stop a secret reaching a file a commit will carry. An ignored `.env`
    is the one place it cannot: the refusal says "put it in an environment variable and
    reference it", and this is that file. Refusing it made the third grain of one circle —
    the isolation gate sends the session to write `DATABASE_URL` there, every DSN worth
    writing carries a password, and this gate then refused the write the other one ordered
    (#216).

    Both halves required, and the second is what keeps this from being a hole: a `.env`
    that is TRACKED is a file a commit does carry, and that is the leak this gate is for.
    """
    if not targets:
        return False
    return all(
        _is_env_file(path.name) and gitpolicy.ignored_by_git(ctx.worktree_root, path)
        for path in targets
    )


def _turns_it_off(content: str) -> bool:
    """Whether this text switches this plugin off in a settings file."""
    try:
        parsed = json.loads(content)
    except (TypeError, ValueError):
        parsed = None
    if isinstance(parsed, dict):
        wanted = parsed.get("enabledPlugins")
        return isinstance(wanted, dict) and wanted.get(config.PLUGIN_KEY) is False
    return bool(_SWITCHED_OFF.search(content or ""))


def _disables_the_plugin(ctx, path: Path, content: str) -> bool:
    """Whether this write is the founder's switch being thrown by somebody else.

    Narrow on purpose, in three directions: the project's own settings files only, the one
    key that decides whether this plugin enforces anything, and only the direction that
    switches it off. A session edits permissions, hooks and env in that file for the
    founder all day, and refusing the file wholesale would be this plugin taking a file
    that is not its own.

    In this tree or in the main checkout, which is where every tree reads the switch from.
    """
    rels = _relative_in(path, ctx.worktree_root, config.founders_tree(ctx))
    if not set(rels) & set(config.PROJECT_SETTINGS) or config.disabled_for_project(ctx):
        return False
    return _turns_it_off(content)


def _relative_in(path: Path, *roots: Path) -> list:
    """This path as each of these trees names it, for the trees it is inside."""
    out = []
    for root in roots:
        try:
            out.append(path.resolve().relative_to(root.resolve()).as_posix())
        except (OSError, ValueError):
            continue
    return out


def _founders_state(ctx, absolute: list) -> list:
    """Enforcement state in the main checkout, written from another tree.

    Every tree reads the main checkout's `config.json` now, and the rule below only sees
    writes inside this session's own tree — so without this a session in a worktree could
    rewrite the one config every tree obeys, `enabled` and `test_command` included.
    """
    home = config.founders_tree(ctx)
    if home.resolve() == ctx.worktree_root.resolve():
        return []
    return [str(path) for path in absolute
            if any(_protected_state(rel) for rel in _relative_in(path, home))]


MIGRATION_DIRS = ("migrations/", "db/migrate/", "prisma/migrations/", "alembic/versions/")

# Irreversible and data-shaped: the tests pass either way, and corruption only shows up
# under production concurrency long after the change looked fine.
DESTRUCTIVE_DDL = re.compile(
    r"(?i)\b(?:DROP\s+(?:TABLE|COLUMN|SCHEMA|DATABASE)|TRUNCATE\b|"
    r"ALTER\s+(?:TABLE\s+\w+\s+)?(?:DROP|ALTER\s+COLUMN\s+\w+\s+TYPE)|RENAME\s+COLUMN)"
)

# Promotion is the one-way door. Preview deploys stay free; rollback is fully automatic
# precisely because its failure mode is returning to what already worked.
#
# Decided on the PROGRAM and what it was told to do, never on a flag wherever it appears.
# `--prod` anywhere in a line refused `npm ci --production` and `pnpm install --prod`, which
# install; `git grep -- --production`, which searches; a commit message mentioning the flag;
# and `terraform plan` and `kubectl get` pointed at production, which change nothing. Each
# went to the founder rather than to the session — and each spent their one `+release` on
# the way through, so the real promotion after it was refused again.
_PRODUCTION = re.compile(r"(?i)(?:^|[^a-z])prod(?:uction)?(?:[^a-z]|$)")

# A project's own way to ship, named for it: `./deploy.sh --prod`, `npm run deploy --
# --production`, `make release ENV=production`. The name is all a gate can read about what
# a project's script does, and it is what the flag-anywhere rule was catching for these.
_NAMED_FOR_SHIPPING = re.compile(r"(?i)deploy|release|promote")

# How such a script is reached: a package runner, a package manager's `run`, make, or an
# interpreter handed the file.
_RUNS_A_SCRIPT = {"npx", "pnpx", "bunx", "yarn", "make", "just"}
_SCRIPT_VERBS = {"run", "run-script", "exec", "dlx", "x"}
_PACKAGE_MANAGERS = {"npm", "pnpm", "yarn", "bun"}

# Each tool's subcommands, the ones that change what is deployed and the ones that only
# look, so that the first of them on a line says which kind this is — whatever global
# option values stand in front of it.
_VERCEL_VERBS = {"deploy", "redeploy", "promote", "build", "dev", "env", "pull", "link", "ls",
                 "list", "inspect", "logs", "rollback", "alias", "domains", "rm", "remove"}
_KUBECTL_CHANGES = {"apply", "create", "delete", "replace", "patch", "edit", "set", "rollout",
                    "scale", "autoscale", "label", "annotate", "expose", "run", "drain",
                    "cordon", "uncordon", "taint"}
_KUBECTL_READS = {"get", "describe", "logs", "top", "explain", "diff", "version", "config",
                  "api-resources", "api-versions", "auth", "cluster-info", "events", "wait",
                  "port-forward", "exec", "cp", "attach", "proxy"}
_HELM_VERBS = {"install", "upgrade", "uninstall", "delete", "rollback", "list", "ls",
               "status", "get", "history", "template", "lint", "show", "diff", "repo",
               "dependency", "search", "pull", "package", "test", "version"}
_TERRAFORM_VERBS = {"apply", "destroy", "plan", "show", "output", "validate", "fmt", "init",
                    "state", "graph", "providers", "version", "workspace", "import", "refresh",
                    "console", "taint", "untaint", "test", "get"}


def _verb(args: list[str], known: set[str]) -> str:
    """The first argument that is one of a tool's own subcommands, or ""."""
    return next((arg for arg in args if arg in known), "")


def _values(args: list[str], *names: str) -> list[str]:
    """Every value these options were given, as `--name value` or `--name=value`."""
    out: list[str] = []
    for index, arg in enumerate(args):
        for name in names:
            if arg == name and index + 1 < len(args):
                out.append(args[index + 1])
            elif arg.startswith(name + "="):
                out.append(arg.split("=", 1)[1])
    return out


def _names_production(words: list[str]) -> bool:
    return any(_PRODUCTION.search(word) for word in words)


# One judge per program that deploys, handed the arguments after that program's name.
def _vercel(args: list[str]) -> bool:
    verb = _verb(args, _VERCEL_VERBS)
    if verb == "promote":
        return True
    return verb in ("", "deploy", "redeploy") and (
        "--prod" in args or _names_production(_values(args, "--target"))
    )


def _netlify(args: list[str]) -> bool:
    return _verb(args, {"deploy"}) == "deploy" and bool(
        {"--prod", "--prod-if-unlocked", "-p"}.intersection(args)
    )


def _fly(args: list[str]) -> bool:
    # A named config is how a fly app is deployed anywhere but its production one.
    return _verb(args, {"deploy"}) == "deploy" and not _values(args, "--config", "-c")


def _railway(args: list[str]) -> bool:
    return _verb(args, {"up"}) == "up"


def _kubectl(args: list[str]) -> bool:
    verb = _verb(args, _KUBECTL_CHANGES | _KUBECTL_READS)
    if verb not in _KUBECTL_CHANGES or (verb == "rollout" and _verb(args, {"status", "history"})):
        return False
    return _names_production(_values(args, "--context"))


def _helm(args: list[str]) -> bool:
    verb = _verb(args, _HELM_VERBS)
    return verb in ("install", "upgrade", "uninstall", "delete") and _names_production(args)


def _terraform(args: list[str]) -> bool:
    return _verb(args, _TERRAFORM_VERBS) in ("apply", "destroy") and _names_production(args)


# An over-the-air update is a promotion like any other (decision 0010).
def _eas(args: list[str]) -> bool:
    return _verb(args, {"update", "build", "submit", "channel", "branch"}) == "update" and \
        _names_production(_values(args, "--branch", "--channel", "--environment"))


_PROMOTES = {
    "vercel": _vercel, "netlify": _netlify, "ntl": _netlify, "fly": _fly, "flyctl": _fly,
    "railway": _railway, "kubectl": _kubectl, "helm": _helm, "terraform": _terraform,
    "tofu": _terraform, "terragrunt": _terraform, "eas": _eas,
}


def _what_runs(argv: list[str]) -> tuple[str, list[str]]:
    """The program a command really runs, and its arguments: past `npx`, `npm run`, `make`
    and an interpreter handed a script."""
    name, rest = argv[0].rsplit("/", 1)[-1], argv[1:]
    if name in _PACKAGE_MANAGERS and rest[:1] and rest[0] in _SCRIPT_VERBS:
        rest = rest[1:]
    elif name not in _RUNS_A_SCRIPT and not _INTERPRETER.match(name):
        return name, rest
    for index, word in enumerate(rest):
        if not word.startswith("-"):
            return word.rsplit("/", 1)[-1], rest[index + 1:]
    return name, rest


def promotes(argv: list[str]) -> bool:
    """Does this one command promote something to production?"""
    name, args = _what_runs(argv)
    judge = _PROMOTES.get(name)
    if judge is not None:
        return judge(args)
    return bool(_NAMED_FOR_SHIPPING.search(name)) and _names_production([name, *args])


# The words of a segment the tokeniser declines, for the one question asked of them here.
_WORD = re.compile(r"[^\s'\"`$();|&<>]+")


def promotes_to_production(command: str, cwd: Path) -> bool:
    """Does anything this line runs promote to production — its text about one never counts.

    Read per segment, so `(cd web && vercel --prod)` is read at all. A segment the tokeniser
    declines is not a way past: its words are still searched for a deploying program, which
    is the only thing that could make it one. A shell's `-c` is read as the line it is.
    """
    for _segment, literal, _here, _start in _segments_with_cwd(_blanked(command), cwd, command):
        commands = _commands_in(literal)
        if not commands:
            words = _WORD.findall(literal)
            commands = [words[at:] for at, word in enumerate(words)
                        if word.rsplit("/", 1)[-1] in _PROMOTES]
        for argv in commands:
            code = _shell_code(argv)
            if promotes(argv) or (code and promotes_to_production(code, cwd)):
                return True
    return False


def _shell_code(argv: list[str]) -> str:
    """The line a `sh -c` hands its shell to run, or "" for any other command."""
    if argv[0].rsplit("/", 1)[-1] in ("sh", "bash", "zsh") and "-c" in argv[1:-1]:
        return argv[argv.index("-c") + 1]
    return ""


def signature(event: hookio.HookEvent) -> str:
    """Identify a repeated action without keying on volatile detail.

    Two things are deliberately in and one deliberately out. The target path is in, so
    editing two different files is never mistaken for a loop. The replacement TEXT is out,
    so a retry with a one-character change is not mistaken for progress.

    What was wrongly out is the ANCHOR — which region of the file an edit names. Five
    sequential edits to five different parts of one module are ordinary work, and they
    shared a signature, so the fifth was refused as "run 4 times in a row with nothing in
    between" (#95). A retry of a failed edit repeats its `old_string`; a distinct edit does
    not, which is exactly the line the detector wanted and was not drawing.

    And a Bash command is hashed WHOLE. Truncating at 160 characters made four heredocs
    writing four different files identical, because the boilerplate that opens them is —
    so probing for the cause of one block was itself blocked.

    A SPAWN names none of those fields, so every subagent call in a session hashed to the
    same thing and the fourth one was refused as a loop — for asking a different agent a
    different question. Its target is what makes it distinct: the agent and the task.
    """
    import hashlib

    ti = event.tool_input
    target = (ti.get("file_path") or ti.get("path") or ti.get("command")
              or _spawn_target(event) or "")
    anchors = [str(ti.get("old_string") or ti.get("old_str") or "")]
    edits = ti.get("edits")
    if isinstance(edits, list):
        anchors.extend(str(e.get("old_string", "")) for e in edits if isinstance(e, dict))
    seed = "\u0000".join([str(target), *(a for a in anchors if a)])
    # `surrogatepass`, not `surrogateescape`: the second only round-trips the surrogates
    # that decoding bytes produces, and a paste can carry any lone one. `echo "\ud800"`
    # raised here, before any rule had looked at the call, and a fail-closed gate turned
    # that into a refusal of a command that writes nothing.
    return f"{event.tool_name}:{hashlib.sha256(seed.encode('utf-8', 'surrogatepass')).hexdigest()[:24]}"


def _spawn_target(event: hookio.HookEvent) -> str:
    """What makes one subagent call different from the next: which agent, and what for."""
    if event.tool_name not in subagents.SPAWN_TOOLS:
        return ""
    ti = event.tool_input
    return "\u0000".join(str(ti.get(key) or "") for key in
                         ("subagent_type", "description", "prompt"))


def _within_dir(target, root) -> bool:
    """Is `target` at or under `root`, whether or not either exists yet?"""
    try:
        return target.resolve() == root.resolve() or root.resolve() in target.resolve().parents
    except (OSError, ValueError):
        return False


def _sibling_of_repo(ctx, target) -> bool:
    """A tree this plugin would provision: `<repo>-<slug>`, alongside the repository.

    The NAME as well as the parent. Matching the parent alone vouched for every unrelated
    directory that happened to sit next to the checkout, which is exactly the "we know
    nothing about it, leave it to the founder" case the silence here is for — caught by
    the test that says so.
    """
    try:
        root = ctx.worktree_root.resolve()
        resolved = target.resolve()
    except (OSError, ValueError):
        return False
    return resolved.parent == root.parent and resolved.name.startswith(f"{root.name}-")


def _holds_a_card(ctx, session_id: str, touched: list[str] | None = None) -> bool:
    """Is a task on the board claimed by this session, for `touched` when paths are known?

    Split out because the answer is now wanted about a call that names no path at all —
    `_ledger_covers` reads `touched`, and `all()` over an empty list is True, so asking it
    about a `git merge` would have answered yes for every session on the machine.

    By any id this session has had (`plan.held_by`, `plan.closed_by`): it claims in the
    main checkout and then works in its own tree, where it is a second identity with the
    same card.
    """
    from claude_bestpractice import plan

    if plan.held_by(ctx, session_id):
        return True
    # A card this session CLOSED counts. Closing is what the ledger asks for, and a gate
    # that then says "nothing on the board says this session is working" punishes the
    # session for doing it — the only way to stay quiet was to leave the card open until
    # the session ended (#220).
    #
    # For the files it named and nothing else. Counted for any path, one closed card was a
    # licence to write anything for the rest of the session without claiming another: the
    # next card the founder filed was advertised as ready to start while this session was
    # already writing it, which is the collision the board exists to prevent.
    closed = plan.closed_by(ctx, session_id)
    return bool(touched) and all(
        any(plan.carried_by(card, [rel]) for card in closed) for rel in touched
    )


def _ledger_covers(ctx, session_id: str, touched: list[str]) -> bool:
    """Is a task on the board claimed by this session? The ledger's own files always are.

    Exempt paths too: a turn that only touches `.claude/` needs no card for the same
    reason it needs no test run — the gate's own bookkeeping is not the founder's work.
    """
    if all(_bookkeeping(rel) for rel in touched):
        return True
    return _holds_a_card(ctx, session_id, touched)


def _bookkeeping(rel: str) -> bool:
    """Is this path, relative to the tree it is in, the gate's own rather than the work?"""
    return rel.startswith(store.TIER_A_DIRNAME) or rel.startswith(".claude/")


def _landed(ctx, absolute: list[Path]) -> list[tuple[Path, str]]:
    """Each write inside this checkout: the tree it lands in, and its path inside that tree.

    Relative to the tree a write LANDS in, never to the one the hook runs from. From the
    main checkout, a write into the tree this plugin provisioned is `.claude/worktrees/<t>/
    src/app.py` — under `.claude/`, which exempts the gate's own bookkeeping — so every
    write into the tree needed no card at all, while the very same write with the hook
    standing in the tree was refused for want of one.
    """
    root = ctx.worktree_root.resolve()
    home = worktree.HOME.parts
    inside = len(home) + 1
    out: list[tuple[Path, str]] = []
    for path in absolute:
        try:
            parts = path.relative_to(root).parts
        except ValueError:
            continue
        if parts[:len(home)] == home and len(parts) > inside:
            out.append((root.joinpath(*parts[:inside]), "/".join(parts[inside:])))
        else:
            out.append((root, "/".join(parts)))
    return out


def _unlisted(ctx, session_id: str, absolute: list[Path]) -> str:
    """The first of these writes no card on the board covers, as a card would name it.

    A path git ignores is owed no card. The board is how a sibling decides what is safe to
    touch, and no commit will ever carry an ignored file to a sibling — so `pytest -q 2>&1
    | tee test-output.log`, with `*.log` ignored, was refused for want of a card on a log.
    Asked last and only of what is left: it costs git a call, the rest cost nothing.
    """
    landed = _landed(ctx, absolute)
    if _ledger_covers(ctx, session_id, [rel for _tree, rel in landed]):
        return ""
    owed = [rel for tree, rel in landed
            if not _bookkeeping(rel) and not gitpolicy.git_ignores(tree, rel)]
    return owed[0] if owed else ""


# What a session is to do with a block from this plugin, said at the block itself
# because that is the only place it is certainly read. The failure this closes was
# watched repeatedly: a gate refuses, the session stops and tells the founder a plugin
# is in its way, and the founder — who installed this so they would not have to read
# any of it — is handed a question about a hook instead of the work they asked for.
#
# Both branches are real and the session is the one that can tell them apart. It has the
# refusal, the call it was making and the repository in front of it; the founder has a
# sentence in a chat window. So it decides, and it keeps working either way.
REFUSAL_IS_YOURS = (
    "\n--\n"
    "  A GATE refused this, not the founder. Work out which it is before anything else: "
    "if the gate is right, do what it names and carry on; if it is wrong, "
    '`claude-bp-report defect "<what it refused and why that is wrong>"` files it '
    "without costing this turn, and the work still goes on by another route.\n"
    "  Do not stop to ask the founder what to do about a block."
)


def deny(ctx, rec, reason: str) -> None:
    """Refuse this call, and record that the refusal is now owed an answer.

    Every refusal this file makes about something the SESSION can fix goes through here
    rather than through `hookio.deny_tool`, so the standing instruction is attached in
    one place and the Stop gate can tell a turn that resolved a block from a turn that
    ended on one.
    """
    sessions.touch(ctx, rec.session_id, refusal={
        "at": time.time(),
        # What the session had done when it was refused. The Stop gate compares it
        # against the count then: equal means nothing was tried afterwards.
        "calls": rec.tool_calls,
        # The first line only. The whole reason is already in front of the model; this
        # is so the Stop gate can name what it is asking about.
        "said": reason.strip().splitlines()[0][:160],
    })
    hookio.deny_tool(reason + REFUSAL_IS_YOURS)


def deny_for_founder(ctx, rec, reason: str) -> None:
    """Refuse a call that genuinely waits on a person, and say nothing about resolving it.

    An unapproved merge, a production deploy, a switch that is the founder's to set
    (decision 0006). A session told to stop and report IS doing as it was told, so these
    carry no standing instruction and leave no refusal for the Stop gate to ask about —
    the one case where "tell the founder and stop" is the finish.

    `ctx` and `rec` are taken and unused on purpose: every refusal in this file reads the
    same at the call site, and the difference between the two kinds is the NAME rather
    than an argument list a reader has to compare.
    """
    del ctx, rec
    hookio.deny_tool(reason)


def proposed_content(event: hookio.HookEvent) -> str:
    ti = event.tool_input
    parts = [str(ti.get(k, "")) for k in ("content", "new_string", "new_str", "command")]
    edits = ti.get("edits")
    if isinstance(edits, list):
        parts.extend(str(e.get("new_string", "")) for e in edits if isinstance(e, dict))
    return "\n".join(p for p in parts if p)


# `> f`, `>> f`, `tee f`, `sed -i … f`, `cat … > f`. Deliberately generous: a path this
# misses costs a missed lease, and a path it invents costs one spurious claim on a file
# nobody else wanted.
_QUOTED = re.compile(r"""'[^']*'|"[^"]*\"""", re.S)

# A `>` that is half of an OPERATOR is not a redirect, and reading it as one invented a
# write target out of a query. `select … where data @> '{"k":1}'` sent to psql was read as
# a redirect and the board gate refused the call for "working on @" — a path nobody named,
# in a command that writes no file at all (#205). Every language this founder ships has
# one: `@>` and `<@` in SQL, `->` and `->>` in jsonb and C, `=>` in JS, `<>` in SQL, `|>`
# in pipelines, `%>%` in R.
#
# `&>` is deliberately NOT in the exclusion: it is a real bash redirect of both streams.
# The cost, stated: `--flag>out.txt` and `path/>out.txt` stop being read as writes. Both
# are forms nobody writes, against a false target that blocked a real command.
BASH_WRITE_TARGETS = re.compile(
    r"(?:(?<![@<>=!~^|+:*%/-])>>?\s*|\btee\s+(?:-a\s+)?)(?P<path>[\"']?[\w./@+~-]+[\"']?)"
)

# `sed -i` writes its LAST argument; everything before it is the script, which looks
# path-shaped enough (`s/x/y/`) to fool a single pattern.
#
# Only for a line the tokeniser declines. Otherwise `-i` is read from sed's own arguments:
# `" -i" in segment` fired on any `-i` in a pipeline that ran sed anywhere, so
# `sed -n '1,20p' f | grep -in split` was a write — refused in the main checkout, where it
# provisioned a worktree for every session that ran it, and a lease on a file it only read.
SED_IN_PLACE = re.compile(r"\bsed\s+(?:-\S+\s+|'[^']*'\s+|\"[^\"]*\"\s+)*(?P<path>[\w./@+-]+)")

# What stands in front of a program without changing what it does: sed's files are still
# sed's under `sudo`, and `uv run python -c …` is still Python running inline code.
_LAUNCHERS = {"sudo", "doas", "xargs", "uv", "poetry", "pipenv", "pdm", "hatch", "rye",
              "npx", "pnpx", "bunx"}

# A verb writes only when it is the command being RUN, and `\b` matched it as an ARGUMENT
# too. `install` is a subcommand of nearly every package manager there is, so `pip install
# pdfminer.six` was read as `install`'s destination, resolved to `<cwd>/pdfminer.six`, and
# refused by the main-checkout rule as a write INTO the repository — for a package name
# that is not a path at all. Every `pip`, `npm`, `cargo`, `go`, `apt` and `brew` install
# run from the main checkout was blocked that way, and `docker rm <container>` with it.
# Reported as #203 by a session that gave up on a local PDF extractor and read seventy-two
# pages into the model context instead.
#
# The wrappers are let through because the verb after them still names files: `git rm
# secrets.env`, `sudo rm -rf /etc/x` and `xargs -0 rm` all write, and dropping them would
# take the leases and the protected-state refusal with them. Segments arrive already split
# on `&&`, `||`, `;` and newline, so what is left to recognise here is the start of one and
# the separators that survive inside it.
_RUNS = (
    r"(?:^|[|(`{&])\s*"
    r"(?:\w+=\S*\s+)*"
    r"(?:(?:sudo|env|command|nohup|time|timeout|xargs|git)\s+(?:-\S+\s+|\d+\s+|\w+=\S*\s+)*)*"
)

# DESTRUCTION is not a redirect, and the write scanner only ever looked for redirects.
# So every rule keyed on "which paths does this command write" — the credential scan, the
# leases, and the protected-state refusal — was bypassable with `rm`. Deleting the record
# of a failing suite is not a write to it, and one `rm` ended an argument the rest of this
# gate spends hundreds of lines having.
#
# Every path-shaped argument of these verbs counts, because `rm -rf a b c` names three.
BASH_REMOVES = re.compile(
    _RUNS + r"(?:rm|unlink|shred|truncate)\b(?P<args>(?:\s+(?:-\S+|[\w./@+~-]+))+)"
)

# `cp`, `mv`, `install` and `ln` write their LAST argument and READ the rest. Taking every
# path-shaped argument meant a source was judged as a write: `cp <main>/.env .env` from a
# worktree was refused for touching the main checkout, when the main checkout is where the
# bytes came FROM and the destination was inside our own tree. Reading a sibling checkout —
# an `.env`, a shared key, a diff — is routine. Reported as issue #42.
BASH_COPIES = re.compile(
    _RUNS + r"(?:mv|cp|install|ln)\b(?P<args>(?:\s+(?:-\S+|[\w./@+~-]+))+)"
)

# A heredoc body is DATA. `select … where n_live_tup > 0` inside one looks exactly like a
# redirect to a file named `0`, and the guard duly refused a write to `<cwd>/0` — a path
# that does not exist and was never named, so the message gave no way to find the real
# problem. Blanked like quoted spans, and for the same reason.
_HEREDOC = re.compile(r"<<-?\s*(['\"]?)(?P<tag>\w+)\1.*?^\s*(?P=tag)\s*$", re.S | re.M)
_ARG = re.compile(r"[\w./@+~-]+")


def _blanked(command: str) -> str:
    """The command with heredoc bodies and quoted spans turned to spaces, its length kept."""
    for pattern in (_HEREDOC, _QUOTED):
        command = pattern.sub(lambda m: " " * len(m.group(0)), command)
    return command


# `cd x && …` moves what a relative redirect means, and nothing here was reading it. A
# command that wrote `/tmp/t9/a.py` was resolved against the repository root instead and
# refused as a write to `<repo>/a.py` — a file it never touched. Reported from a real
# machine, alongside the opposite error: an absolute path outside the repository raised
# ValueError and was dropped entirely, so the same write went through unexamined.
# A leading `(` is part of the segment, because `_SEGMENTS` splits on operators and not on
# brackets. Without it `(cd /tmp/scratch && rm -rf work)` had its `cd` unread and `work`
# resolved against the repository root — refused as a write into the main checkout, for a
# directory in /tmp. Which is the shape this gate RECOMMENDS: `strands_the_shell` answers
# with "`(cd … && ...)` leaves this shell where it is", so taking the advice was what
# triggered the refusal (#203). A subshell's `cd` moves the commands inside it; it is only
# the PARENT shell's final directory that it leaves alone, and that is asked elsewhere.
#
# The directory is read from the words the shell will see, never from the copy with quoted
# spans blanked: that copy has no directory left in `cd "/tmp/dir with space"`, so the `cd`
# went unread and `cd "/tmp/dir with space" && echo hi > out.txt` from the main checkout was
# refused as a write into the checkout it had just left. This only says a segment MAY be one.
_CD = re.compile(r"^[\s({]*cd\b")
_SEGMENTS = re.compile(r"&&|\|\||;|\n")

# A subshell's brackets, at the edges of a segment. `_SEGMENTS` cuts on `&&` and `;` and
# never on brackets, so `(cd x && git pull)` arrives as `(cd x ` and ` git pull)` — and a
# bracket is the one piece of shell `shellcmd` declines outright. Trimmed at the edges only:
# one anywhere else still makes it decline, which every caller here falls back from.
_EDGE_BRACKETS = re.compile(r"^[\s({]+|[\s)}]+$")

# Git destroys a working tree without ever naming a file in it, so every rule here keyed
# on "which paths does this write" saw nothing at all. `git -C ../main reset --hard HEAD~1`
# discards a sibling session's uncommitted work; `clean -fd` deletes it outright; `checkout`
# and `switch` move a HEAD that session is standing on. Reported as the incident that made
# worktree-first a rule in the first place.
#
# These are the subcommands that touch a working tree or the HEAD it follows. `status`,
# `log`, `diff`, `add`, `commit` and `fetch` are deliberately absent: they either only read,
# or they only move things the index and the object store already own.
GIT_TREE_VERBS = {
    "reset", "checkout", "switch", "restore", "clean", "stash", "rm", "mv",
    "apply", "am", "revert", "merge", "rebase", "cherry-pick", "pull", "worktree",
}
_GIT_C = re.compile(r"(?:^|\s)-C\s+(?P<path>[\"']?[\w./@+~-]+[\"']?)")
_GIT_WORK_TREE = re.compile(r"--work-tree(?:=|\s+)(?P<path>[\"']?[\w./@+~-]+[\"']?)")
_GIT_VERB = re.compile(r"\bgit\b(?P<rest>.*)", re.S)
_WORKTREE_REMOVE = re.compile(r"\bworktree\s+remove\b(?P<args>(?:\s+(?:-\S+|[\w./@+-]+))*)")

# `git worktree list` is `git status` for worktrees: it reads and returns. `worktree` was
# in the verb set whole, so asking WHERE the other sessions are, from anywhere but your own
# tree, came back refused as a command that discards uncommitted work — naming reset, clean
# and stash, none of which it was. The cheapest way to find out what else is running was
# the one thing you could not do, in the product whose premise is that several things are.
# `prune` joins it: it deletes no working tree, it forgets the RECORDS of trees that are
# already gone — which is the last step of the same tidying-up `remove` starts, and it was
# refused as a command that discards uncommitted work (#218).
_WORKTREE_READ = re.compile(r"\bworktree\s+(?:list|prune)\b")

# The same for the other verbs, read off each command's own arguments wherever the line can
# be read that way: `stash list` and `stash show` print, `clean -n` lists what it would
# delete, and `apply --check` and its siblings report. `git -C <main> stash list` came back
# as a command that discards uncommitted work, and so did every other way to look.
_READ_SPELLINGS = {"stash": {"list", "show"}, "worktree": {"list", "prune"}}
_APPLY_REPORTS = {"--check", "--stat", "--numstat", "--summary"}

# The session asking for the tree to go whatever is in it. Read rather than decided:
# nothing in this plugin adds `--force` on its own.
_WORKTREE_FORCE = re.compile(r"\bworktree\s+remove\b[^&|;\n]*\s(?:--force|-f)\b")

# An interpreter is not statically analysable in general and this does not pretend to be.
# It matches the literal one-liner form only — the shape actually used to reach around a
# path rule — and misses anything computed, which is stated rather than implied.
_INTERPRETER_WRITE = re.compile(
    r"""writeFileSync\s*\(\s*['"](?P<a>[^'"]+)['"]"""
    r"""|(?:^|\W)open\s*\(\s*['"](?P<b>[^'"]+)['"]\s*,\s*['"][wax]""",
    re.M,
)

# ...and only where an interpreter RUNS the code: handed it with `-c` or `-e`, told `-` to
# read it, or given no script at all so a heredoc or a pipe feeds it. Scanned in every
# segment, `open('x', 'w')` anywhere in a command was a write whatever program ran — so
# `grep -rn "open('config.json', 'w')" src/` was one, and a pull request body describing
# the change, and a heredoc writing a script to /tmp. Reading taken for doing: #76, one
# rule over, and each provisioned a worktree when run from the main checkout.
_INTERPRETER = re.compile(r"^(?:python[\d.]*|pypy[\d.]*|node|nodejs|deno|bun|ruby|perl|php|"
                          r"sh|bash|zsh)$")
_INLINE_CODE = {"-c", "-e", "-E", "-p", "-r", "--eval", "--print", "-", "eval"}


def _segments_with_cwd(scannable: str, cwd: Path, literal: str = ""):
    """Each shell segment paired with the directory it would actually run in.

    Both copies of the segment come back: the blanked one, which is the only copy a path
    scan can be trusted on, and the raw one, which is the only copy where an interpreter's
    quoted path survives at all. Blanking preserves LENGTH, so one set of offsets cuts
    both, and the raw half is no longer scanned whole against a cwd the `cd`s have moved.
    The offset comes back too, for a caller cutting the same span out of a third copy.
    """
    here = cwd
    raw = literal or scannable
    edges = [0]
    for match in _SEGMENTS.finditer(scannable):
        edges += [match.start(), match.end()]
    edges.append(len(scannable))
    for start, end in zip(edges[0::2], edges[1::2]):
        segment = scannable[start:end]
        moved = _moves_to(raw[start:end])
        if moved is not None:
            # Tracked, never executed. `cd` into a path that does not exist still changes
            # what the rest of the line means to this scanner, and guessing wrong here
            # only costs a target that lands outside every tree, which is ignored anyway.
            # Through `_resolve`, because `here / "~/x"` is `<here>/~/x` and `.expanduser()`
            # does not touch it — the #37 rewrite of a home path into a repository one,
            # still live in this half of the file long after the other half was fixed.
            moved_to = _resolve(here, moved)
            here = moved_to if moved_to is not None else here
            continue
        yield segment, raw[start:end], here, start


@functools.lru_cache(maxsize=256)
def _commands_in(segment: str) -> list[list[str]]:
    """What one segment runs, split the way the shell splits it; empty where it cannot be.

    A heredoc body is blanked first, for the reason it is everywhere in this file: it is
    data handed to the command, not words of the command.

    Cached for the one call this process judges, because several rules ask about the same
    segment and a long quoted argument costs the tokeniser more than linear time. The lists
    are therefore shared: read them, never change them.
    """
    body = _HEREDOC.sub(lambda m: " " * len(m.group(0)), segment)
    return shellcmd.commands(_EDGE_BRACKETS.sub("", body))


def _moves_to(segment: str) -> str | None:
    """The directory a segment that is nothing but a `cd` names, or None for any other."""
    if not _CD.match(segment):
        return None
    commands = _commands_in(segment)
    if len(commands) != 1 or commands[0][0] != "cd":
        return None
    named = [word for word in commands[0][1:] if not word.startswith("-")]
    # One directory, and a literal one. `cd` alone and `cd -` go where only the shell
    # knows, and `$DIR` is whatever it expands to: none of them is a place to resolve.
    if len(named) != 1 or "$" in named[0] or "`" in named[0]:
        return None
    return named[0]


def _resolve(base: Path, raw: str) -> Path | None:
    """Where a path argument actually points, expanding `~` BEFORE joining.

    `base / "~/x"` is `<base>/~/x`, and `.expanduser()` only expands a path that STARTS
    with `~` — so a home-relative path was rewritten into one inside the repository and
    then refused by the main-checkout rule, for a file the command never went near.
    Reported as issue #37: deleting stray files under `~/.claude/projects/` came back as
    "this is the main checkout, not a worktree".

    None, too, for a path no filesystem call can take: a NUL byte raises ValueError rather
    than OSError, and a Write naming one crashed this gate — which fails closed — instead
    of reaching the tool that refuses the path itself. A lone surrogate raised the same
    way, and is judged as the name it becomes on disk: the harness encodes it as U+FFFD.
    """
    try:
        name = raw.strip("\"'").encode("utf-16", "surrogatepass").decode("utf-16", "replace")
        candidate = Path(name).expanduser()
        if not candidate.is_absolute():
            candidate = base / candidate
        return candidate.resolve()
    except (OSError, RuntimeError, ValueError):
        return None


def _removal_targets(rest: str, literal: str, here: Path) -> list[Path]:
    """The trees `git worktree remove` would delete, as this segment names them.

    Read from the words the shell will see wherever the segment can be read that way. In
    `rest` a quoted path is blanked, so `git worktree remove "<a tree under a space>"` named
    no tree at all — and a session removing its own tree was let through to do it from
    inside, the one step decision 0022 exists to take for it (#224).
    """
    commands = _commands_in(literal)
    named = [word for argv in commands for word in _removed_by(argv)] if commands else [
        a for removal in _WORKTREE_REMOVE.finditer(rest)
        for a in _ARG.findall(removal.group("args")) if not a.startswith("-")
    ]
    return [_resolve(here, word) for word in named]


def _removed_by(argv: list[str]) -> list[str]:
    """What one command's `git worktree remove` names, or nothing when it is not one."""
    argv = _launched(argv, "git")
    for at in range(1, len(argv) - 1):
        if argv[at:at + 2] == ["worktree", "remove"]:
            return [word for word in argv[at + 2:] if not word.startswith("-")]
    return []


def worktree_removals(command: str, cwd: Path) -> list[Path]:
    """Every working tree this command would remove, resolved as the shell would resolve it.

    Separate from `git_tree_targets`, which answers "whose tree does this touch" and folds
    a removal in with a `reset --hard`. The question here is narrower and has its own
    answer: a session removing its OWN tree is not doing anything forbidden, it is doing
    something it cannot survive (#224).
    """
    scannable = _QUOTED.sub(lambda m: " " * len(m.group(0)), command)
    out: list[Path] = []
    for segment, literal, here, _start in _segments_with_cwd(scannable, cwd, command):
        found = _GIT_VERB.search(segment)
        if not found:
            continue
        for path in _removal_targets(found.group("rest"), literal, here):
            if path is not None and path not in out:
                out.append(path)
    return out


def git_tree_targets(command: str, cwd: Path) -> list[tuple[Path, bool]]:
    """Working trees a git command would mutate, however it was pointed at them — each with
    whether a fast-forward is all it would do there.

    Three ways to name one, and all three are explicit, which is why this is worth doing
    statically at all: `-C <path>`, `--work-tree <path>`, or the directory the command runs
    in — which `cd` already tracks for redirects.
    """
    scannable = _QUOTED.sub(lambda m: " " * len(m.group(0)), command)
    out: list[tuple[Path, bool]] = []
    for segment, literal, here, _start in _segments_with_cwd(scannable, cwd, command):
        found = _GIT_VERB.search(segment)
        if not found:
            continue
        commands = _commands_in(literal)
        named = _trees_changed(commands, here) if commands else [
            (base, False) for base in _trees_named(found.group("rest"), literal, here)
        ]
        for target in named:
            if target[0] is not None and target not in out:
                out.append(target)
    return out


def _trees_changed(commands: list[list[str]], here: Path) -> list[tuple[Path | None, bool]]:
    """The trees these commands change, read from git's own arguments."""
    out: list[tuple[Path | None, bool]] = []
    for argv in commands:
        launched = _launched(argv, "git")
        pointed, verb, args = gitpolicy.split_git(launched)
        if verb not in GIT_TREE_VERBS or _only_reads(verb, args):
            continue
        # ONLY the tree being removed, when it is a removal. `-C <main checkout>` is where
        # the command RUNS, and running it there mutates nothing there: `git worktree
        # remove` moves no HEAD, touches no index and discards nobody's uncommitted work —
        # it deletes another directory. Counting the `-C` as a target refused a session
        # tidying up its own tree after a merge, in the name of protecting a checkout the
        # command does not go near, and git will not remove a tree from inside it either,
        # so the advice to "run it in your own tree" named the one place it cannot be run
        # (#218).
        bases = _removed_by(launched) or pointed or ["."]
        out += [(_resolve(here, base), _fast_forwards(verb, args)) for base in bases]
    return out


def _trees_named(rest: str, literal: str, here: Path) -> list[Path | None]:
    """The same, off the text, for a line the tokeniser declines: generous, as before."""
    verbs = GIT_TREE_VERBS & set(_ARG.findall(rest))
    # Only when `worktree` is the whole reason this matched: `git worktree list && git
    # reset --hard` is two commands in one segment and the second one still counts.
    if not verbs or (verbs == {"worktree"} and _WORKTREE_READ.search(rest)):
        return []
    # A removal names only the tree being removed, for the reason `_trees_changed` gives.
    removals = _removal_targets(rest, literal, here)
    if removals:
        return removals
    bases = [_resolve(here, m.group("path"))
             for m in list(_GIT_C.finditer(rest)) + list(_GIT_WORK_TREE.finditer(rest))]
    return bases or [_resolve(here, ".")]


def _only_reads(verb: str, args: list[str]) -> bool:
    """Is this tree verb spelled so that it changes nothing?"""
    if verb in _READ_SPELLINGS:
        return bool(args) and args[0] in _READ_SPELLINGS[verb]
    if verb == "clean":
        return any(arg == "--dry-run" or (arg[:1] == "-" and arg[1:2] != "-" and "n" in arg)
                   for arg in args)
    return verb == "apply" and bool(_APPLY_REPORTS.intersection(args)) and "--apply" not in args


def _fast_forwards(verb: str, args: list[str]) -> bool:
    """A `pull` or `merge` told it may only move its branch forward, and nothing else."""
    return verb in ("pull", "merge") and "--ff-only" in args and not any(
        arg in ("-r", "--no-ff", "--squash") or arg.startswith("--rebase") for arg in args
    )


def _launched(argv: list[str], *programs: str) -> list[str]:
    """`argv` from the first of `programs` on, run directly or behind one of `_LAUNCHERS`;
    nothing when it runs none of them."""
    names = [word.rsplit("/", 1)[-1] for word in argv]
    if names[0] in programs:
        return argv
    if names[0] in _LAUNCHERS:
        for index, name in enumerate(names):
            if name in programs:
                return argv[index:]
    return []


def _runs_inline_code(literal: str) -> bool:
    """Does this segment hand an interpreter code written on the line itself?

    A line the tokeniser declines answers yes: the text is all there is, as before.
    """
    commands = _commands_in(literal)
    return not commands or any(_inline(argv) for argv in commands)


def _inline(argv: list[str]) -> bool:
    """Is this one command an interpreter running code it was given here, not a script?"""
    names = [word.rsplit("/", 1)[-1] for word in argv]
    at = next((index for index, name in enumerate(names) if _INTERPRETER.match(name)), None)
    if at is None or (at > 0 and names[0] not in _LAUNCHERS):
        return False
    given = argv[at + 1:]
    return bool(_INLINE_CODE.intersection(given)) or all(word.startswith("-") for word in given)


def _edited_in_place(segment: str, literal: str) -> list[str]:
    """The files a `sed -i` in this segment rewrites, as the segment names them."""
    commands = _commands_in(literal)
    if commands:
        return [path for argv in commands for path in _sed_in_place(argv)]
    # Declined by the tokeniser, so the text is all there is — and generous is the
    # direction this whole scanner errs in.
    if "sed" in segment and " -i" in segment:
        return [m.group("path") for m in SED_IN_PLACE.finditer(segment)]
    return []


def _sed_in_place(argv: list[str]) -> list[str]:
    """The files one `sed` rewrites in place, and nothing when it only reads them.

    GNU and BSD spellings both: `-i`, `-i.bak`, `-i ''`, `--in-place[=.bak]`, and an `i`
    inside a cluster such as `-ni`. The first operand is the script unless `-e` or `-f`
    gave it, and every operand after that is a file sed rewrites.
    """
    argv = _launched(argv, "sed", "gsed")
    if not argv:
        return []
    in_place, scripted, operands = False, False, []
    at = 1
    while at < len(argv):
        word, at = argv[at], at + 1
        if word == "--":
            operands += argv[at:]
            break
        if word == "-" or not word.startswith("-"):
            operands.append(word)
        elif word.startswith("--"):
            in_place = in_place or word.startswith("--in-place")
            scripted = scripted or word.split("=")[0] in ("--expression", "--file")
            at += 1 if word in ("--expression", "--file", "--line-length") else 0
        else:
            for position, flag in enumerate(word[1:], start=2):
                last = position == len(word)
                if flag in "iI":
                    # A backup suffix is glued on, or, in BSD's spelling, its own empty word.
                    in_place = True
                    at += 1 if last and at < len(argv) and argv[at] == "" else 0
                    break
                if flag in "efl":
                    scripted = scripted or flag != "l"
                    at += 1 if last else 0
                    break
    if not in_place:
        return []
    return operands if scripted else operands[1:]


def commit_message_in(command: str, cwd: Path) -> str:
    """The message a `git commit` on this line is given, asked of one segment at a time.

    Whole, a line's newlines are whitespace to the tokeniser: `git status` and a `git commit
    -m wip` on the next line read as one `git status` with five arguments, and the message
    went unjudged from the day it began to be read from the parsed words.
    """
    for _segment, literal, _here, _start in _segments_with_cwd(_blanked(command), cwd, command):
        message = gitpolicy.commit_message(literal)
        if message:
            return message
    return ""


def bash_write_targets(command: str, cwd: Path) -> list[Path]:
    """Absolute paths a shell command appears to write, resolved as the shell would.

    Deliberately generous. A path this misses is a missed lease and a missed scan; a
    path it invents is one spurious claim on a file nobody else wanted.

    Absolute rather than repo-relative because the caller now has to decide WHICH tree a
    write lands in, and a path that has already been forced relative to one root cannot
    answer that.
    """
    return bash_writes(command, cwd)[0]


def bash_writes(command: str, cwd: Path) -> tuple[list[Path], str]:
    """Where a shell command writes, and the part of its text that lands there.

    The text is the command with everything blanked but the segments that write their own
    words into a file — a redirect or `tee`, `sed -i`, an interpreter's inline `open` — and,
    in those, the environment set in front of each command. Length and line breaks are
    kept, so a line a caller reports from it is the command's own line.
    """
    # Blank out quoted spans first. `echo "a > b"` and `grep -q "x>y" f` contain no
    # redirect, but a naive scan read one and claimed a lease on a path that does not
    # exist — which denies a sibling session for a file nobody is editing.
    scannable = _blanked(command)

    out: list[Path] = []
    written = [char if char == "\n" else " " for char in command]

    for segment, literal, here, start in _segments_with_cwd(scannable, cwd, command):
        carried = _writes_its_words(segment, literal, here)
        for path in carried + _writes_by_moving(segment, here):
            if path not in out:
                out.append(path)
        if carried:
            written[start:start + len(literal)] = _without_environment(literal, segment)
    return out, "".join(written)


def _writes_its_words(segment: str, literal: str, here: Path) -> list[Path]:
    """The files this segment writes its own text into."""
    # On the RAW segment, because `_QUOTED` blanks quoted spans and an interpreter's
    # path is always quoted — scanning the blanked copy would find nothing, every time.
    # Per SEGMENT rather than over the whole line, because the whole line carries no
    # `cd`: `cd /tmp/scratch && python3 -c "open('out.txt','w')…"` was resolved against
    # the repository root and refused as a write into the main checkout, for a file in
    # /tmp the command never went near (#203).
    run = _INTERPRETER_WRITE.finditer(literal) if _runs_inline_code(literal) else ()
    coded = [_resolve(here, match.group("a") or match.group("b") or "") for match in run]
    raws = [m.group("path") for m in BASH_WRITE_TARGETS.finditer(segment)]
    raws += _edited_in_place(segment, literal)
    return [path for path in coded + [_named(raw, here) for raw in raws] if path is not None]


def _writes_by_moving(segment: str, here: Path) -> list[Path]:
    """The files this segment removes, or copies and moves others onto."""
    raws: list[str] = []
    # ...and every path a destructive verb names. `rm` is not a redirect, so none of
    # these commands produced a target at all, and every rule keyed on "what does this
    # write" was one `rm` away from irrelevant.
    for match in BASH_REMOVES.finditer(segment):
        raws += [a for a in _ARG.findall(match.group("args")) if not a.startswith("-")]

    # Destination only. The sources are reads, and refusing a read is how a guard
    # stops being about safety and starts being about obedience.
    for match in BASH_COPIES.finditer(segment):
        operands = [a for a in _ARG.findall(match.group("args")) if not a.startswith("-")]
        if operands:
            raws.append(operands[-1])
    return [path for path in (_named(raw, here) for raw in raws) if path is not None]


def _named(raw: str, here: Path) -> Path | None:
    """The file a scanned token names, or None for a token that names no file."""
    token = raw.strip("\"'")
    # `2>&1`, `> 0`, `>1`: file descriptors and comparisons, never filenames.
    if not token or token.startswith("/dev/") or token.isdigit():
        return None
    # A token with no name in it is not a file. The arg pattern accepts `@`, `~`,
    # `+` and `-` so that real names carrying them survive, and on their own they
    # are what is left of an operator some scan read through — the refusal that
    # named `@` as the file this session was working on came out here (#205).
    if not token.strip("@+~-."):
        return None
    return _resolve(here, raw)


# `NAME=value` in front of a command is the environment it runs with, not words it writes
# anywhere: `JWT_SECRET=testsecret npm test 2>&1 | tee test.log` puts npm's output in the
# log, and the assignment was what the credential scan refused it for.
_ENVIRONMENT = re.compile(
    r"""\s*(?:env\s+)?(?:[A-Za-z_]\w*=(?:"[^"]*"|'[^']*'|[^\s"'|;&<>])*\s+)+"""
)


def _without_environment(literal: str, segment: str) -> str:
    """This segment with the assignments in front of each of its commands blanked out."""
    out = list(literal)
    for start in [0] + [match.end() for match in re.finditer(r"\|", segment)]:
        found = _ENVIRONMENT.match(literal, start)
        if found:
            out[found.start():found.end()] = " " * (found.end() - found.start())
    return "".join(out)


def main() -> None:
    event = hookio.read_event()
    ctx = hookio.repo(event.cwd or os.getcwd())
    cfg = config.load(ctx)

    # Off means off, on this call rather than after a restart. The harness reads
    # `enabledPlugins` when a session starts and keeps running the hooks it loaded, so a
    # founder who switched this plugin off mid-session went on being refused by it —
    # worktrees provisioned they never asked for, `Write` and heredocs blocked, and
    # `claude-bp set require_worktree off` refusing them from inside the session that was
    # being blocked (#215). Nothing here can unload a hook; standing down is what it can do.
    #
    # Before every rule in this file, including the protected-state refusal. A gate that
    # keeps enforcing one thing after being switched off is not switched off, and the two
    # doors are the founder's either way: `config.json` is refused to sessions, and the
    # project settings write that flips the other one is refused below while this is still on.
    if not config.enforcing(ctx)[0]:
        # SILENT, not approved. Approving would still be this plugin deciding something —
        # it suppresses the permission prompt the founder would otherwise have seen — and a
        # switched-off gate has no business having an opinion either way.
        hookio.emit_silent()

    rec = sessions.get(ctx, event.session_id)
    if rec is None:
        # No record means SessionStart never ran, or something deleted it. Re-register
        # and keep enforcing. Allowing here — the previous behaviour — made every gate
        # in this file switch off for any session whose record went missing, so the
        # secret scan and the leases could be disabled with `rm`.
        rec = sessions.adopt(ctx, event.session_id)

    # What another session needed this one to know, delivered into this session's own
    # inbox before the call it is about to make. The board is injected once at session
    # start (decision 0003), so without this a running session never learns anything new
    # — and this is the last moment before it acts on what it does not yet know.
    inbox.drain(ctx, event.session_id)

    sig = signature(event)
    history = list(rec.tool_signatures.get("_history", [])) if isinstance(rec.tool_signatures.get("_history"), list) else []
    history.append(sig)
    history = history[-SIGNATURE_HISTORY:]

    # The signature counts, and the Stop gate's own `_` bookkeeping whatever its type. Keeping
    # integers only threw away the block memory — its reason, paths, tree and time — on the
    # first tool call after every block, which is every real session: the ceiling then filed
    # "continuation ceiling reached" with no reason and no files (#31 again), and the streak
    # never reset after an hour's silence because its clock was always gone.
    counts = {k: v for k, v in rec.tool_signatures.items()
              if k != "_history" and (isinstance(v, int) or k.startswith("_"))}
    counts[sig] = counts.get(sig, 0) + 1

    ti = event.tool_input
    target = ""
    shell_targets: list[str] = []

    # Where the write LANDS, absolute, before anything is forced relative to a root it may
    # not belong to. The rules below split on this: our tree, somebody else's tree, or
    # neither — and the third is none of this gate's business.
    session_cwd = Path(event.cwd) if event.cwd else ctx.worktree_root
    absolute: list[Path] = []
    # What a shell command puts INTO those files, for the credential scan below.
    shell_writes = ""

    if event.tool_name in WRITE_TOOLS and ti.get("file_path"):
        raw = str(ti["file_path"])
        resolved_target = _resolve(session_cwd, raw)
        absolute = [resolved_target] if resolved_target else []
        # Repo-relative, or nothing. `target` feeds the lease and the board, and both are
        # about coordinating sessions over THIS repository's files — so a scratch file in
        # /tmp took a lease that then denied a second session the same scratch file, for a
        # path neither of them shares.
        target = ""
        if absolute:
            try:
                target = str(absolute[0].relative_to(ctx.worktree_root.resolve()))
            except ValueError:
                target = ""
    elif event.tool_name == "Bash":
        absolute, shell_writes = bash_writes(str(ti.get("command", "")), session_cwd)
        # Repo-relative is what the leases, the board and the protected-state refusal all
        # speak, so the ones inside our tree are converted and the rest stay out of it.
        for path in absolute:
            try:
                shell_targets.append(str(path.relative_to(ctx.worktree_root.resolve())))
            except ValueError:
                continue
        target = shell_targets[0] if shell_targets else ""

    # What THIS call writes, as opposed to `touched` below, which carries recent history
    # for the board and the lease. Any rule about the write in hand has to read this one:
    # checking `touched` denied every write in the session as soon as one protected path
    # had ever appeared in it, and the message named the wrong file every time.
    writing_now = shell_targets if event.tool_name == "Bash" else ([target] if target else [])

    # HISTORY is recorded now, because a denied attempt is still an attempt and loop
    # detection depends on seeing it. The CEILING's counter is not: a call this plugin
    # refused is not work the session did, and counting it meant every refusal pushed the
    # session closer to a wall it would then hit for having been refused. It is
    # incremented at the end of this file, where the call has actually been allowed.
    # `last_touched` is not recorded here either — a write we refused never happened.
    payload = dict(counts)
    payload["_history"] = history
    sessions.touch(ctx, event.session_id, tool_signatures=payload)
    touched = ([target] + [t for t in rec.last_touched if t != target])[:12] if target else []

    # The escape is exempt. A ceiling that also refuses the one command that raises it is
    # not a ceiling, it is the end of the session — and the message below names that
    # command, so refusing it would be this gate advertising a door it has just locked
    # (the shape of #108, in a place where the founder may not be awake to open it).
    over_ceiling = cfg.max_tool_calls > 0 and rec.tool_calls >= cfg.max_tool_calls
    escaping = event.tool_name == "Bash" and vouch.own_command(str(ti.get("command", "")))
    if over_ceiling and not escaping:
        deny_for_founder(
            ctx, rec,
            f"claude-bestpractice: this session has made {rec.tool_calls} tool calls, past the "
            f"ceiling of {cfg.max_tool_calls}. Calls this gate refused are not counted, so "
            "that is work that actually happened.\n"
            "  A long measuring session legitimately runs into thousands of calls. The "
            "ceiling is the config key `max_tool_calls`, and raising it takes one line from "
            f"the founder — `max_tool_calls {cfg.max_tool_calls * 2}` — and then:\n"
            f"  claude-bp set max_tool_calls {cfg.max_tool_calls * 2}\n"
            "  Otherwise: stop and summarise what is done and what remains."
        )

    # A subagent is the one call whose cost is set by a field nobody has to fill in, and
    # the harness resolves an unset one to the PARENT's model. Asked here rather than at
    # SubagentStart, which is documented as unable to block a spawn and is handed neither
    # the model nor the prompt — by then the choice has been made and paid for.
    if event.tool_name in subagents.SPAWN_TOOLS:
        named = str(ti.get("model") or "")
        if not subagents.names_a_tier(named):
            pinned = subagents.pinned_tier(ctx, str(ti.get("subagent_type") or ""))
            if not subagents.names_a_tier(pinned):
                deny(ctx, rec, subagents.tier_refusal(str(ti.get("subagent_type") or ""), pinned))
        # Counted on the way through, because a PreToolUse hook never sees the result and
        # a spawn that is allowed is a spawn that is running. Refused ones are not
        # counted, for the same reason refused tool calls are not: a call this gate
        # stopped is not work the session did. Checked and counted in ONE locked step:
        # read from `rec` and written back afterwards, six spawns in one message all
        # read 0 and all six went through a ceiling of three.
        spawned = sessions.count(ctx, event.session_id, "spawns_this_turn", cfg.subagent_fanout)
        if cfg.subagent_fanout > 0 and spawned >= cfg.subagent_fanout:
            deny(ctx, rec, subagents.fanout_refusal(spawned, cfg.subagent_fanout))

    # CONSECUTIVE repeats, never a lifetime total. The lifetime count made the fourth
    # `npm test` of a session a permanent refusal — and `npm test` is the command the
    # Stop gate ORDERS the agent to run, so the two gates deadlocked: finish refused for
    # want of a test run, test run refused for having been run before. Doing anything
    # else in between did not clear it, because nothing ever decremented the counter.
    #
    # Running the suite five times while fixing five things is the work, not a loop. A
    # loop is the identical call with nothing in between, which is what this counts now.
    # Alternating cycles — test, edit, test, edit, forever — are a different shape and
    # `detect_loop` below is what sees those.
    streak = 0
    for previous in reversed(history):
        if previous != sig:
            break
        streak += 1
    if streak > cfg.max_repeat_signature:
        deny(
            ctx, rec,
            f"claude-bestpractice: `{sig}` has now been run {streak} times in a row with nothing in "
            "between. Repeating it unchanged is not making progress — change the input, "
            "change the approach, or say plainly that you are stuck.\n"
            "Anything else you do clears this: the count is consecutive, not a lifetime total."
        )

    if cfg.loop_detect:
        loop = evidence.detect_loop(history)
        if loop:
            deny(
                ctx, rec,
                f"claude-bestpractice: detected a repeating cycle: {loop}. Break out of it — try a "
                "different approach or report the blocker."
            )

    # A pull request is an obligation from the moment it is opened, and the merge is the
    # one point where every check this plugin has can still be applied. Both halves of
    # that live here: the obligation is written down, and the merge is judged.
    pr_vouch = ""
    if cfg.manage_pull_requests:
        command = str(ti.get("command", "")) if event.tool_name == "Bash" else ""
        number = pullrequest.merge_target(event.tool_name, command, ti)
        if number is not None:
            # Green is not accepted. The checks say the code works; they say nothing about
            # whether the founder wants what was built, and in a repository that deploys
            # from the trunk a merge is a step towards shipping it. So the merge waits for
            # their word — and once it is given, the assistant opens, checks and merges on
            # its own, which is the arrangement they asked for.
            #
            # Asked of EVERY merge, before anything decides whose pull request it is. It
            # sat inside the branch-matching below, so naming a number — `gh pr merge 7`,
            # and the GitHub tool, which always sends one — went through unasked whenever
            # the number was not this branch's recorded one: a pull request opened with
            # `gh pr create`, one opened on the website, any merge from the main checkout.
            if not config.approved(ctx, config.APPROVE_MERGE):
                deny_for_founder(
                    ctx, rec,
                    "claude-bestpractice: this pull request has not been accepted by the founder "
                    "yet. Passing checks mean the code works, not that the work is "
                    "wanted — and main deploys, so merging is a step towards shipping "
                    "it.\n"
                    "  Show them what changed and ask. When they are happy they say "
                    "`+merge` — copy it exactly — and this allows the merge once.\n"
                    "  Their word is read from their own message; nothing you write "
                    "can stand in for it."
                )
            gated = pullrequest.gated_by(
                ctx, number, pullrequest.about_current_branch(event.tool_name, command)
            )
            if gated is None:
                # Somebody else's pull request: nothing checked here is about it (#135).
                # Still one word, one merge.
                config.clear_switch(ctx, config.APPROVE_MERGE)
            else:
                base = str(gated.get("base") or "") or gitpolicy.default_branch(ctx) or "main"
                # The pull request's own head, not the tree this session is standing in.
                problems = pullrequest.blockers(ctx, base, str(gated.get("branch") or ""))
                if problems:
                    deny_for_founder(ctx, rec, pullrequest.merge_refusal(gated, problems))
                # Spent once the merge goes ahead, and never before its blockers are judged:
                # the refusal above promises the merge "as soon as the list is empty", and
                # spending the word first turned that into asking the founder a second time.
                # Still before the call rather than after it, because a PreToolUse hook
                # never sees the result: a merge that then fails is re-authorised by the
                # founder rather than by its own retry.
                config.clear_switch(ctx, config.APPROVE_MERGE)
                # Judged, and nothing found. Carried to the vouch at the end of this file
                # rather than allowed here, because `allow_tool` ends the permission
                # pipeline and every gate below this line still has its say.
                if pullrequest.about_this_repository(ctx, event.tool_name, ti, command):
                    pr_vouch = vouch.MERGE
                # Recorded on the way through: a PreToolUse hook never sees the result,
                # and an obligation the founder has already watched be merged is worse
                # than useless on the board.
                #
                # `ctx.branch` is right here and not an oversight: `gated_by` resolves the
                # obligation by the CURRENT branch, so a merge that reaches this line is
                # always this branch's. A merge of somebody else's is not gated at all and
                # never arrives (#135) — which is what makes settling here safe.
                pullrequest.settle(ctx, ctx.branch, pullrequest.MERGED)
                # And the cards that claimed this work are closed by the delivery of it,
                # here, without anybody being asked. The founder's account of the failure
                # is the specification: having given the word to merge, they were then
                # asked a second question about closing the cards, or the session waited
                # for a command, or it simply forgot and the row sat in `doing` for days.
                # Decision 0010 already settles who decides — `+merge` is their word on the
                # work and the session does the rest without asking again — and the card
                # that claimed that work is part of the rest.
                #
                # Recorded on the way through for the same reason the obligation above is:
                # a PreToolUse hook never sees the result. A merge that then failed leaves
                # a card closed early, and the cost of that is one `claude-bp-plan add`
                # against a board that was wrong about everything it ever delivered.
                if cfg.require_task:
                    from claude_bestpractice import plan

                    head = str(gated.get("branch") or "") or ctx.branch
                    plan.settle_delivered(
                        ctx, event.session_id,
                        pullrequest.delivered_paths(ctx, base, head),
                        f"the merge of {head}",
                    )
                # Every other session's baseline just went stale. They measure their diff
                # from a commit that is no longer where the branch begins, so drift and
                # scope both read wrong until they take the merge in.
                inbox.broadcast(
                    ctx, event.session_id,
                    f"{ctx.branch} was merged. Your baseline is behind — take the base "
                    "branch in before you finish, or your diff is measured from the "
                    "wrong commit.",
                )
        elif pullrequest.opens_a_pull_request(event.tool_name, command):
            # No number: a PreToolUse hook sees the request, never the response, and the
            # number only exists in the response. The branch identifies the obligation,
            # which is the identity every check here is keyed by anyway.
            base = gitpolicy.default_branch(ctx) or "main"
            # The branch the pull request is opened FROM, which is not the session's own
            # when the session coordinates from the main checkout (#79).
            head = pullrequest.head_of(event.tool_name, command, ti, session_cwd) or ctx.branch
            pullrequest.opened(ctx, head, base, event.session_id)
            if pullrequest.about_this_repository(ctx, event.tool_name, ti, command):
                pr_vouch = vouch.PULL_REQUEST
        else:
            # Closed without merging: the other way an obligation ends, and the one nothing
            # wrote down — a closed pull request stayed on every board as "ready to merge"
            # for thirty days. Recorded on the way through, as a merge is.
            closed = pullrequest.closes(ctx, event.tool_name, command, ti, session_cwd)
            if closed:
                pullrequest.settle(ctx, closed, pullrequest.CLOSED)

    # Entering a worktree is the move this gate ORDERS. Making the founder authorise it
    # through a permission prompt is the plugin interrupting them with its own
    # instruction, which is the thing the whole design exists to remove.
    #
    # Approved only for a working tree of THIS repository — anywhere else this stays
    # silent and the normal permission flow decides, because vouching for a directory
    # this plugin knows nothing about is not the gate's to do.
    if event.tool_name == "EnterWorktree" and cfg.require_worktree:
        target = _resolve(session_cwd, str(ti.get("path") or "")) if ti.get("path") else None
        # Any working tree of this repository, asked directly. This used to lean on
        # `foreign_tree` returning non-None to mean "a tree of ours", which stopped being
        # true once that function learned to stay silent about trees nobody is standing in
        # (#67) — and the tree it had just handed over is exactly such a tree, so the
        # pre-approval fell through and the founder was asked again.
        # Including a tree that does not exist YET. Claude Code creates its own worktrees
        # under `.claude/worktrees`, so requiring the path to be an existing working tree
        # left the creating call unapproved — and the founder was asked to authorise the
        # move this gate had just ordered, which is the interruption it exists to remove.
        made_here = ctx.worktree_root / ".claude" / "worktrees"
        if target is None or gitpolicy.owned_by_session(ctx, target) or \
                target.resolve() in set(gitpolicy.working_trees(ctx)) or \
                _within_dir(target, made_here) or _sibling_of_repo(ctx, target):
            hookio.allow_tool(
                "claude-bestpractice: this gate requires a worktree, so entering one needs no "
                "further permission. Asking the founder to authorise the move it just "
                "ordered is the interruption this plugin exists to remove."
            )

    resolved_stage, _ = stage.current(ctx, cfg.stage_override)
    gates = stage.gates_for(resolved_stage)

    if event.tool_name == "Bash" and cfg.commit_conventions:
        message = commit_message_in(str(ti.get("command", "")), session_cwd)
        if message:
            complaint = gitpolicy.message_complaint(
                message, conventional=gitpolicy.uses_conventional_commits(ctx)
            )
            if complaint:
                deny(
                    ctx, rec,
                    f"claude-bestpractice: {complaint}\n"
                    "The reader is not a reviewer — there is none. It is the next session, "
                    "running `git log` on this file to work out why it looks the way it does.\n"
                    + config.switch_advice("commit_conventions", False)
                )

    # A shared checkout turns `git add -A` into one session committing another's
    # half-finished work. Only ever raised over paths the coordination layer can NAME as
    # somebody else's, so the ordinary `git add -A` in a tree of one session's own — which
    # is what this plugin sends every session into — never meets it (#220).
    if event.tool_name == "Bash" and gitpolicy.stages_everything(str(ti.get("command", ""))):
        # Asked of the tree the COMMAND will run in, which is the tree this plugin sent the
        # session into — the harness's working directory once the session stands in it, and
        # not while it works there from the shared checkout. Judged in the checkout, a
        # session staging its own clean tree would be refused over fifty files it cannot see.
        foreign, mine = gitpolicy.whose_work_is_in_the_way(
            worktree.working_context(ctx, event.session_id), rec.session_id)
        if foreign:
            shown = ", ".join(foreign[:4]) + (f" (+{len(foreign) - 4} more)" if len(foreign) > 4 else "")
            yours = " ".join(shlex.quote(path) for path in mine[:8]) if mine else ""
            deny(ctx, rec, (
                f"claude-bestpractice: this stages the whole tree, and {len(foreign)} path(s) in "
                f"it are not this session's: {shown}. In a checkout several sessions share, that "
                "is how one commit carries somebody else's unfinished work — it happened in this "
                "repository and was caught by hand, one `reset --soft` from being merged.\n"
                + (f"  git add -- {yours}\n" if yours
                   else "  git status --short   # then `git add --` the paths that are yours\n")
                + "Name your paths and this gate stays out of the way; a path in that list that "
                "IS yours is one you may add explicitly."
            ))

    if event.tool_name in WRITE_TOOLS or event.tool_name == "Bash":
        conflicted = gitpolicy.conflict_complaint(proposed_content(event))
        if conflicted:
            deny(ctx, rec, f"claude-bestpractice: {conflicted}")

    if gates["migration_gate"]:
        if event.tool_name == "Bash":
            # Per COMMAND, and per the program it runs. `--prod` inside `echo "deploy with
            # --prod"` is text about a deploy, and refusing it is the defect #76 reported one
            # gate over; so is the same flag handed to an installer, a search or a commit.
            # And spent only on a real promotion, since the founder's word allows one.
            deploying = promotes_to_production(str(ti.get("command", "")), session_cwd)
            if deploying and not config.approved(ctx, config.APPROVE_RELEASE):
                # The literal used to be a token IN THE COMMAND, which the session writes
                # — so the gate on the one irreversible action was openable by the party
                # it gates. Decision 0006 closed exactly that hole for config switches and
                # this was left behind. The founder's own word now, consumed on use, so it
                # can never become a standing grant.
                deny_for_founder(
                    ctx, rec,
                    "claude-bestpractice: promoting to production is the one action that cannot be "
                    "undone by re-running it, and it has not been approved.\n"
                    "  Deploy to a preview environment instead, or show the founder what "
                    "would ship and wait. When they are ready they say `+release` — copied "
                    "exactly — and "
                    "that allows exactly one promotion.\n"
                    "  Rollback stays automatic; promotion does not."
                )
            if deploying:
                config.clear_switch(ctx, config.APPROVE_RELEASE)
        if event.tool_name in WRITE_TOOLS or event.tool_name == "Bash":
            # Bash reaches migrations the same way it reaches everything else. Denying
            # `DROP TABLE` through Write while allowing the identical bytes through
            # `cat > migrations/x.sql <<EOF` is a gate the agent routes around by
            # accident on its first heredoc.
            rel = touched[0] if touched else ""
            if rel and any(rel.startswith(d) for d in MIGRATION_DIRS):
                body = proposed_content(event)
                if DESTRUCTIVE_DDL.search(body):
                    # The literal used to live IN THE MIGRATION, which the session writes,
                    # so the gate on irreversible data loss was openable by the party it
                    # gates — the same hole decision 0006 closed for config switches and
                    # v1.28.0 closed for merges and promotions. This was the last one.
                    if not config.approved(ctx, config.APPROVE_MIGRATION):
                        deny_for_founder(
                            ctx, rec,
                            "claude-bestpractice: destructive DDL in a migration. This is irreversible "
                            "and data-shaped — the tests pass either way and corruption surfaces "
                            "only under production concurrency.\n"
                            "  Use an expand-contract migration, or show the founder the "
                            "statement and what it drops. When they accept the loss they say "
                            "`+migration` — copied exactly — and that allows exactly one.\n"
                            "  Their word is read from their own message; a token you write "
                            "into the migration is not their word."
                        )
                    # Spent here rather than after the call: a PreToolUse hook never sees
                    # the result, and a write that failed is re-authorised by the founder
                    # rather than by its own retry.
                    config.clear_switch(ctx, config.APPROVE_MIGRATION)

    # Before any write is examined: may this session write HERE at all? Writes only, so
    # reads, searches and `git worktree add` itself stay free — a rule that blocks the
    # command which satisfies it is a trap the agent learns to route around.
    #
    # Judged by the TARGET, not by where the session happens to sit. Asking the latter got
    # it wrong in both directions on a real machine: a Write to `/tmp` was refused because
    # the session was in the main checkout, while a session in a worktree could write into
    # the main checkout and into a sibling session's tree and nothing objected — which is
    # precisely the silent overwrite the refusal text warns about.
    # `absolute`, not `touched`: `touched` holds only paths inside OUR tree, so a shell
    # command writing into another working tree emptied it and this whole block was
    # skipped — the one case that most needed to reach it.
    writing = event.tool_name in WRITE_TOOLS or (event.tool_name == "Bash" and absolute)
    if writing and cfg.require_worktree:
        for path in absolute:
            owner = gitpolicy.foreign_tree(ctx, path, event.session_id)
            # Ours if this plugin made it for this session. Without this the gate was a
            # closed loop: it refused the main checkout, handed over a worktree in the
            # same breath, and then refused every write into that worktree as "another
            # session's" — a tree it had created for this very session seconds earlier.
            # Reported from a real machine, with the session left nowhere it could write.
            # `provisioned_for` already guarded the git verbs for exactly this reason
            # (issue #37); the write path, which is what the founder actually hits, was
            # never given the same exemption.
            if owner is not None and not gitpolicy.provisioned_for(ctx, event.session_id, owner):
                deny(ctx, rec, gitpolicy.foreign_refusal(path, owner, ctx))

    # The other step this session does not survive: removing the tree it is standing in.
    # git obliges — the directory goes, and the shell is left with no working directory at
    # all — and from there Claude Code refuses every git call as "isolated in the worktree
    # <gone>", so the rest of the cleanup cannot be done by the session that owes it: the
    # branch, the database this plugin gave the tree, and the merged branches beside it all
    # stay (#224).
    #
    # Refusing it would be a gate standing between a session and the tidying-up this plugin
    # asks for (decision 0017), so it is not refused: it is DONE, here, from the main
    # checkout, where nothing is standing in the tree and nothing is left to run afterwards.
    # What comes back to the session is the same outcome it asked for, plus the cleanup it
    # could not have reached.
    if event.tool_name == "Bash":
        own = worktree.mine(ctx, rec.session_id)
        removals = worktree_removals(str(ti.get("command", "")), session_cwd) if own else []
        if own and any(path == own.resolve() for path in removals if path is not None):
            released = None
            # Before the removal, never after: when the session stands in the tree it is
            # removing, that tree IS `ctx`, and every git call takes it as a working
            # directory — asked afterwards, the success message itself raised
            # FileNotFoundError, and this gate fails closed. The Stop gate learned the same.
            where = shlex.quote(str(worktree.main_checkout(ctx)))
            kept: list[str] = []
            try:
                # `--force` only where the session typed it: it is the session's own act
                # being carried out somewhere it survives, not a judgement this gate makes
                # about whose work may be discarded.
                forced = bool(_WORKTREE_FORCE.search(str(ti.get("command", ""))))
                released = worktree.release_now(ctx, rec.session_id, force=forced, kept=kept)
            except Exception:  # noqa: BLE001 - a refusal is better than a crashing gate
                released = None
            if released is not None:
                path, branch, also = released
                carried = f"\n  With it: {'; '.join(also)}." if also else ""
                # What git did with the branch, not what was asked of it: "and so is <it>"
                # was said over a branch `git branch` still listed with its commits on it.
                what = (
                    f"{path} is removed. {branch} is kept: its commits are not in the trunk, "
                    f"and `git -C {where} log --oneline -5 {shlex.quote(branch)}` shows them — tell the "
                    "founder before deleting it." if kept else
                    f"{path} is removed" + (f" and so is {branch}." if branch else ".")
                )
                deny(
                    ctx, rec,
                    f"claude-bestpractice: done — {what}"
                    f"{carried}\n"
                    "  Run from the main checkout rather than from inside the tree, because "
                    "removing the directory this shell stands in leaves Claude Code refusing "
                    "every later git call as isolated in a worktree that no longer exists.\n"
                    f"  The shell is now in a directory that is gone — `cd {where}`."
                    + ("" if kept else " There is nothing else to clean up.")
                )
            deny(
                ctx, rec,
                f"claude-bestpractice: git refused to remove {own}, so it is still there and so "
                "is this shell. `git worktree remove` without `--force` will not delete a tree "
                "holding a modified or untracked file.\n"
                f"  git -C {shlex.quote(str(own))} status --porcelain --untracked-files=all\n"
                "  Commit what is worth keeping, remove what is not, then run this again — it "
                "is performed from the main checkout, which is the only place it can be run "
                "without stranding this session."
            )

    # Kept out of `absolute` on purpose, so these never reach the worktree and trunk rules
    # below. `git switch -c` is the command that RESOLVES a trunk violation, and a gate
    # that refuses the fix for the thing it is complaining about is a trap the agent learns
    # to route around. Pointed at somebody else's tree it is a different act entirely, and
    # that is the only thing checked here.
    #
    # Asked BEFORE the stranding rule below, whose way out is a subshell — `(cd <main> &&
    # ...)`. When this rule refuses what is inside it, saying so first is the only order in
    # which the two do not give opposite advice (decision 0017): the subshell was offered,
    # taken, and then refused here, for `git pull --ff-only` among others.
    if cfg.require_worktree and event.tool_name == "Bash":
        main_checkout = ctx.common_dir.parent.resolve()
        for path, fast_forward in git_tree_targets(str(ti.get("command", "")), session_cwd):
            owner = gitpolicy.foreign_tree(ctx, path, rec.session_id)
            # A fast-forward of the main checkout moves it to the trunk and nowhere else:
            # it makes no commit, and git refuses it rather than overwrite anything
            # uncommitted. Nobody stands in that tree to lose work, and a main checkout left
            # behind the trunk is what turned suites red on code nobody present wrote
            # (decision 0018) — refusing it left nothing anywhere able to update it.
            if owner is None or (fast_forward and owner == main_checkout):
                continue
            # Ours to clean up if our own hook made it for us. Otherwise the refusal that
            # hands a session a worktree also makes that worktree permanent: the main
            # checkout is told it belongs to another session, and a worktree cannot remove
            # itself from the inside.
            if not gitpolicy.provisioned_for(ctx, rec.session_id, path):
                deny(ctx, rec, gitpolicy.foreign_git_refusal(owner, ctx))

    # Before the shell takes a step it cannot take back. Claude Code refuses every Bash
    # call whose working directory is inside the protected checkout — judged before the
    # command runs, so `cd` back into the worktree is refused too, and the persistent
    # shell is unusable for the rest of the session (#174). Nothing in this plugin can
    # undo that; what it can do is not let the session walk into it, and the step it
    # refuses was already against this plugin's own rule.
    if cfg.require_worktree and event.tool_name == "Bash":
        stranded = gitpolicy.strands_the_shell(str(ti.get("command", "")), session_cwd, ctx)
        if stranded is not None:
            deny(
                ctx, rec,
                f"claude-bestpractice: this would leave the shell in {stranded}, which is the "
                f"shared checkout, and this session is isolated in {ctx.worktree_root}.\n"
                "  Claude Code then refuses EVERY later Bash call from there — including the "
                "`cd` back — and the shell stays unusable until the session restarts. It is "
                "refused here because that is recoverable and the deadlock is not.\n"
                f"  Run it from this worktree, or in a subshell that returns: "
                f"`(cd {shlex.quote(str(stranded))} && ...)` leaves this shell where it is.\n"
                + config.switch_advice("require_worktree", False)
            )

    # Outside every working tree of this repository there is no rule to apply: a scratch
    # file in /tmp is not somebody else's work, and refusing it only taught the agent that
    # this gate fires on things that do not matter.
    # A path git ignores is exempt from the worktree and trunk rules as well, not only
    # from the cross-tree one. Both rules end in "make the change somewhere else and merge
    # it", and for a file no commit will ever carry there is nowhere else and no merge —
    # #68 stayed open because the first fix reached only the cross-tree rule, and the
    # session standing IN the main checkout met this one instead, with the same dead end.
    #
    # It also stops the refusal PROVISIONING a worktree nobody can use: three accumulated
    # over one task, and the retired production key the session was trying to delete was
    # still on disk at the end of it.
    ours = [
        p for p in absolute
        if gitpolicy.owned_by_session(ctx, p)
        and not gitpolicy.ignored_by_git(ctx.worktree_root, p)
    ]
    if writing and ours and (cfg.require_worktree or cfg.protect_trunk):
        breaches = gitpolicy.violations(ctx, rec.task_statement, rec.session_id)
        if not cfg.require_worktree:
            breaches = [b for b in breaches if "main checkout" not in b]
        if not cfg.protect_trunk:
            breaches = [b for b in breaches if "is the trunk" not in b]
        if breaches:
            deny(ctx, rec, breaches[0])

    # The switch above, and who is allowed to throw it. `config.json` is refused to
    # sessions outright; the project settings file is not, and must not be — it carries
    # permissions, hooks and env that a session edits for the founder all day. So only the
    # ONE key that decides whether this plugin enforces anything is guarded, and only in
    # the direction that switches it off.
    if writing and absolute:
        asking = config.asked_for(ctx, "enabled")
        for path in absolute:
            if _disables_the_plugin(ctx, path, proposed_content(event)) and asking != "off":
                deny(
                    ctx, rec,
                    "claude-bestpractice: that write switches this plugin off for the project, "
                    "and a gate the gated party can switch off is a suggestion.\n"
                    "  It is the founder's to throw, and they have two ways: this same edit "
                    "made by them rather than by a session, or one line from them — "
                    "`enabled off` — and then: claude-bp set enabled off\n"
                    "  Either one stands the whole plugin down on the next tool call, with no "
                    "restart. Do not work around this by editing the file another way."
                )

    # The push gate's own verbs, and whose they are. The hook's bookkeeping records runs the
    # hook watched, and `git push` is what starts it — never a tool call — so a session
    # calling it is writing down an observation nobody made (decision 0013). `off` is the
    # founder's switch on the gate over this session's own pushes: `rm` of the hook is
    # refused below, and this plugin's own command was the same act, approved (decision 0006).
    if event.tool_name == "Bash":
        verbs = ci.verbs_run(str(ti.get("command", "")))
        forged = [verb for verb in verbs if verb in ci.HOOK_ONLY]
        if forged:
            deny(ctx, rec, ci.forged_refusal(forged[0], cfg.test_command))
        if "off" in verbs and config.asked_for(ctx, config.PUSH_GATE) != "off":
            deny_for_founder(ctx, rec, ci.OFF_REFUSAL)

    if event.tool_name in WRITE_TOOLS or event.tool_name == "Bash":
        # A gate whose settings the gated party may rewrite is a suggestion. `config.json`
        # names the command the Stop gate runs as its evidence, and it lives in committed
        # Tier A where the agent writes freely — so `{"test_command": ["true"]}`, one
        # Write call, bought a green finish AND deleted the red-suite ledger that was
        # recording the real failure. Nothing else in the plugin could tell afterwards.
        #
        # Refused rather than ignored: the founder still edits this by hand or with
        # `claude-bp ci`, and a rule the agent can see and route around beats one that
        # silently discards its work.
        # Absolute first, because the git common directory is usually not under our tree
        # at all and `writing_now` only ever holds paths that are.
        for guarded in _protected_absolute(ctx):
            for path in absolute:
                if path == guarded or guarded in path.parents or path in guarded.parents:
                    deny_for_founder(
                        ctx, rec,
                        f"claude-bestpractice: {path} is the plugin's own enforcement state — "
                        "session records, the baseline the diff is measured from, and the "
                        "block counter the Stop gate reads.\n"
                        "  Editing it is how a blocked turn gets ended without doing the "
                        "work: move `baseline_commit` to HEAD and the suite is never run, "
                        "and nothing at all is recorded.\n"
                        "  If a gate is wrong, say so to the founder — do not rewrite what "
                        "it reads."
                    )

        protected = [rel for rel in writing_now if _protected_state(rel)]
        protected += _founders_state(ctx, absolute)
        if protected:
            deny_for_founder(
                ctx, rec,
                f"claude-bestpractice: {protected[0]} is the plugin's own enforcement state, and the "
                "session being enforced does not get to edit it — pointing `test_command` at "
                "`true` would buy a green finish and erase the record of the real failure.\n"
                "Change a gate switch with `claude-bp set <key> <value>`, which needs the "
                "founder to have asked for it in their own words. `test_command` is not one "
                "of those: no command sets it, it is detected from the project, and where "
                "detection is wrong the founder edits this file themselves — so ask them "
                "rather than looking for a command. Everything else under "
                ".claude/claude-bestpractice/ is yours to write."
            )

        # Bash is a write tool. An agent writes files with heredocs, `>`, `tee` and
        # `sed -i` constantly, and scanning only the structured write tools left the
        # credential check and the leases wide open to the most common way files get
        # written: `cat > .env <<EOF` carried a live key straight past a gate whose
        # whole purpose is to stop that, silently, while the doctor reported 23/23.
        content = proposed_content(event)
        # For a shell command, only the words it writes into a file. The scan is for a
        # credential reaching a file a commit will carry, and it read every command whole:
        # `PGPASSWORD=postgres psql …`, `docker run -e POSTGRES_PASSWORD=postgres …` and
        # `JWT_SECRET=testsecret npm test` — the suite the Stop gate demands — were each
        # refused as "this write" with nothing being written anywhere.
        scanned = shell_writes if event.tool_name == "Bash" else content
        hits = [] if _a_credential_belongs_here(ctx, absolute) else redact.find(scanned)
        if hits:
            # WHERE, not just what. Naming the detector alone left a founder deleting
            # lines they suspected, being refused again, and having no way to learn what
            # had matched — a file that could not be written by any route (#95). The
            # excerpt is scrubbed first: printing the value to prove a value was found
            # would put it in the transcript, which is the thing being prevented.
            where = "\n".join(
                f"  line {number}: {excerpt}  [{name}]"
                for name, number, excerpt in redact.locate(scanned)[:5]
            )
            deny(
                ctx, rec,
                f"claude-bestpractice: refusing this write — it contains what looks like a credential "
                f"({', '.join(hits)}).\n{where}\n"
                "Put it in an environment variable and reference it. Post-hoc cleanup does "
                "not work: the value is already on disk and in the transcript, which "
                ".gitignore does not cover."
            )

        # No card, no code. The Stop gate demands the work be on the board, but it demands
        # it at the END — a whole turn of edits happens first, and the founder's own
        # description of the failure is that the ledger gets remembered late or not at all.
        # Asked at the first write instead, which is where a task actually begins.
        #
        # Never a wedge: the way out is a Bash command, and Bash is not what this refuses.
        # The ledger's own files are exempt, or filing the card would be refused by the
        # rule demanding one.
        # Every write, not just the structured ones: this file already resolves what a
        # `sed -i` or a heredoc lands on — the leases and the secret scan both read it —
        # and leaving the ledger gate on `WRITE_TOOLS` alone meant a whole turn of shell
        # edits was invisible to the board while it happened.
        #
        # Still only once the founder has said what this session is for. Dropping that was
        # tried while fixing #141 and taken back out: `prompt-capture` sets the statement
        # from any first prompt that is not pasted output, so it is set in substantially
        # every real session — meaning the demand already fires at the first write there,
        # and removing the condition changed behaviour for every session on the strength
        # of a case that could not be reproduced. The half of #141 that IS proven is the
        # shell one above; a session whose first prompt was a paste still gets the Stop
        # demand, and is the narrow case left open deliberately.
        if cfg.require_task and rec.task_statement and writing_now:
            unlisted = _unlisted(ctx, event.session_id, absolute)
            if unlisted:
                deny(
                    ctx, rec,
                    f"claude-bestpractice: nothing on the board says this session is working "
                    f"on {unlisted}.\n"
                    "  Every sibling session reads the board to decide what is safe to "
                    "touch, and unlisted work is invisible to all of them — so this is "
                    "asked BEFORE the write, while there is still something to protect.\n"
                    f'  claude-bp-plan add "<what you are about to do>" --paths '
                    f"{shlex.quote(unlisted)}\n"
                    "  then: claude-bp-plan claim <id>   (or claim the task you are on)"
                )

        # And the work that never writes a file. The demand above reads the paths a call
        # WRITES, so `git merge`, `git rebase`, `git cherry-pick`, `git revert` and
        # `git am` named none and walked straight past it — a session could take somebody
        # else's branch in, revert a release or replay a patch series with the board saying
        # it was doing nothing at all. That is not reconnaissance; `status`, `log` and
        # `diff` are, and this does not fire on them. Nor on taking the BASE branch in,
        # which is the step the pull-request flow above orders and would be a gate refusing
        # its own instruction.
        #
        # Without the task-statement condition the write demand carries. That condition is
        # there because a drift refusal quotes the statement back, and none of this quotes
        # anything: a session rewriting history with no card is the board being wrong
        # whether or not the founder's first message happened to parse as an instruction.
        if cfg.require_task and event.tool_name == "Bash":
            doing = gitpolicy.changes_the_repository(str(ti.get("command", "")))
            if doing and not _holds_a_card(ctx, event.session_id):
                deny(
                    ctx, rec,
                    f"claude-bestpractice: `git {doing}` changes this repository and nothing "
                    "on the board says this session is working.\n"
                    "  It writes no file, so no other rule here sees it — and every "
                    "sibling reads the board to decide what is safe to touch, so this is "
                    "the last moment there is still something to protect.\n"
                    '  claude-bp-plan add "<what you are about to do>" --paths <the files '
                    "this touches>\n"
                    "  then: claude-bp-plan claim <id>   (or claim the task you are on)\n"
                    "  Finishing one already in flight — `--abort`, `--continue`, "
                    "`--skip` — is never refused here."
                )

        # A registry being stood up beside the ledger, caught while it is one file rather
        # than three entry points and two commits. Structured writes only: a Bash line
        # that merely QUOTES a checkbox is not a registry, and this refuses rather than
        # warns, so a false positive costs the founder a document they meant to write.
        if event.tool_name in WRITE_TOOLS and absolute:
            from claude_bestpractice import migrate

            duplicate = migrate.second_ledger(ctx, absolute[0], content)
            if duplicate:
                deny(ctx, rec, duplicate)

        # One database per session, checked at the first write because that is where the
        # session commits to doing work here. Worktrees isolate files and nothing else:
        # every tree points at the same daemon, so one session's open transaction blocks
        # every sibling's tests on its locks — seventy seconds became twenty minutes on a
        # real repository, and the transaction had been open for nearly a day (#164).
        #
        # A WORKTREE only. The refusal's whole content is "give this tree its own
        # database", and the main checkout is the one tree that cannot take that advice:
        # it holds the project's database by definition, and it is the file every worktree
        # is seeded FROM, so re-pointing it hands every later tree a name that is not the
        # project's. Refusing it there was a deadlock rather than a rule — no session could
        # write in the main checkout at all, `git pull` and `rm` included, so it sat 52
        # commits behind, `make test` failed there for everyone who entered it, and the
        # gate demanding a passing suite kept re-running it in exactly that tree (#181).
        # The tree that can move is the one that gets told to, and it still is.
        # `.env` in this tree is THE WAY OUT, and the refusal below is the thing that
        # names it: "set DATABASE_URL in .env, then `claude-bp database`". Writing that
        # file, and deleting it, were refused by the same message — so the state could be
        # entered and never left, and the only thing that worked was running the write
        # from a directory outside the tree, which is a hole rather than a remedy. Removing
        # the file is an exit too: a tree with no `.env` is a tree that has stopped
        # claiming anybody's database (#216).
        # `writing_now`, never `touched`: the second carries the session's recent history,
        # so an `.env` written ten calls ago would have exempted every write after it.
        remedy = writing_now and all(_is_env_file(Path(rel).name) for rel in writing_now)
        if cfg.isolate_databases and touched and ctx.is_worktree and not remedy:
            clash = worktree.session_on_this_database(ctx, event.session_id)
            if clash:
                deny(
                    ctx, rec,
                    f"claude-bestpractice: session {clash[0][:8]} is already using the database "
                    f"`{clash[1]}`, and this tree points at the same one.\n"
                    "  Worktrees isolate files and nothing else — one open transaction "
                    "there stops the tests here, and neither side can see why.\n"
                    f"  Give this tree its own: set DATABASE_URL in {worktree.ENV_FILE} to "
                    "a database name nobody else holds, then `claude-bp database`.\n"
                    + config.switch_advice("isolate_databases", False)
                )

        # Claim the path. Two sessions editing one file IN ONE TREE is not a merge
        # conflict — it is a silent overwrite where neither side knows it happened.
        #
        # In one tree, and only there. Under `require_worktree`, which this plugin
        # enforces by default, two sessions editing the same path are editing two
        # different files on two branches: nothing is overwritten, and what comes of it
        # is a merge, which git resolves. Refusing there was a second mechanism standing
        # guard over a risk the first one had already removed — and it cost a real
        # session twenty minutes of waiting on a path whose holder had committed and
        # moved on (#163). The overlap is still worth knowing about; it is a fact, and
        # facts go to the inbox rather than into a refusal.
        if cfg.leases_enabled and touched:
            owner = sessions.acquire_lease(
                ctx, event.session_id, touched[0], ttl=cfg.lease_ttl_seconds
            )
            for neighbour in sessions.elsewhere_on(ctx, touched[0], event.session_id):
                other = sessions.get(ctx, neighbour)
                where = f" on {other.branch}" if other else " in another tree"
                inbox.post(ctx, neighbour,
                           f"another session is editing {touched[0]} too, on {rec.branch}. "
                           "Separate trees, so this is a merge rather than an overwrite — "
                           "worth knowing before the merge.", sender=event.session_id)
                inbox.post(ctx, event.session_id,
                           f"session {neighbour[:8]}{where} is editing {touched[0]} too. "
                           "Separate trees, so this is a merge rather than an overwrite — "
                           "worth knowing before the merge.", sender=neighbour)
            if owner:
                other = sessions.get(ctx, owner)
                where = f" on branch {other.branch}" if other else ""
                # The refused session learns from the denial below. The HOLDER learns
                # nothing at all unless it is told, and it is the only one that can end
                # the wait — by finishing with the file or letting it go.
                # An ASK, not a notice. Telling the holder left them free to say nothing
                # and keep the file: the blocked session waited out the full TTL while the
                # holder had committed twenty minutes earlier and moved on. A question
                # their Stop gate will not let them end a turn on gets an answer.
                inbox.ask(
                    ctx, owner,
                    f"another session is blocked on {touched[0]}, which you hold. "
                    "Are you still in it, or can they take it?",
                    sender=event.session_id,
                )
                deny(
                    ctx, rec,
                    f"claude-bestpractice: session {owner[:8]}{where} is editing {touched[0]} "
                    "right now, in this same worktree. Work on something else, or coordinate "
                    "before touching this file — whoever writes second wins silently and "
                    "neither of you would notice."
                )

    # A commit ends this session's claims. A committed file is not being edited, and
    # holding it is a false statement about the world that costs a sibling up to the whole
    # TTL — measured at twenty minutes on a live repository, against a holder who had
    # committed and moved on (#163). Anything it is still working on it re-claims on its
    # next write, which is free and idempotent.
    if cfg.leases_enabled and event.tool_name == "Bash" and \
            gitpolicy.commits(str(ti.get("command", ""))):
        sessions.release_all(ctx, event.session_id)

    # Reached only when every gate allowed the call, so this records what was actually
    # written rather than what was attempted — and, for the same reason, what was actually
    # done rather than what was refused. Added under the record's lock rather than written
    # as the count read at the top plus one, which parallel calls overwrote in turn.
    if touched:
        sessions.count(ctx, event.session_id, "tool_calls", last_touched=touched)
    else:
        sessions.count(ctx, event.session_id, "tool_calls")

    # Last, and only here. `allow_tool` ends the permission pipeline, so a vouch placed any
    # earlier would walk past this gate's own refusals — the credential scan, the leases,
    # the protected-state rules — on its way to sparing the founder a prompt. At this line
    # every one of them has already allowed the call, and the only question left is whether
    # the founder should be asked about something the plugin itself ordered.
    if event.tool_name == "Bash":
        vouched = vouch.for_bash(ctx, str(ti.get("command", "")), cfg.test_command, session_cwd,
                                 require_worktree=cfg.require_worktree,
                                 protect_trunk=cfg.protect_trunk)
    elif event.tool_name in WRITE_TOOLS:
        vouched = vouch.for_write(ctx, event.session_id, absolute)
    else:
        vouched = vouch.for_tool(ctx, event.tool_name, ti)
    # Second, never first: a pull request call that any gate above refused never reaches
    # this line, and one that reached it has been judged rather than merely tolerated.
    vouched = vouched or pr_vouch
    if vouched:
        hookio.allow_tool(vouched)

    hookio.emit_silent()


if __name__ == "__main__":
    hookio.guard(main, fail_closed=True)
