#!/usr/bin/env python3
"""PreToolUse: the fuses. Counters, loop detection, secret pre-write scan, leases.

Fails CLOSED. This gate's entire value is refusing things; a crash that silently
allows is the failure mode that makes a security plugin decorative.

Denials are returned as `permissionDecision: deny` with a reason rather than exit 2.
That talks to the model, which self-corrects silently — the founder is never
interrupted. Reserve exit 2 for a gate whose failure must be loud.

Never reads TOOL_NAME or TOOL_INPUT from the environment. Those variables do not
exist; shipped plugins that read them enforce nothing.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import re  # noqa: E402

from claude_bestpractice import ci, config, evidence, gitpolicy, hookio, inbox, pullrequest, redact, sessions, shellcmd, stage, store, vouch, worktree  # noqa: E402
from claude_bestpractice.gitctx import resolve  # noqa: E402

WRITE_TOOLS = {"Write", "Edit", "MultiEdit", "NotebookEdit"}
SIGNATURE_HISTORY = 64

# The files that decide what the gates do. Everything else under .claude/claude-bestpractice/ is
# the agent's to write — tasks, decisions, dead ends are all meant to be written by it.
# These are not: they are the rules, and the party being ruled does not amend them.
PROTECTED_STATE = (
    ".claude/claude-bestpractice/config.json",
    ".claude/claude-bestpractice/stage/",
    ".claude/claude-bestpractice/slop-budget.json",
    # The record of a failing suite. Not on this list until round six, while every
    # elaborate defence of *clearing* it was being built — and the gate's own denial text
    # told the agent "everything else under .claude/claude-bestpractice/ is yours to write", which
    # was true and was an instruction. `rm .claude/claude-bestpractice/failing-suite.json` was
    # allowed, silently, and ended the whole argument in one call.
    ".claude/claude-bestpractice/failing-suite.json",
    ".claude/claude-bestpractice/last-green.json",
)

# The OTHER half of the enforcement state. `config.json` was refused as "the plugin's own
# enforcement state" while everything under the git common directory — session records,
# baselines, the block counter — stayed writable, and `evidence-gate` trusts all of it.
# Reported as issue #32, with two working bypasses of a gate that was blocking a red suite:
#
#   1. commit the broken change, then set `baseline_commit` to the new HEAD. `changed_files`
#      comes back empty, the suite is never run, and NOTHING is recorded — no unverified
#      entry, no open item. The next session sees a clean history. This is the serious one.
#   2. set `tool_signatures._consecutive_blocks` to the ceiling. One integer, and the turn
#      ends as "finishing UNVERIFIED after 4 blocked attempts" — indistinguishable from a
#      session that genuinely hit it.
#
# The threat model is not a malicious founder. It is an agent that has been blocked four
# times looking for the shortest way to end the turn, in a directory whose path this
# plugin PRINTS on the board, holding plain JSON whose field names say what they do.
#
# Resolved rather than repo-relative: in a worktree the common directory lives in the main
# checkout, so this path is not under our tree at all and no relative rule would see it.
def _protected_absolute(ctx) -> list:
    """Paths outside the working tree that are still the plugin's own state."""
    return [store.tier_b(ctx), ci.hook_path(ctx)]


def _protected_state(relpath: str) -> bool:
    # NOT lstrip("./") — that strips CHARACTERS, so it eats the leading dot of `.claude`
    # and nothing ever matches. The check silently passed everything and the test that
    # caught it was an end-to-end run, not the unit test, which is the whole lesson here.
    rel = relpath.replace("\\", "/")
    while rel.startswith("./"):
        rel = rel[2:]
    # `rm -rf .claude/claude-bestpractice/stage` names the DIRECTORY, with no trailing slash, so a
    # prefix entry of ".../stage/" matched nothing and the whole stage ratchet could be
    # deleted in one command. Match the directory itself as well as its contents.
    if any(
        rel == p or rel == p.rstrip("/") or rel.startswith(p.rstrip("/") + "/")
        for p in PROTECTED_STATE
    ):
        return True
    # And an ANCESTOR of anything protected. `rm -rf .claude/claude-bestpractice` names neither a
    # protected file nor a protected directory, and takes every one of them with it —
    # a rule that guards the leaves and not the branch guards nothing.
    return any(p.startswith(rel.rstrip("/") + "/") for p in PROTECTED_STATE)


MIGRATION_DIRS = ("migrations/", "db/migrate/", "prisma/migrations/", "alembic/versions/")

# Irreversible and data-shaped: the tests pass either way, and corruption only shows up
# under production concurrency long after the change looked fine.
DESTRUCTIVE_DDL = re.compile(
    r"(?i)\b(?:DROP\s+(?:TABLE|COLUMN|SCHEMA|DATABASE)|TRUNCATE\b|"
    r"ALTER\s+(?:TABLE\s+\w+\s+)?(?:DROP|ALTER\s+COLUMN\s+\w+\s+TYPE)|RENAME\s+COLUMN)"
)

# Promotion is the one-way door. Preview deploys stay free; rollback is fully automatic
# precisely because its failure mode is returning to what already worked.
PRODUCTION_DEPLOY = re.compile(
    r"(?i)(?:--prod\b|--production\b|-e\s+prod(?:uction)?\b|environment[= ]production\b|"
    r"kubectl\s+.*--context[= ]\S*prod|fly\s+deploy(?!.*--config)|railway\s+up\b)"
)


def signature(event: hookio.HookEvent) -> str:
    """Identify a repeated action without keying on volatile detail.

    Two things are deliberately in and one deliberately out. The target path is in, so
    editing two different files is never mistaken for a loop. The replacement TEXT is out,
    so a retry with a one-character change is not mistaken for progress.

    What was wrongly out is the ANCHOR — which region of the file an edit names. Five
    sequential edits to five different parts of one module are ordinary work, and they
    shared a signature, so the fifth was refused as "run 4 times in a row with nothing in
    between" (#95). A retry of a failed edit repeats its `old_string`; a distinct edit does
    not, which is exactly the line the detector wanted and was not drawing.

    And a Bash command is hashed WHOLE. Truncating at 160 characters made four heredocs
    writing four different files identical, because the boilerplate that opens them is —
    so probing for the cause of one block was itself blocked.
    """
    import hashlib

    ti = event.tool_input
    target = ti.get("file_path") or ti.get("path") or ti.get("command") or ""
    anchors = [str(ti.get("old_string") or ti.get("old_str") or "")]
    edits = ti.get("edits")
    if isinstance(edits, list):
        anchors.extend(str(e.get("old_string", "")) for e in edits if isinstance(e, dict))
    seed = "\u0000".join([str(target), *(a for a in anchors if a)])
    return f"{event.tool_name}:{hashlib.sha256(seed.encode('utf-8', 'surrogateescape')).hexdigest()[:24]}"


def _within_dir(target, root) -> bool:
    """Is `target` at or under `root`, whether or not either exists yet?"""
    try:
        return target.resolve() == root.resolve() or root.resolve() in target.resolve().parents
    except (OSError, ValueError):
        return False


def _sibling_of_repo(ctx, target) -> bool:
    """A tree this plugin would provision: `<repo>-<slug>`, alongside the repository.

    The NAME as well as the parent. Matching the parent alone vouched for every unrelated
    directory that happened to sit next to the checkout, which is exactly the "we know
    nothing about it, leave it to the founder" case the silence here is for — caught by
    the test that says so.
    """
    try:
        root = ctx.worktree_root.resolve()
        resolved = target.resolve()
    except (OSError, ValueError):
        return False
    return resolved.parent == root.parent and resolved.name.startswith(f"{root.name}-")


def _ledger_covers(ctx, session_id: str, touched: list[str]) -> bool:
    """Is a task on the board claimed by this session? The ledger's own files always are.

    Exempt paths too: a turn that only touches `.claude/` needs no card for the same
    reason it needs no test run — the gate's own bookkeeping is not the founder's work.
    """
    from claude_bestpractice import plan, store

    if all(rel.startswith(store.TIER_A_DIRNAME) or rel.startswith(".claude/") for rel in touched):
        return True
    return any(t.owner == session_id for t in plan.load_all(ctx, plan.DOING))


def proposed_content(event: hookio.HookEvent) -> str:
    ti = event.tool_input
    parts = [str(ti.get(k, "")) for k in ("content", "new_string", "new_str", "command")]
    edits = ti.get("edits")
    if isinstance(edits, list):
        parts.extend(str(e.get("new_string", "")) for e in edits if isinstance(e, dict))
    return "\n".join(p for p in parts if p)


# `> f`, `>> f`, `tee f`, `sed -i … f`, `cat … > f`. Deliberately generous: a path this
# misses costs a missed lease, and a path it invents costs one spurious claim on a file
# nobody else wanted.
_QUOTED = re.compile(r"""'[^']*'|"[^"]*\"""", re.S)

BASH_WRITE_TARGETS = re.compile(r"(?:>>?\s*|\btee\s+(?:-a\s+)?)(?P<path>[\"']?[\w./@+~-]+[\"']?)")

# `sed -i` writes its LAST argument; everything before it is the script, which looks
# path-shaped enough (`s/x/y/`) to fool a single pattern.
SED_IN_PLACE = re.compile(r"\bsed\s+(?:-\S+\s+|'[^']*'\s+|\"[^\"]*\"\s+)*(?P<path>[\w./@+-]+)")

# DESTRUCTION is not a redirect, and the write scanner only ever looked for redirects.
# So every rule keyed on "which paths does this command write" — the credential scan, the
# leases, and the protected-state refusal — was bypassable with `rm`. Deleting the record
# of a failing suite is not a write to it, and one `rm` ended an argument the rest of this
# gate spends hundreds of lines having.
#
# Every path-shaped argument of these verbs counts, because `rm -rf a b c` names three.
BASH_REMOVES = re.compile(
    r"\b(?:rm|unlink|shred|truncate)\b(?P<args>(?:\s+(?:-\S+|[\w./@+~-]+))+)"
)

# `cp`, `mv`, `install` and `ln` write their LAST argument and READ the rest. Taking every
# path-shaped argument meant a source was judged as a write: `cp <main>/.env .env` from a
# worktree was refused for touching the main checkout, when the main checkout is where the
# bytes came FROM and the destination was inside our own tree. Reading a sibling checkout —
# an `.env`, a shared key, a diff — is routine. Reported as issue #42.
BASH_COPIES = re.compile(
    r"\b(?:mv|cp|install|ln)\b(?P<args>(?:\s+(?:-\S+|[\w./@+~-]+))+)"
)

# A heredoc body is DATA. `select … where n_live_tup > 0` inside one looks exactly like a
# redirect to a file named `0`, and the guard duly refused a write to `<cwd>/0` — a path
# that does not exist and was never named, so the message gave no way to find the real
# problem. Blanked like quoted spans, and for the same reason.
_HEREDOC = re.compile(r"<<-?\s*(['\"]?)(?P<tag>\w+)\1.*?^\s*(?P=tag)\s*$", re.S | re.M)
_ARG = re.compile(r"[\w./@+~-]+")


# `cd x && …` moves what a relative redirect means, and nothing here was reading it. A
# command that wrote `/tmp/t9/a.py` was resolved against the repository root instead and
# refused as a write to `<repo>/a.py` — a file it never touched. Reported from a real
# machine, alongside the opposite error: an absolute path outside the repository raised
# ValueError and was dropped entirely, so the same write went through unexamined.
_CD = re.compile(r"^\s*cd\s+(?P<path>[\"']?[\w./@+~-]+[\"']?)\s*$")
_SEGMENTS = re.compile(r"&&|\|\||;|\n")

# Git destroys a working tree without ever naming a file in it, so every rule here keyed
# on "which paths does this write" saw nothing at all. `git -C ../main reset --hard HEAD~1`
# discards a sibling session's uncommitted work; `clean -fd` deletes it outright; `checkout`
# and `switch` move a HEAD that session is standing on. Reported as the incident that made
# worktree-first a rule in the first place.
#
# These are the subcommands that touch a working tree or the HEAD it follows. `status`,
# `log`, `diff`, `add`, `commit` and `fetch` are deliberately absent: they either only read,
# or they only move things the index and the object store already own.
GIT_TREE_VERBS = {
    "reset", "checkout", "switch", "restore", "clean", "stash", "rm", "mv",
    "apply", "am", "revert", "merge", "rebase", "cherry-pick", "pull", "worktree",
}
_GIT_C = re.compile(r"(?:^|\s)-C\s+(?P<path>[\"']?[\w./@+~-]+[\"']?)")
_GIT_WORK_TREE = re.compile(r"--work-tree(?:=|\s+)(?P<path>[\"']?[\w./@+~-]+[\"']?)")
_GIT_VERB = re.compile(r"\bgit\b(?P<rest>.*)", re.S)
_WORKTREE_REMOVE = re.compile(r"\bworktree\s+(?:remove|prune)\b(?P<args>(?:\s+(?:-\S+|[\w./@+-]+))*)")

# `git worktree list` is `git status` for worktrees: it reads and returns. `worktree` was
# in the verb set whole, so asking WHERE the other sessions are, from anywhere but your own
# tree, came back refused as a command that discards uncommitted work — naming reset, clean
# and stash, none of which it was. The cheapest way to find out what else is running was
# the one thing you could not do, in the product whose premise is that several things are.
_WORKTREE_READ = re.compile(r"\bworktree\s+list\b")

# An interpreter is not statically analysable in general and this does not pretend to be.
# It matches the literal one-liner form only — the shape actually used to reach around a
# path rule — and misses anything computed, which is stated rather than implied.
_INTERPRETER_WRITE = re.compile(
    r"""writeFileSync\s*\(\s*['"](?P<a>[^'"]+)['"]"""
    r"""|(?:^|\W)open\s*\(\s*['"](?P<b>[^'"]+)['"]\s*,\s*['"][wax]""",
    re.M,
)


def _segments_with_cwd(scannable: str, cwd: Path):
    """Each shell segment paired with the directory it would actually run in."""
    here = cwd
    for segment in _SEGMENTS.split(scannable):
        moved = _CD.match(segment)
        if moved:
            # Tracked, never executed. `cd` into a path that does not exist still changes
            # what the rest of the line means to this scanner, and guessing wrong here
            # only costs a target that lands outside every tree, which is ignored anyway.
            here = (here / moved.group("path").strip("\"'")).expanduser()
            continue
        yield segment, here


def _resolve(base: Path, raw: str) -> Path | None:
    """Where a path argument actually points, expanding `~` BEFORE joining.

    `base / "~/x"` is `<base>/~/x`, and `.expanduser()` only expands a path that STARTS
    with `~` — so a home-relative path was rewritten into one inside the repository and
    then refused by the main-checkout rule, for a file the command never went near.
    Reported as issue #37: deleting stray files under `~/.claude/projects/` came back as
    "this is the main checkout, not a worktree".
    """
    try:
        candidate = Path(raw.strip("\"'")).expanduser()
        if not candidate.is_absolute():
            candidate = base / candidate
        return candidate.resolve()
    except (OSError, RuntimeError):
        return None


def git_tree_targets(command: str, cwd: Path) -> list[Path]:
    """Working trees a git command would mutate, however it was pointed at them.

    Three ways to name one, and all three are explicit, which is why this is worth doing
    statically at all: `-C <path>`, `--work-tree <path>`, or the directory the command runs
    in — which `cd` already tracks for redirects.
    """
    scannable = _QUOTED.sub(lambda m: " " * len(m.group(0)), command)
    out: list[Path] = []
    for segment, here in _segments_with_cwd(scannable, cwd):
        found = _GIT_VERB.search(segment)
        if not found:
            continue
        rest = found.group("rest")
        verbs = GIT_TREE_VERBS & set(_ARG.findall(rest))
        if not verbs:
            continue
        # Only when `worktree` is the whole reason this matched: `git worktree list && git
        # reset --hard` is two commands in one segment and the second one still counts.
        if verbs == {"worktree"} and _WORKTREE_READ.search(rest):
            continue
        # Only when `worktree` is the whole reason this matched: `git worktree list && git
        # reset --hard` is two commands in one segment and the second one still counts.

        bases = [_resolve(here, m.group("path"))
                 for m in list(_GIT_C.finditer(rest)) + list(_GIT_WORK_TREE.finditer(rest))]
        # `git worktree remove <path>` destroys a tree named as a plain argument.
        for removal in _WORKTREE_REMOVE.finditer(rest):
            bases += [_resolve(here, a) for a in _ARG.findall(removal.group("args"))
                      if not a.startswith("-")]
        if not bases:
            bases = [_resolve(here, ".")]

        for base in bases:
            if base is not None and base not in out:
                out.append(base)
    return out


def bash_write_targets(command: str, cwd: Path) -> list[Path]:
    """Absolute paths a shell command appears to write, resolved as the shell would.

    Deliberately generous. A path this misses is a missed lease and a missed scan; a
    path it invents is one spurious claim on a file nobody else wanted.

    Absolute rather than repo-relative because the caller now has to decide WHICH tree a
    write lands in, and a path that has already been forced relative to one root cannot
    answer that.
    """
    # Blank out quoted spans first. `echo "a > b"` and `grep -q "x>y" f` contain no
    # redirect, but a naive scan read one and claimed a lease on a path that does not
    # exist — which denies a sibling session for a file nobody is editing.
    scannable = _HEREDOC.sub(lambda m: " " * len(m.group(0)), command)
    scannable = _QUOTED.sub(lambda m: " " * len(m.group(0)), scannable)

    out: list[Path] = []

    # On the RAW command, because `_QUOTED` blanks quoted spans and an interpreter's path
    # is always quoted — scanning the blanked copy would find nothing, every time.
    for match in _INTERPRETER_WRITE.finditer(command):
        resolved = _resolve(cwd, match.group("a") or match.group("b") or "")
        if resolved is not None and resolved not in out:
            out.append(resolved)

    for segment, here in _segments_with_cwd(scannable, cwd):
        matches = list(BASH_WRITE_TARGETS.finditer(segment))
        if "sed" in segment and " -i" in segment:
            matches += list(SED_IN_PLACE.finditer(segment))
        raws = [m.group("path") for m in matches]

        # ...and every path a destructive verb names. `rm` is not a redirect, so none of
        # these commands produced a target at all, and every rule keyed on "what does this
        # write" was one `rm` away from irrelevant.
        for match in BASH_REMOVES.finditer(segment):
            raws += [a for a in _ARG.findall(match.group("args")) if not a.startswith("-")]

        # Destination only. The sources are reads, and refusing a read is how a guard
        # stops being about safety and starts being about obedience.
        for match in BASH_COPIES.finditer(segment):
            operands = [a for a in _ARG.findall(match.group("args")) if not a.startswith("-")]
            if operands:
                raws.append(operands[-1])

        for raw in raws:
            token = raw.strip("\"'")
            # `2>&1`, `> 0`, `>1`: file descriptors and comparisons, never filenames.
            if not token or token.startswith("/dev/") or token.isdigit():
                continue
            resolved = _resolve(here, raw)
            if resolved is not None and resolved not in out:
                out.append(resolved)
    return out


def _sibling_on_the_same_database(ctx, session_id: str):
    """A live session already using this tree's database, as (session_id, name).

    A tree that names no database collides with nothing: the comparison below requires a
    NON-EMPTY match, so two repositories with no database configured are not each other's
    collision. That truthiness is load-bearing, not defensive — without it every pair of
    sessions in a repository that has no database at all refuses the other, and a gate
    that fires where there is nothing to collide over is one the founder switches off for
    every project.
    """
    from claude_bestpractice import worktree

    here = worktree.database_of(ctx.worktree_root)
    for other in sessions.live_sessions(ctx, exclude=session_id):
        try:
            theirs = worktree.database_of(Path(other.worktree))
        except (OSError, TypeError):
            continue
        if theirs and theirs == here:
            return other.session_id, here.rsplit("/", 1)[-1]
    return None


def main() -> None:
    event = hookio.read_event()
    ctx = hookio.repo(event.cwd or os.getcwd())
    cfg = config.load(ctx)

    rec = sessions.get(ctx, event.session_id)
    if rec is None:
        # No record means SessionStart never ran, or something deleted it. Re-register
        # and keep enforcing. Allowing here — the previous behaviour — made every gate
        # in this file switch off for any session whose record went missing, so the
        # secret scan and the leases could be disabled with `rm`.
        rec = sessions.adopt(ctx, event.session_id)

    # What another session needed this one to know, delivered into this session's own
    # inbox before the call it is about to make. The board is injected once at session
    # start (decision 0003), so without this a running session never learns anything new
    # — and this is the last moment before it acts on what it does not yet know.
    inbox.drain(ctx, event.session_id)

    sig = signature(event)
    history = list(rec.tool_signatures.get("_history", [])) if isinstance(rec.tool_signatures.get("_history"), list) else []
    history.append(sig)
    history = history[-SIGNATURE_HISTORY:]

    counts = {k: v for k, v in rec.tool_signatures.items() if k != "_history" and isinstance(v, int)}
    counts[sig] = counts.get(sig, 0) + 1
    calls = rec.tool_calls + 1

    ti = event.tool_input
    target = ""
    shell_targets: list[str] = []

    # Where the write LANDS, absolute, before anything is forced relative to a root it may
    # not belong to. The rules below split on this: our tree, somebody else's tree, or
    # neither — and the third is none of this gate's business.
    session_cwd = Path(event.cwd) if event.cwd else ctx.worktree_root
    absolute: list[Path] = []

    if event.tool_name in WRITE_TOOLS and ti.get("file_path"):
        raw = str(ti["file_path"])
        resolved_target = _resolve(session_cwd, raw)
        absolute = [resolved_target] if resolved_target else []
        # Repo-relative, or nothing. `target` feeds the lease and the board, and both are
        # about coordinating sessions over THIS repository's files — so a scratch file in
        # /tmp took a lease that then denied a second session the same scratch file, for a
        # path neither of them shares.
        target = ""
        if absolute:
            try:
                target = str(absolute[0].relative_to(ctx.worktree_root.resolve()))
            except ValueError:
                target = ""
    elif event.tool_name == "Bash":
        absolute = bash_write_targets(str(ti.get("command", "")), session_cwd)
        # Repo-relative is what the leases, the board and the protected-state refusal all
        # speak, so the ones inside our tree are converted and the rest stay out of it.
        for path in absolute:
            try:
                shell_targets.append(str(path.relative_to(ctx.worktree_root.resolve())))
            except ValueError:
                continue
        target = shell_targets[0] if shell_targets else ""

    # What THIS call writes, as opposed to `touched` below, which carries recent history
    # for the board and the lease. Any rule about the write in hand has to read this one:
    # checking `touched` denied every write in the session as soon as one protected path
    # had ever appeared in it, and the message named the wrong file every time.
    writing_now = shell_targets if event.tool_name == "Bash" else ([target] if target else [])

    # HISTORY is recorded now, because a denied attempt is still an attempt and loop
    # detection depends on seeing it. The CEILING's counter is not: a call this plugin
    # refused is not work the session did, and counting it meant every refusal pushed the
    # session closer to a wall it would then hit for having been refused. It is
    # incremented at the end of this file, where the call has actually been allowed.
    # `last_touched` is not recorded here either — a write we refused never happened.
    payload = dict(counts)
    payload["_history"] = history
    sessions.touch(ctx, event.session_id, tool_signatures=payload)
    touched = ([target] + [t for t in rec.last_touched if t != target])[:12] if target else []

    # The escape is exempt. A ceiling that also refuses the one command that raises it is
    # not a ceiling, it is the end of the session — and the message below names that
    # command, so refusing it would be this gate advertising a door it has just locked
    # (the shape of #108, in a place where the founder may not be awake to open it).
    over_ceiling = cfg.max_tool_calls > 0 and rec.tool_calls >= cfg.max_tool_calls
    escaping = event.tool_name == "Bash" and vouch.own_command(str(ti.get("command", "")))
    if over_ceiling and not escaping:
        hookio.deny_tool(
            f"claude-bestpractice: this session has made {rec.tool_calls} tool calls, past the "
            f"ceiling of {cfg.max_tool_calls}. Calls this gate refused are not counted, so "
            "that is work that actually happened.\n"
            "  A long measuring session legitimately runs into thousands of calls. The "
            "ceiling is the config key `max_tool_calls`, and raising it takes one line from "
            f"the founder — `max_tool_calls {cfg.max_tool_calls * 2}` — and then:\n"
            f"  claude-bp set max_tool_calls {cfg.max_tool_calls * 2}\n"
            "  Otherwise: stop and summarise what is done and what remains."
        )

    # CONSECUTIVE repeats, never a lifetime total. The lifetime count made the fourth
    # `npm test` of a session a permanent refusal — and `npm test` is the command the
    # Stop gate ORDERS the agent to run, so the two gates deadlocked: finish refused for
    # want of a test run, test run refused for having been run before. Doing anything
    # else in between did not clear it, because nothing ever decremented the counter.
    #
    # Running the suite five times while fixing five things is the work, not a loop. A
    # loop is the identical call with nothing in between, which is what this counts now.
    # Alternating cycles — test, edit, test, edit, forever — are a different shape and
    # `detect_loop` below is what sees those.
    streak = 0
    for previous in reversed(history):
        if previous != sig:
            break
        streak += 1
    if streak > cfg.max_repeat_signature:
        hookio.deny_tool(
            f"claude-bestpractice: `{sig}` has now been run {streak} times in a row with nothing in "
            "between. Repeating it unchanged is not making progress — change the input, "
            "change the approach, or say plainly that you are stuck.\n"
            "Anything else you do clears this: the count is consecutive, not a lifetime total."
        )

    if cfg.loop_detect:
        loop = evidence.detect_loop(history)
        if loop:
            hookio.deny_tool(
                f"claude-bestpractice: detected a repeating cycle: {loop}. Break out of it — try a "
                "different approach or report the blocker."
            )

    # A pull request is an obligation from the moment it is opened, and the merge is the
    # one point where every check this plugin has can still be applied. Both halves of
    # that live here: the obligation is written down, and the merge is judged.
    pr_vouch = ""
    if cfg.manage_pull_requests:
        command = str(ti.get("command", "")) if event.tool_name == "Bash" else ""
        number = pullrequest.merge_target(event.tool_name, command, ti)
        if number is not None:
            gated = pullrequest.gated_by(
                ctx, number, pullrequest.about_current_branch(event.tool_name, command)
            )
            if gated is not None:
                # Green is not accepted. The checks say the code works; they say nothing
                # about whether the founder wants what was built, and in a repository that
                # deploys from the trunk a merge is a step towards shipping it. So the
                # merge waits for their word — and once it is given, the assistant opens,
                # checks and merges on its own, which is the arrangement they asked for.
                if not config.approved(ctx, config.APPROVE_MERGE):
                    hookio.deny_tool(
                        "claude-bestpractice: this pull request has not been accepted by the founder "
                        "yet. Passing checks mean the code works, not that the work is "
                        "wanted — and main deploys, so merging is a step towards shipping "
                        "it.\n"
                        "  Show them what changed and ask. When they are happy they say "
                        "`+merge` — copy it exactly — and this allows the merge once.\n"
                        "  Their word is read from their own message; nothing you write "
                        "can stand in for it."
                    )
                # Spent here rather than after the call, because a PreToolUse hook never
                # sees the result: one word authorises one merge either way, and a merge
                # that failed is re-authorised by the founder rather than by its own retry.
                config.clear_switch(ctx, config.APPROVE_MERGE)
                base = str(gated.get("base") or "") or gitpolicy.default_branch(ctx) or "main"
                # The pull request's own head, not the tree this session is standing in.
                problems = pullrequest.blockers(ctx, base, str(gated.get("branch") or ""))
                if problems:
                    hookio.deny_tool(pullrequest.merge_refusal(gated, problems))
                # Judged, and nothing found. Carried to the vouch at the end of this file
                # rather than allowed here, because `allow_tool` ends the permission
                # pipeline and every gate below this line still has its say.
                if pullrequest.about_this_repository(ctx, event.tool_name, ti, command):
                    pr_vouch = vouch.MERGE
                # Recorded on the way through: a PreToolUse hook never sees the result,
                # and an obligation the founder has already watched be merged is worse
                # than useless on the board.
                #
                # `ctx.branch` is right here and not an oversight: `gated_by` resolves the
                # obligation by the CURRENT branch, so a merge that reaches this line is
                # always this branch's. A merge of somebody else's is not gated at all and
                # never arrives (#135) — which is what makes settling here safe.
                pullrequest.settle(ctx, ctx.branch, pullrequest.MERGED)
                # Every other session's baseline just went stale. They measure their diff
                # from a commit that is no longer where the branch begins, so drift and
                # scope both read wrong until they take the merge in.
                inbox.broadcast(
                    ctx, event.session_id,
                    f"{ctx.branch} was merged. Your baseline is behind — take the base "
                    "branch in before you finish, or your diff is measured from the "
                    "wrong commit.",
                )
        elif pullrequest.opens_a_pull_request(event.tool_name, command):
            # No number: a PreToolUse hook sees the request, never the response, and the
            # number only exists in the response. The branch identifies the obligation,
            # which is the identity every check here is keyed by anyway.
            base = gitpolicy.default_branch(ctx) or "main"
            # The branch the pull request is opened FROM, which is not the session's own
            # when the session coordinates from the main checkout (#79).
            head = pullrequest.head_of(event.tool_name, command, ti, session_cwd) or ctx.branch
            pullrequest.opened(ctx, head, base, event.session_id)
            if pullrequest.about_this_repository(ctx, event.tool_name, ti, command):
                pr_vouch = vouch.PULL_REQUEST

    # Entering a worktree is the move this gate ORDERS. Making the founder authorise it
    # through a permission prompt is the plugin interrupting them with its own
    # instruction, which is the thing the whole design exists to remove.
    #
    # Approved only for a working tree of THIS repository — anywhere else this stays
    # silent and the normal permission flow decides, because vouching for a directory
    # this plugin knows nothing about is not the gate's to do.
    if event.tool_name == "EnterWorktree" and cfg.require_worktree:
        target = _resolve(session_cwd, str(ti.get("path") or "")) if ti.get("path") else None
        # Any working tree of this repository, asked directly. This used to lean on
        # `foreign_tree` returning non-None to mean "a tree of ours", which stopped being
        # true once that function learned to stay silent about trees nobody is standing in
        # (#67) — and the tree it had just handed over is exactly such a tree, so the
        # pre-approval fell through and the founder was asked again.
        # Including a tree that does not exist YET. Claude Code creates its own worktrees
        # under `.claude/worktrees`, so requiring the path to be an existing working tree
        # left the creating call unapproved — and the founder was asked to authorise the
        # move this gate had just ordered, which is the interruption it exists to remove.
        made_here = ctx.worktree_root / ".claude" / "worktrees"
        if target is None or gitpolicy.owned_by_session(ctx, target) or \
                target.resolve() in set(gitpolicy.working_trees(ctx)) or \
                _within_dir(target, made_here) or _sibling_of_repo(ctx, target):
            hookio.allow_tool(
                "claude-bestpractice: this gate requires a worktree, so entering one needs no "
                "further permission. Asking the founder to authorise the move it just "
                "ordered is the interruption this plugin exists to remove."
            )

    resolved_stage, _ = stage.current(ctx, cfg.stage_override)
    gates = stage.gates_for(resolved_stage)

    if event.tool_name == "Bash" and cfg.commit_conventions:
        message = gitpolicy.commit_message(str(ti.get("command", "")))
        if message:
            complaint = gitpolicy.message_complaint(message)
            if complaint:
                hookio.deny_tool(
                    f"claude-bestpractice: {complaint}\n"
                    "The reader is not a reviewer — there is none. It is the next session, "
                    "running `git log` on this file to work out why it looks the way it does.\n"
                    + config.switch_advice("commit_conventions", False)
                )

    if event.tool_name in WRITE_TOOLS or event.tool_name == "Bash":
        conflicted = gitpolicy.conflict_complaint(proposed_content(event))
        if conflicted:
            hookio.deny_tool(f"claude-bestpractice: {conflicted}")

    if gates["migration_gate"]:
        if event.tool_name == "Bash":
            command = str(ti.get("command", ""))
            # Per COMMAND, not per line. `--prod` inside `echo "deploy with --prod"` is
            # text about a deploy, and refusing it is the defect #76 reported one gate
            # over. An unparseable line falls back to the whole string, so a command
            # crafted to break the tokeniser does not become one that walks past this.
            # Two different empties, and folding them together made `echo "--prod"` a
            # deploy again: `acting` returns nothing both for a line that cannot be parsed
            # and for a line that only reads. The first must fall back to the whole string,
            # the second must pass. Caught by the test written for this very fix.
            parsed = shellcmd.commands(command)
            deploying = (
                any(PRODUCTION_DEPLOY.search(" ".join(argv)) for argv in shellcmd.acting(command))
                if parsed else bool(PRODUCTION_DEPLOY.search(command))
            )
            if deploying and not config.approved(ctx, config.APPROVE_RELEASE):
                # The literal used to be a token IN THE COMMAND, which the session writes
                # — so the gate on the one irreversible action was openable by the party
                # it gates. Decision 0006 closed exactly that hole for config switches and
                # this was left behind. The founder's own word now, consumed on use, so it
                # can never become a standing grant.
                hookio.deny_tool(
                    "claude-bestpractice: promoting to production is the one action that cannot be "
                    "undone by re-running it, and it has not been approved.\n"
                    "  Deploy to a preview environment instead, or show the founder what "
                    "would ship and wait. When they are ready they say `+release` — copied "
                    "exactly — and "
                    "that allows exactly one promotion.\n"
                    "  Rollback stays automatic; promotion does not."
                )
            if deploying:
                config.clear_switch(ctx, config.APPROVE_RELEASE)
        if event.tool_name in WRITE_TOOLS or event.tool_name == "Bash":
            # Bash reaches migrations the same way it reaches everything else. Denying
            # `DROP TABLE` through Write while allowing the identical bytes through
            # `cat > migrations/x.sql <<EOF` is a gate the agent routes around by
            # accident on its first heredoc.
            rel = touched[0] if touched else ""
            if rel and any(rel.startswith(d) for d in MIGRATION_DIRS):
                body = proposed_content(event)
                if DESTRUCTIVE_DDL.search(body):
                    # The literal used to live IN THE MIGRATION, which the session writes,
                    # so the gate on irreversible data loss was openable by the party it
                    # gates — the same hole decision 0006 closed for config switches and
                    # v1.28.0 closed for merges and promotions. This was the last one.
                    if not config.approved(ctx, config.APPROVE_MIGRATION):
                        hookio.deny_tool(
                            "claude-bestpractice: destructive DDL in a migration. This is irreversible "
                            "and data-shaped — the tests pass either way and corruption surfaces "
                            "only under production concurrency.\n"
                            "  Use an expand-contract migration, or show the founder the "
                            "statement and what it drops. When they accept the loss they say "
                            "`+migration` — copied exactly — and that allows exactly one.\n"
                            "  Their word is read from their own message; a token you write "
                            "into the migration is not their word."
                        )
                    # Spent here rather than after the call: a PreToolUse hook never sees
                    # the result, and a write that failed is re-authorised by the founder
                    # rather than by its own retry.
                    config.clear_switch(ctx, config.APPROVE_MIGRATION)

    # Before any write is examined: may this session write HERE at all? Writes only, so
    # reads, searches and `git worktree add` itself stay free — a rule that blocks the
    # command which satisfies it is a trap the agent learns to route around.
    #
    # Judged by the TARGET, not by where the session happens to sit. Asking the latter got
    # it wrong in both directions on a real machine: a Write to `/tmp` was refused because
    # the session was in the main checkout, while a session in a worktree could write into
    # the main checkout and into a sibling session's tree and nothing objected — which is
    # precisely the silent overwrite the refusal text warns about.
    # `absolute`, not `touched`: `touched` holds only paths inside OUR tree, so a shell
    # command writing into another working tree emptied it and this whole block was
    # skipped — the one case that most needed to reach it.
    writing = event.tool_name in WRITE_TOOLS or (event.tool_name == "Bash" and absolute)
    if writing and cfg.require_worktree:
        for path in absolute:
            owner = gitpolicy.foreign_tree(ctx, path, event.session_id)
            # Ours if this plugin made it for this session. Without this the gate was a
            # closed loop: it refused the main checkout, handed over a worktree in the
            # same breath, and then refused every write into that worktree as "another
            # session's" — a tree it had created for this very session seconds earlier.
            # Reported from a real machine, with the session left nowhere it could write.
            # `provisioned_for` already guarded the git verbs for exactly this reason
            # (issue #37); the write path, which is what the founder actually hits, was
            # never given the same exemption.
            if owner is not None and not gitpolicy.provisioned_for(ctx, event.session_id, owner):
                hookio.deny_tool(gitpolicy.foreign_refusal(path, owner, ctx))

    # Kept out of `absolute` on purpose, so these never reach the worktree and trunk rules
    # below. `git switch -c` is the command that RESOLVES a trunk violation, and a gate
    # that refuses the fix for the thing it is complaining about is a trap the agent learns
    # to route around. Pointed at somebody else's tree it is a different act entirely, and
    # that is the only thing checked here.
    if cfg.require_worktree and event.tool_name == "Bash":
        for path in git_tree_targets(str(ti.get("command", "")), session_cwd):
            owner = gitpolicy.foreign_tree(ctx, path, rec.session_id)
            # Ours to clean up if our own hook made it for us. Otherwise the refusal that
            # hands a session a worktree also makes that worktree permanent: the main
            # checkout is told it belongs to another session, and a worktree cannot remove
            # itself from the inside.
            if owner is not None and not gitpolicy.provisioned_for(ctx, rec.session_id, path):
                hookio.deny_tool(gitpolicy.foreign_git_refusal(owner, ctx))

    # Outside every working tree of this repository there is no rule to apply: a scratch
    # file in /tmp is not somebody else's work, and refusing it only taught the agent that
    # this gate fires on things that do not matter.
    # A path git ignores is exempt from the worktree and trunk rules as well, not only
    # from the cross-tree one. Both rules end in "make the change somewhere else and merge
    # it", and for a file no commit will ever carry there is nowhere else and no merge —
    # #68 stayed open because the first fix reached only the cross-tree rule, and the
    # session standing IN the main checkout met this one instead, with the same dead end.
    #
    # It also stops the refusal PROVISIONING a worktree nobody can use: three accumulated
    # over one task, and the retired production key the session was trying to delete was
    # still on disk at the end of it.
    ours = [
        p for p in absolute
        if gitpolicy.owned_by_session(ctx, p)
        and not gitpolicy.ignored_by_git(ctx.worktree_root, p)
    ]
    if writing and ours and (cfg.require_worktree or cfg.protect_trunk):
        breaches = gitpolicy.violations(ctx, rec.task_statement, rec.session_id)
        if not cfg.require_worktree:
            breaches = [b for b in breaches if "main checkout" not in b]
        if not cfg.protect_trunk:
            breaches = [b for b in breaches if "is the trunk" not in b]
        if breaches:
            hookio.deny_tool(breaches[0])

    if event.tool_name in WRITE_TOOLS or event.tool_name == "Bash":
        # A gate whose settings the gated party may rewrite is a suggestion. `config.json`
        # names the command the Stop gate runs as its evidence, and it lives in committed
        # Tier A where the agent writes freely — so `{"test_command": ["true"]}`, one
        # Write call, bought a green finish AND deleted the red-suite ledger that was
        # recording the real failure. Nothing else in the plugin could tell afterwards.
        #
        # Refused rather than ignored: the founder still edits this by hand or with
        # `claude-bp ci`, and a rule the agent can see and route around beats one that
        # silently discards its work.
        # Absolute first, because the git common directory is usually not under our tree
        # at all and `writing_now` only ever holds paths that are.
        for guarded in _protected_absolute(ctx):
            for path in absolute:
                if path == guarded or guarded in path.parents or path in guarded.parents:
                    hookio.deny_tool(
                        f"claude-bestpractice: {path} is the plugin's own enforcement state — "
                        "session records, the baseline the diff is measured from, and the "
                        "block counter the Stop gate reads.\n"
                        "  Editing it is how a blocked turn gets ended without doing the "
                        "work: move `baseline_commit` to HEAD and the suite is never run, "
                        "and nothing at all is recorded.\n"
                        "  If a gate is wrong, say so to the founder — do not rewrite what "
                        "it reads."
                    )

        protected = [rel for rel in writing_now if _protected_state(rel)]
        if protected:
            hookio.deny_tool(
                f"claude-bestpractice: {protected[0]} is the plugin's own enforcement state, and the "
                "session being enforced does not get to edit it — pointing `test_command` at "
                "`true` would buy a green finish and erase the record of the real failure.\n"
                "Change a gate switch with `claude-bp set <key> <value>`, which needs the "
                "founder to have asked for it in their own words, and the test command with "
                "`claude-bp ci`, which proves it before writing it. Everything else under "
                ".claude/claude-bestpractice/ is yours to write."
            )

        # Bash is a write tool. An agent writes files with heredocs, `>`, `tee` and
        # `sed -i` constantly, and scanning only the structured write tools left the
        # credential check and the leases wide open to the most common way files get
        # written: `cat > .env <<EOF` carried a live key straight past a gate whose
        # whole purpose is to stop that, silently, while the doctor reported 23/23.
        content = proposed_content(event)
        hits = redact.find(content)
        if hits:
            # WHERE, not just what. Naming the detector alone left a founder deleting
            # lines they suspected, being refused again, and having no way to learn what
            # had matched — a file that could not be written by any route (#95). The
            # excerpt is scrubbed first: printing the value to prove a value was found
            # would put it in the transcript, which is the thing being prevented.
            where = "\n".join(
                f"  line {number}: {excerpt}  [{name}]"
                for name, number, excerpt in redact.locate(content)[:5]
            )
            hookio.deny_tool(
                f"claude-bestpractice: refusing this write — it contains what looks like a credential "
                f"({', '.join(hits)}).\n{where}\n"
                "Put it in an environment variable and reference it. Post-hoc cleanup does "
                "not work: the value is already on disk and in the transcript, which "
                ".gitignore does not cover."
            )

        # No card, no code. The Stop gate demands the work be on the board, but it demands
        # it at the END — a whole turn of edits happens first, and the founder's own
        # description of the failure is that the ledger gets remembered late or not at all.
        # Asked at the first write instead, which is where a task actually begins.
        #
        # Never a wedge: the way out is a Bash command, and Bash is not what this refuses.
        # The ledger's own files are exempt, or filing the card would be refused by the
        # rule demanding one.
        # Every write, not just the structured ones: this file already resolves what a
        # `sed -i` or a heredoc lands on — the leases and the secret scan both read it —
        # and leaving the ledger gate on `WRITE_TOOLS` alone meant a whole turn of shell
        # edits was invisible to the board while it happened.
        #
        # Still only once the founder has said what this session is for. Dropping that was
        # tried while fixing #141 and taken back out: `prompt-capture` sets the statement
        # from any first prompt that is not pasted output, so it is set in substantially
        # every real session — meaning the demand already fires at the first write there,
        # and removing the condition changed behaviour for every session on the strength
        # of a case that could not be reproduced. The half of #141 that IS proven is the
        # shell one above; a session whose first prompt was a paste still gets the Stop
        # demand, and is the narrow case left open deliberately.
        if cfg.require_task and rec.task_statement and writing_now:
            from claude_bestpractice import plan

            if not _ledger_covers(ctx, event.session_id, writing_now):
                hookio.deny_tool(
                    f"claude-bestpractice: nothing on the board says this session is working "
                    f"on {writing_now[0]}.\n"
                    "  Every sibling session reads the board to decide what is safe to "
                    "touch, and unlisted work is invisible to all of them — so this is "
                    "asked BEFORE the write, while there is still something to protect.\n"
                    f'  claude-bp-plan add "<what you are about to do>" --paths {writing_now[0]}\n'
                    "  then: claude-bp-plan claim <id>   (or claim the task you are on)"
                )

        # A registry being stood up beside the ledger, caught while it is one file rather
        # than three entry points and two commits. Structured writes only: a Bash line
        # that merely QUOTES a checkbox is not a registry, and this refuses rather than
        # warns, so a false positive costs the founder a document they meant to write.
        if event.tool_name in WRITE_TOOLS and absolute:
            from claude_bestpractice import migrate

            duplicate = migrate.second_ledger(ctx, absolute[0], content)
            if duplicate:
                hookio.deny_tool(duplicate)

        # One database per session, checked at the first write because that is where the
        # session commits to doing work here. Worktrees isolate files and nothing else:
        # every tree points at the same daemon, so one session's open transaction blocks
        # every sibling's tests on its locks — seventy seconds became twenty minutes on a
        # real repository, and the transaction had been open for nearly a day (#164).
        if cfg.isolate_databases and touched:
            clash = _sibling_on_the_same_database(ctx, event.session_id)
            if clash:
                hookio.deny_tool(
                    f"claude-bestpractice: session {clash[0][:8]} is already using the database "
                    f"`{clash[1]}`, and this tree points at the same one.\n"
                    "  Worktrees isolate files and nothing else — one open transaction "
                    "there stops the tests here, and neither side can see why.\n"
                    f"  Give this tree its own: set DATABASE_URL in {worktree.ENV_FILE} to "
                    "a database name nobody else holds.\n"
                    + config.switch_advice("isolate_databases", False)
                )

        # Claim the path. Two sessions editing one file is not a merge conflict — it is
        # a silent overwrite where neither side knows it happened, which is the defining
        # risk of the several-sessions-at-once operating mode.
        if cfg.leases_enabled and touched:
            owner = sessions.acquire_lease(
                ctx, event.session_id, touched[0], ttl=cfg.lease_ttl_seconds
            )
            if owner:
                other = sessions.get(ctx, owner)
                where = f" on branch {other.branch}" if other else ""
                # The refused session learns from the denial below. The HOLDER learns
                # nothing at all unless it is told, and it is the only one that can end
                # the wait — by finishing with the file or letting it go.
                # An ASK, not a notice. Telling the holder left them free to say nothing
                # and keep the file: the blocked session waited out the full TTL while the
                # holder had committed twenty minutes earlier and moved on. A question
                # their Stop gate will not let them end a turn on gets an answer.
                inbox.ask(
                    ctx, owner,
                    f"another session is blocked on {touched[0]}, which you hold. "
                    "Are you still in it, or can they take it?",
                    sender=event.session_id,
                )
                hookio.deny_tool(
                    f"claude-bestpractice: session {owner[:8]}{where} is editing {touched[0]} right now. "
                    "Work on something else, or coordinate before touching this file — "
                    "whoever writes second wins silently and neither of you would notice."
                )

    # Reached only when every gate allowed the call, so this records what was actually
    # written rather than what was attempted — and, for the same reason, what was actually
    # done rather than what was refused.
    if touched:
        sessions.touch(ctx, event.session_id, tool_calls=calls, last_touched=touched)
    else:
        sessions.touch(ctx, event.session_id, tool_calls=calls)

    # Last, and only here. `allow_tool` ends the permission pipeline, so a vouch placed any
    # earlier would walk past this gate's own refusals — the credential scan, the leases,
    # the protected-state rules — on its way to sparing the founder a prompt. At this line
    # every one of them has already allowed the call, and the only question left is whether
    # the founder should be asked about something the plugin itself ordered.
    if event.tool_name == "Bash":
        vouched = vouch.for_bash(ctx, str(ti.get("command", "")), cfg.test_command, session_cwd)
    elif event.tool_name in WRITE_TOOLS:
        vouched = vouch.for_write(ctx, event.session_id, absolute)
    else:
        vouched = vouch.for_tool(ctx, event.tool_name, ti)
    # Second, never first: a pull request call that any gate above refused never reaches
    # this line, and one that reached it has been judged rather than merely tolerated.
    vouched = vouched or pr_vouch
    if vouched:
        hookio.allow_tool(vouched)

    hookio.emit_silent()


if __name__ == "__main__":
    hookio.guard(main, fail_closed=True)
