#!/usr/bin/env python3
"""WorktreeCreate: own the worktree lifecycle. Replaces default git behaviour.

The hook prints the absolute path on stdout and ANY non-zero exit fails creation, so
this is a hard veto rather than a suggestion. Zero plugins in the surveyed ecosystem
use it — across 2,269 community plugins, sixteen even mention worktrees.

Three things happen here that nothing else can do:

1. NAMING BOUND TO WORK. The path is derived from the task or branch, outside the
   repository, so worktrees never pollute the working tree and never collide.

2. TRUST PRE-SEEDED. In an untrusted worktree every project `permissions.allow` entry
   is silently ignored, plugin hooks never run and the status line never runs — and in
   headless mode prompting means auto-denial. It fails safe and looks exactly like a
   model failure. Pre-seeding trust at birth is the only way to avoid that.

3. PER-WORKTREE DATABASE AND PORT. Worktrees isolate files but share the database
   daemon, ports and caches. Two sessions running the same dev server on the same port
   is a confusing failure that looks like a code bug.

Fails OPEN on anything unexpected: refusing to create a worktree because a nicety broke
would block the founder's whole workflow, and the gates that matter run inside the
worktree anyway.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from claude_bestpractice import hookio, worktree  # noqa: E402
from claude_bestpractice.gitctx import resolve  # noqa: E402

def main() -> None:
    event = hookio.read_event()
    ctx = hookio.repo(event.cwd or os.getcwd())

    requested = str(event.raw.get("path") or event.raw.get("worktreePath") or "")
    branch = str(event.raw.get("branch") or event.raw.get("ref") or "").strip() or "work"
    slug = worktree.slugify(branch)

    target = Path(requested) if requested else worktree.target_for(ctx, slug)
    target.parent.mkdir(parents=True, exist_ok=True)
    # The harness creates the tree here, so the exclude has to be in place before it does
    # — otherwise the founder's next status reports it as untracked work, which is the
    # whole reason these used to live outside the repository.
    worktree.hide(ctx)
    absolute = str(target)

    # Same provisioning the gate uses when it refuses a write in the main checkout, so the
    # two paths cannot drift into disagreeing about naming, trust or ports.
    worktree.record(ctx, slug, absolute, branch, worktree.trust(absolute))

    # The harness takes the path from stdout. Everything else is a side effect.
    sys.stdout.write(absolute)
    sys.stdout.flush()
    raise SystemExit(0)


if __name__ == "__main__":
    hookio.guard(main, fail_closed=False)
