#!/usr/bin/env python3
"""Stop: the spine. Completion is accepted on evidence, never on assertion.

Order matters. Scope drift is checked first because it is free and because a session
that edited files it was never asked to touch has a problem no passing suite excuses.

Escalation: the platform overrides a Stop hook after 8 consecutive blocks, so blocking
forever just burns turns and ends the turn anyway. After MAX_CONSECUTIVE_BLOCKS we
stop blocking and write a durable failure marker instead — the next session reads it
at start. A gate that wedges a founder's workflow gets uninstalled, and an uninstalled
gate enforces nothing.

Fails CLOSED: a crash blocks. If verification cannot run, "done" has not been earned.
"""

from __future__ import annotations

import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from founder_os import board, config, drafts, evidence, hookio, sessions, stage, store  # noqa: E402
from founder_os.gitctx import changed_files, resolve  # noqa: E402

BLOCK_COUNTER = "_consecutive_blocks"
FAILURE_MARKER = "unverified.jsonl"


def _blocks(rec: sessions.SessionRecord) -> int:
    value = rec.tool_signatures.get(BLOCK_COUNTER)
    return value if isinstance(value, int) else 0


def _bump_blocks(ctx, rec: sessions.SessionRecord, value: int) -> None:
    payload = dict(rec.tool_signatures)
    payload[BLOCK_COUNTER] = value
    sessions.touch(ctx, rec.session_id, tool_signatures=payload)


def _allow(ctx, rec: sessions.SessionRecord) -> None:
    """Let the turn end: reset the escalation counter and hand back the leases.

    Releasing matters on every allow path, including the nothing-changed one. A
    session that claimed a file and then finished without touching it would otherwise
    hold that path against its siblings for the full TTL.
    """
    _bump_blocks(ctx, rec, 0)
    sessions.release_all(ctx, rec.session_id)
    hookio.emit_silent()


def _give_up(ctx, rec: sessions.SessionRecord, reason: str, changed: list) -> None:
    """Record an unverified finish so it survives the turn and surfaces next session."""
    store.append_jsonl(
        store.tier_b(ctx, FAILURE_MARKER),
        {
            "session_id": rec.session_id,
            "branch": rec.branch,
            "baseline_commit": rec.baseline_commit,
            "reason": reason,
            "recorded_at": time.time(),
        },
    )
    board.add_open_item(
        ctx,
        item_id=f"unverified-{rec.session_id[:8]}-{int(time.time())}",
        text=f"UNVERIFIED finish on {rec.branch}: {reason[:200]}",
        branch=rec.branch,
        session_id=rec.session_id,
        # Stamped with the files this finish left unverified. Once they are rewritten,
        # the warning is about code that no longer exists and stops being asserted.
        subject_paths=changed[:20],
    )


def main() -> None:
    event = hookio.read_event()

    # Already inside a Stop-driven continuation: allow, or the gate loops on itself.
    if event.stop_hook_active:
        hookio.emit_silent()

    ctx = hookio.repo(event.cwd or os.getcwd())
    cfg = config.load(ctx)
    rec = sessions.get(ctx, event.session_id)
    if rec is None:
        # Re-register rather than allow. A missing record used to mean "finish freely",
        # which made the whole evidence requirement removable with `rm`.
        rec = sessions.adopt(ctx, event.session_id)

    resolved_stage, _ = stage.current(ctx, cfg.stage_override)
    gates = stage.gates_for(resolved_stage)

    # Harvest decision candidates from the turn's corrections. Cheap, textual, no model,
    # and it never blocks: drafting is a convenience and its failure must cost nothing.
    try:
        candidates = drafts.extract(
            drafts.user_turns(event.transcript_path), rec.branch, rec.session_id, rec.last_touched
        )
        if candidates:
            drafts.record(ctx, candidates)
    except Exception:  # noqa: BLE001 - a failed draft must never fail a turn
        pass

    attempts = _blocks(rec)
    # The test artifact is exempt from scope drift because THIS GATE demands it. Without
    # this the two checks deadlock: finish without evidence and you are blocked for the
    # missing artifact, produce it and you are blocked for touching a file the task did
    # not name. Found by running a whole project lifecycle end to end, not by reading.
    exempt = (
        list(cfg.exempt_paths)
        + [".claude/founder-os/", ".claude/"]
        + [g.split("/")[0] if "/" in g else g for g in cfg.artifact_globs]
    )
    changed = evidence.material_changes(changed_files(ctx, rec.baseline_commit), exempt)

    if not changed:
        _allow(ctx, rec)

    problems: list[str] = []

    if cfg.scope_drift_block and gates["scope_drift"]:
        drift = evidence.scope_drift(changed, rec.task_paths, exempt)
        if drift:
            shown = ", ".join(drift[:8]) + (f" (+{len(drift) - 8} more)" if len(drift) > 8 else "")
            problems.append(
                f"Scope drift: {shown} were modified but the task did not mention them.\n"
                f"Task was: {rec.task_statement[:200]}\n"
                "Revert what is out of scope, or state why it was necessary."
            )

    if gates["evidence_gate"]:
        verdict = evidence.verify(ctx, cfg.artifact_globs, changed, cfg.test_command)
        if not verdict.ok:
            problems.append(verdict.reason)
        elif gates["clean_rerun"] and (cfg.clean_rerun is not False):
            clean = evidence.clean_rerun(ctx, cfg.test_command)
            if not clean.ok:
                problems.append(clean.reason)

    if not problems:
        _allow(ctx, rec)

    reason = "\n\n".join(problems)

    if attempts >= evidence.MAX_CONSECUTIVE_BLOCKS:
        _give_up(ctx, rec, reason, changed)
        _bump_blocks(ctx, rec, 0)
        sys.stderr.write(
            "founder-os: finishing UNVERIFIED after "
            f"{attempts} blocked attempts. Recorded for the next session.\n"
        )
        hookio.emit_silent()

    _bump_blocks(ctx, rec, attempts + 1)
    hookio.block(
        f"founder-os [{attempts + 1}/{evidence.MAX_CONSECUTIVE_BLOCKS}] — not done yet.\n\n"
        f"{reason}\n\n"
        "Your description of what you did is not evidence and was not read."
    )


if __name__ == "__main__":
    hookio.guard(main, fail_closed=True)
