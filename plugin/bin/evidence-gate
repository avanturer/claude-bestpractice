#!/usr/bin/env python3
"""Stop: the spine. Completion is accepted on evidence, never on assertion.

Order matters. Scope drift is checked first because it is free and because a session
that edited files it was never asked to touch has a problem no passing suite excuses.

Escalation: the platform overrides a Stop hook after 8 consecutive blocks, so blocking
forever just burns turns and ends the turn anyway. After MAX_CONSECUTIVE_BLOCKS we
stop blocking and write a durable failure marker instead — the next session reads it
at start. A gate that wedges a founder's workflow gets uninstalled, and an uninstalled
gate enforces nothing.

Fails CLOSED: a crash blocks. If verification cannot run, "done" has not been earned.
"""

from __future__ import annotations

import contextlib
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from claude_bestpractice import attempts, board, config, discipline, drafts, evidence, hookio, inbox, options, pullrequest, sessions, stage, store, suites, worktree  # noqa: E402
from claude_bestpractice.gitctx import changed_files, resolve  # noqa: E402

BLOCK_COUNTER = "_consecutive_blocks"
FAILURE_MARKER = "unverified.jsonl"

BLOCK_REASON = "_last_block_reason"
BLOCK_PATHS = "_last_block_paths"
BLOCK_AT = "_last_block_at"
BLOCK_TREE = "_last_block_tree"

# A gap this long between blocks is not the thing the ceiling exists to stop. The ceiling
# catches a session looping — block, retry, block, retry, minutes apart — and lets it
# finish UNVERIFIED rather than burning turns forever. Four blocks spread across an
# afternoon are four separate attempts by a founder who went away in between, and the
# commonest reason they went away is that Claude stopped answering: the five-hour usage
# limit lands mid-turn, and the session resumes hours later with the counter exactly where
# it was. One more block then filed an UNVERIFIED finish and a permanent `outcome: failed`
# attempt against work whose only crime was being interrupted.
BLOCK_STREAK_SECONDS = 3600.0


def _blocks(rec: sessions.SessionRecord) -> int:
    """Blocks in the current streak. A long enough silence starts a new one."""
    value = rec.tool_signatures.get(BLOCK_COUNTER)
    if not isinstance(value, int) or value <= 0:
        return 0
    last = rec.tool_signatures.get(BLOCK_AT)
    if isinstance(last, (int, float)) and (time.time() - last) > BLOCK_STREAK_SECONDS:
        return 0
    return value


def _bump_blocks(ctx, rec: sessions.SessionRecord, value: int,
                 reason: str = "", changed: list | None = None, tree: str = "") -> None:
    """Count the block, and remember WHAT it was about.

    The ceiling branch had nothing to hand forward, so it wrote the literal string
    "continuation ceiling reached" over the real reason and an empty path list — and the
    empty list also skipped the attempts record entirely and left the open item with no
    subjects, so provenance could never retire it. The warning outlived the code it was
    about. Reported as issue #31.
    """
    payload = dict(rec.tool_signatures)
    payload[BLOCK_COUNTER] = value
    payload[BLOCK_AT] = time.time()
    if reason:
        payload[BLOCK_REASON] = reason[:2000]
        payload[BLOCK_PATHS] = list(changed or [])[:64]
        payload[BLOCK_TREE] = tree
    sessions.touch(ctx, rec.session_id, tool_signatures=payload)


def _asked_and_answered(ctx, rec: sessions.SessionRecord, reason: str, tree: str) -> bool:
    """The same refusal, over a tree nothing has changed since, after we said to stand down.

    All three conditions, and none of them is optional.

    The pull-request demand tells the session "report exactly this to the founder and stop.
    Do NOT push changes to make the check pass" — and the evidence gate then refused the
    finish until the check passed. The session obeyed the first gate and was refused by the
    second, four times, each refusal a full run of the suite: fourteen minutes of wall clock
    to re-answer a question whose answer this plugin had forbidden it to change (#206).

    So the streak collapses only where it has become a contradiction rather than a chance to
    fix something: the pull request is already with the founder, the refusal is the same one
    word for word, and the COMMITTED tree hashes to what the last block judged. A dirty tree
    hashes to nothing and never matches, so work in progress is never read as standing still.

    It does NOT accept the work. The turn ends UNVERIFIED — recorded, filed as a failed
    attempt, on the board — exactly as the ceiling would have ended it three turns later.
    """
    stored = rec.tool_signatures
    if not tree or stored.get(BLOCK_TREE) != tree:
        return False
    if stored.get(BLOCK_REASON) != reason[:2000]:
        return False
    return pullrequest.handed_off(ctx, ctx.branch)


def _remembered_block(rec: sessions.SessionRecord) -> tuple:
    """(reason, paths) from the blocks that led here, or the bare fallback."""
    stored = rec.tool_signatures
    reason = stored.get(BLOCK_REASON) if isinstance(stored.get(BLOCK_REASON), str) else ""
    paths = stored.get(BLOCK_PATHS) if isinstance(stored.get(BLOCK_PATHS), list) else []
    if not reason:
        return "continuation ceiling reached", []
    return f"continuation ceiling reached after: {reason}", list(paths)


def _closed_the_tree(ctx, rec: sessions.SessionRecord, cfg) -> str:
    """Remove this session's own worktree when the work in it is finished. Its line, or "".

    The phase nothing supported. Isolation works — zero mixed commits and zero confused
    HEADs in sixty days of three-to-eight parallel sessions — and CLOSING the work did not:
    fifteen of thirty-eight trees stood over a merged pull request, with a project rule
    that said to remove them and no mechanism that did (#220).

    Here rather than in the sweep that runs when a session is already dead, because the
    founder asked for it in exactly those terms: the session that finished the work is the
    one that should put the tree away, without asking. `worktree.finished` carries the
    conditions and every one of them is a fact; the removal itself is a `git worktree
    remove` with no `--force`, so a write that lands between the check and the act keeps
    the tree.

    Never allowed to cost a turn: a failure here is a tree left standing, which the board
    names on the next session start.
    """
    if not cfg.remove_finished_trees:
        return ""
    try:
        # Before the removal, never after: `ctx` is the tree itself on every session this
        # plugin sends into one, and every git call takes it as a working directory. Asked
        # afterwards, this raised FileNotFoundError inside a gate that fails CLOSED — so
        # the session that had just finished its work was blocked by the housekeeping that
        # followed it. Caught by the test below, which is why it is written down here.
        where = worktree.main_checkout(ctx)
        gone = worktree.release_mine(ctx, rec.session_id)
    except Exception:  # noqa: BLE001 - housekeeping must never be what ends a turn badly
        return ""
    if not gone:
        return ""
    path, branch = gone
    said = (
        f"claude-bestpractice removed the worktree {path} and its branch {branch}: the work "
        f"is in the trunk, the board is clear and git reported nothing left in the tree. "
        f"The shell is now in a directory that no longer exists — `cd {where}`."
    )
    # The founder sees the line above; the model sees this, at its next tool call, which is
    # the one place it matters — a shell standing in a directory that is gone otherwise
    # spends a call finding out the hard way.
    with contextlib.suppress(Exception):
        inbox.post(ctx, rec.session_id, said, sender="claude-bestpractice")
    return said


def _allow(ctx, rec: sessions.SessionRecord, cfg) -> None:
    """Let the turn end: reset the escalation counter and hand back the leases.

    Releasing matters on every allow path, including the nothing-changed one. A
    session that claimed a file and then finished without touching it would otherwise
    hold that path against its siblings for the full TTL.
    """
    _bump_blocks(ctx, rec, 0)
    sessions.release_all(ctx, rec.session_id)
    hookio.emit_silent(_closed_the_tree(ctx, rec, cfg))


def _give_up(ctx, rec: sessions.SessionRecord, reason: str, changed: list) -> None:
    """Record an unverified finish so it survives the turn and surfaces next session.

    Also files it as a failed ATTEMPT. A session that could not prove its work is the
    canonical thing a later session must not blindly redo — and the revert that usually
    follows destroys the only other trace of it.
    """
    if changed:
        attempts.record(
            ctx,
            title=(rec.task_statement or "unverified finish")[:120],
            why=f"Finished without proof. {reason[:600]}",
            paths=changed,
            outcome=attempts.FAILED,
            # `ctx.branch`, not `rec.branch` — the same fix the delivery marker below
            # already carries. The record's branch is where the session STARTED, and the
            # worktree rule pushes the agent to branch mid-session, so a dead end filed
            # against `main` is filed against a branch that never held the work. It is
            # then surfaced to sessions that cannot act on it and hidden from the one
            # that can.
            branch=ctx.branch or rec.branch,
            session_id=rec.session_id,
        )

    # `ctx.branch`, not `rec.branch`. The record's branch is where the session STARTED,
    # and an agent that branches mid-session — which is exactly what the worktree rule
    # pushes it to do — files the failure against a branch that no longer holds the work.
    # This marker is read back by `delivery.ready()` to refuse a pull request, so the
    # wrong name there blocks an innocent branch and lets the guilty one through.
    branch = ctx.branch or rec.branch

    store.append_jsonl(
        store.tier_b(ctx, FAILURE_MARKER),
        {
            "session_id": rec.session_id,
            "branch": branch,
            "baseline_commit": rec.baseline_commit,
            # Capped like `_bump_blocks` caps its own copy, and for a harder reason: this
            # file is APPEND-ONLY and clone-wide, and every `ready()` check parses all of
            # it. An uncapped reason carried whatever the suite printed, so one run that
            # failed with a base64 blob on a single line wrote that blob here permanently.
            "reason": reason[:2000],
            "recorded_at": time.time(),
        },
    )
    board.add_open_item(
        ctx,
        item_id=f"unverified-{rec.session_id[:8]}-{int(time.time())}",
        text=f"UNVERIFIED finish on {branch}: {reason[:200]}",
        branch=branch,
        session_id=rec.session_id,
        # Stamped with the files this finish left unverified. Once they are rewritten,
        # the warning is about code that no longer exists and stops being asserted.
        subject_paths=changed[:20],
    )


# The one thing a window holds that nothing on disk does: the finding reasoned out and
# never filed, the approach tried and abandoned. Asked from HERE and not from the
# `PreCompact` checkpoint where it used to live — that event can refuse a compaction but
# cannot produce a model call, so its refusal was read by the founder alone and cost them
# the `/compact` they had just typed. The note at the top of `plugin/bin/checkpoint`
# carries the measurement.
#
# Marked with an INT, and that is load-bearing rather than incidental: `pre-tool` rewrites
# `tool_signatures` on every allowed call and keeps only the integer-valued keys, so a
# marker stored as a string or a bool is dropped by the session's next tool call — and a
# once-per-session ask whose mark evaporates is an ask every turn.
NOTES_ASKED = "_notes_asked"


def _nothing_written_down(ctx, rec: sessions.SessionRecord) -> bool:
    """Has this session put nothing on disk that its own diff does not already say?

    Two places count, because two places are read back: an attempt, which `board.render`
    surfaces to the next session that touches the same paths, and the body of a card this
    session owns, which `checkpoint` carries into the restore after a compaction. A
    session that has written either has already answered what the demand asks for.

    An unreadable ledger answers "something was written". A gate that invents an
    interruption out of its own failure to read is worse than one that misses a note.
    """
    from claude_bestpractice import plan

    try:
        if any(a.session_id == rec.session_id for a in attempts.load_all(ctx)):
            return False
        mine = [t for t in plan.load_all(ctx) if t.owner == rec.session_id]
        # `plan.NO_DETAIL` is what `add` writes when the card was filed without one, so it
        # is the absence of a body rather than a body. Compared against the constant and
        # not against its spelling: every card this session ever filed reads as written
        # down the moment those two drift apart.
        return not any(t.body.strip() not in ("", plan.NO_DETAIL) for t in mine)
    except Exception:  # noqa: BLE001 - unreadable is not the same as empty; see above
        return False


def _notes_demand(ctx, rec: sessions.SessionRecord, changed: list) -> str:
    """The ask itself, naming the command that writes each field in THIS session's state.

    Commands that exist, and only those: the version of this demand that lived in the
    compaction hook spent the session's single interruption on `claude-bp-attempt record`
    (the verb is `add`), on `claim` to write a body it cannot write, and on
    `claude-bp-decide`, which offers a model no way to file anything at all — its drafts
    are harvested from the FOUNDER's corrections, so "say it plainly and it will be
    caught" was simply untrue. Two fields now, each with a command the session can run.
    """
    from claude_bestpractice import plan

    mine = [t for t in plan.load_all(ctx, plan.DOING) if t.owner == rec.session_id]
    if mine:
        learned = (f'claude-bp-plan update {mine[0].id} --note "<what this window learned '
                   'that the code does not say>"\n              (REPLACES the card body, '
                   'so keep what is still true)')
    else:
        learned = ('claude-bp-plan park "<what is left to do>" --paths '
                   f'{",".join(changed[:3])} --note "<what is known and where it stands>"')
    return (
        "claude-bestpractice: this turn is verified and may end. Before it does — and "
        "before a compaction, after which you will be nearly new — put on disk what is "
        "only in this conversation. Asked once per session, and not again.\n"
        f"  LEARNED   — {learned}\n"
        '  RULED OUT — claude-bp-attempt add "<approach>" --why "<why it failed>" '
        f"--paths {' '.join(changed[:3])}\n"
        "              (an approach abandoned and not written down is one the next "
        "window tries again)\n"
        "Write what is true, skip the field that is not, then finish. Nothing else is owed."
    )


def _ask_for_the_notes_once(ctx, rec: sessions.SessionRecord, cfg, changed: list) -> None:
    """Ask, once in a session's life, for the material a new window cannot recover.

    Three conditions, and each one is the cost of getting it wrong. ENOUGH WORK first:
    `notes_after_calls` tool calls, counted on our own session record rather than
    estimated from a transcript whose format is documented as internal — a session eight
    calls in has nothing to hand forward, and being asked anyway is what teaches an agent
    that this plugin is noise. NOTHING FILED second, so a session that has been writing
    its card and its dead ends as it went is never interrupted for doing the right thing.
    And ONCE, marked before the ask is raised exactly like the pull-request hand-off, so a
    session that ignores it, crashes, or reaches this line again three turns later does
    not meet it twice.

    `hookio.ask` and not `hookio.block`, and the difference is not cosmetic: a block is
    counted by the escalation above, and four of them end the turn UNVERIFIED and file a
    permanent failed attempt against work that passed its suite. Notes are worth one
    turn; they are not worth a false failure on the record.
    """
    if cfg.notes_after_calls <= 0 or rec.tool_calls < cfg.notes_after_calls:
        return
    if rec.tool_signatures.get(NOTES_ASKED):
        return
    if not _nothing_written_down(ctx, rec):
        return
    payload = dict(rec.tool_signatures)
    payload[NOTES_ASKED] = 1
    sessions.touch(ctx, rec.session_id, tool_signatures=payload)
    hookio.ask(_notes_demand(ctx, rec, changed))


def _work_the_siblings_cannot_see(ctx) -> bool:
    """Is there anything left for the board to warn the other sessions about?

    The demand counted files against `baseline_commit`, which is where this session
    STARTED — so a session whose work is finished, merged and pushed was told "46 file(s)
    changed and no task in the ledger is claimed by it" over a tree identical to the trunk.
    Claiming something then is worse than not: it puts work on the board that is not
    happening, and the board's whole value is that it does not lie (#149).

    Measured against the base branch instead, which is the question the demand is actually
    asking: commits this branch adds, or edits not yet committed. Either means a sibling
    could collide with something invisible to it; neither means there is nothing to see.

    Fails LOUD, not quiet: if the base cannot be determined the demand stands, because a
    gate that stands down whenever it is unsure is one that stands down in every unusual
    repository.
    """
    from claude_bestpractice import delivery, gitpolicy

    base = gitpolicy.default_branch(ctx)
    if not base:
        return True
    return bool(delivery.commits_since(ctx, base)) or delivery.dirty(ctx)


def _take_refusal(ctx, rec) -> dict:
    """The block this session was last given, cleared from the record as it is read.

    Cleared on EVERY Stop, whatever the gate goes on to decide. The question is about the
    turn that just ended, so carrying the marker into the next turn would hold an
    answered block against work that has nothing to do with it — which is what happened
    across the lifecycle fixture: refused in one phase, still being asked about it three
    phases and two suite runs later.
    """
    pending = rec.refusal if isinstance(rec.refusal, dict) else {}
    if pending:
        sessions.touch(ctx, rec.session_id, refusal={})
    return pending


def _refuse_to_end_on_an_unanswered_block(ctx, rec, pending: dict) -> None:
    """Refuse, once, a turn that ends on a block from this plugin nothing was done about.

    Asked LAST, where the turn would otherwise be allowed to end. Everything above is
    about the tree and answers first; this is about the shape of the turn, and putting it
    earlier would have it speak over the evidence demand that is the whole point of the
    gate.

    What it refuses is not the refusal — that one already happened and may well have been
    right. It is what the founder keeps being handed instead of their work: a gate says
    no, the session stops and reports that a plugin is in its way, and the person who
    installed this so they would not have to read hooks is asked what to do about a hook.
    The session is the one that can tell a right gate from a wrong one; it has the
    refusal, the call and the repository, and the founder has a sentence in a chat window.

    Raised at most ONCE per refusal — `_take_refusal` clears it before this can fire,
    exactly like the pull-request hand-off — and never for the refusals that genuinely
    wait on a person: `deny_for_founder` records nothing, so an unapproved merge still
    ends the turn (decision 0006).
    """
    if not pending or rec.tool_calls > int(pending.get("calls") or 0):
        return
    unresolved = pending
    hookio.block(
        "claude-bestpractice: this turn is ending on a block nothing was done about:\n"
        f"  {unresolved.get('said') or 'a gate refused a call'}\n"
        "  That block is this session's to resolve. Either the gate is right — in which "
        "case what it asked for is still owed and the work is unfinished — or it is "
        "wrong, and "
        '`claude-bp-report defect "<what it refused and why that is wrong>"` records it '
        "against the plugin without costing this turn.\n"
        "  Pick one, then finish the work by the shortest correct route. Reporting a "
        "gate to the founder is not a finish, and this is asked once."
    )


def main() -> None:
    event = hookio.read_event()
    # The tree this session works in, which is not always the directory the harness hands
    # us: `cd` inside a Bash call moves the shell and not the harness, so a session sent
    # into a worktree goes on reporting the main checkout. Judging a turn there means
    # judging a checkout this session was forbidden to write in and every sibling shares
    # (#213). `working_context` only ever redirects to a tree this plugin provisioned for
    # this session and git still has registered.
    ctx = worktree.working_context(hookio.repo(event.cwd or os.getcwd()), event.session_id)
    cfg = config.load(ctx)

    # Off means off, and it has to mean it in the gate that refuses a FINISH as much as in
    # the one that refuses a write — a plugin switched off that still holds the turn open
    # is not switched off (#215). Before the session record is touched, so a founder who
    # has stood the plugin down gets nothing written on their behalf either.
    standing_down, why = config.enforcing(ctx)
    if not standing_down:
        sys.stderr.write(f"claude-bestpractice: standing down — {why}.\n")
        hookio.emit_silent()

    rec = sessions.get(ctx, event.session_id)
    if rec is None:
        # Re-register rather than allow. A missing record used to mean "finish freely",
        # which made the whole evidence requirement removable with `rm`.
        rec = sessions.adopt(ctx, event.session_id)

    # Read and cleared here, at the top, so it can only ever be about THIS turn.
    pending_refusal = _take_refusal(ctx, rec)

    resolved_stage, _ = stage.current(ctx, cfg.stage_override)
    gates = stage.gates_for(resolved_stage)

    # Harvest decision candidates from the turn's corrections. Cheap, textual, no model,
    # and it never blocks: drafting is a convenience and its failure must cost nothing.
    try:
        candidates = drafts.extract(
            drafts.user_turns(event.transcript_path), rec.branch, rec.session_id, rec.last_touched
        )
        if candidates:
            drafts.record(ctx, candidates)
    except Exception:  # noqa: BLE001 - a failed draft must never fail a turn
        pass

    # stop_hook_active means "this turn already blocked once". It used to allow
    # unconditionally, which made the gate fire EXACTLY ONCE per user turn: block, then
    # every subsequent Stop in that turn passed with no verification, no unverified
    # record, and leases still held. Proven in a live session — the escalation ceiling of
    # four was unreachable past one. So the flag now bounds the LOOP, not the check:
    # verification still runs, and only the escalation ceiling can end the turn.
    blocked = _blocks(rec)
    if event.stop_hook_active and blocked >= evidence.MAX_CONSECUTIVE_BLOCKS:
        # Both ceiling exits describe the same outcome, and this is the one that fires in
        # the live loop — so it carries the same detail the other one always did.
        ceiling_reason, ceiling_paths = _remembered_block(rec)
        _give_up(ctx, rec, ceiling_reason, ceiling_paths)
        # What it just let go of does not come back. The founder still sees it — as an
        # unverified attempt and an open item — which is where a decision this gate could
        # not make belongs.
        evidence.settle_drift(ctx, rec.session_id, ceiling_paths)
        _bump_blocks(ctx, rec, 0)
        sys.stderr.write("claude-bestpractice: finishing UNVERIFIED — continuation ceiling reached.\n")
        _allow(ctx, rec, cfg)
    # A pull request this session opened and then walked away from. Checked before the
    # change list, because the whole failure is a turn that ends with nothing left to do
    # and a PR still sitting there — `changed` is empty in exactly that turn.
    #
    # Raised at most ONCE per pull request, and the hand-off is written before the block
    # rather than after: a session that ignores this, crashes, or hits the escalation
    # ceiling must not meet it again on its next Stop. One unignorable interruption is the
    # entire budget. Past that the board carries it, which is what stops it being
    # forgotten across sessions without wedging the one in front of us.
    if cfg.manage_pull_requests:
        # Asked before the record is read, because a merge this gate did not perform is
        # never recorded: merging from the website, from another clone, or with a shell
        # line the tokeniser declined leaves the obligation OPEN forever, and the founder
        # is then told to report a pull request that was merged and deleted days ago
        # (#205). The trunk is the authority; nothing here calls the network.
        pullrequest.reconcile(ctx, ctx.branch)
        waiting = pullrequest.unhanded(ctx, ctx.branch)
        if waiting is not None:
            blocking = pullrequest.blockers(ctx, str(waiting.get("base") or "main"))
            pullrequest.hand_off(ctx, waiting, blocking)
            board.add_open_item(
                ctx,
                item_id=f"pr-{ctx.branch}-{int(time.time())}",
                text=(f"PULL REQUEST open on {ctx.branch}: "
                      + (f"blocked by {blocking[0][:150]}" if blocking else "ready to merge")),
                branch=ctx.branch,
                session_id=rec.session_id,
                subject_paths=[],
            )
            hookio.block(pullrequest.stop_demand(
                waiting, blocking, accepted=config.approved(ctx, config.APPROVE_MERGE)
            ))
        elif not pullrequest.known(ctx, ctx.branch) and not pullrequest.demanded(ctx, ctx.branch):
            # Finished work that never became a pull request. Same budget as the demand
            # above — one interruption, marked before it is raised, so a session that
            # ignores it or dies does not meet it again.
            from claude_bestpractice import delivery, gitpolicy

            base = gitpolicy.default_branch(ctx) or "main"
            if not delivery.ready(ctx, base):
                pullrequest.note_demand(ctx, ctx.branch)
                board.add_open_item(
                    ctx,
                    item_id=f"pr-missing-{ctx.branch}-{int(time.time())}",
                    text=f"NO PULL REQUEST for finished work on {ctx.branch}",
                    branch=ctx.branch,
                    session_id=rec.session_id,
                    subject_paths=[],
                )
                hookio.block(pullrequest.open_demand(ctx.branch, base))

    # The test artifact is exempt from scope drift because THIS GATE demands it. Without
    # this the two checks deadlock: finish without evidence and you are blocked for the
    # missing artifact, produce it and you are blocked for touching a file the task did
    # not name. Found by running a whole project lifecycle end to end, not by reading.
    exempt = (
        list(cfg.exempt_paths)
        + [".claude/claude-bestpractice/", ".claude/"]
        + list(evidence.RUN_BYPRODUCTS)
    )
    # Artifact globs are matched AS GLOBS. Truncating `reports/**/*.xml` to `reports`
    # exempted every file under reports/ — so a repository whose source lives in
    # `reports/api/` had its whole service made invisible: `changed` came back empty, the
    # suite was never run, and Stop exited 0 in silence over a genuine regression. Same
    # for `target/` and `test-results/`, which are ordinary directory names.
    everything = changed_files(ctx, rec.baseline_commit)
    changed = evidence.material_changes(everything, exempt, artifact_globs=cfg.artifact_globs)

    # A HEURISTIC must never be the reason a change list became empty. The explicit path
    # exemptions are a deliberate statement that these files cannot break anything — a
    # turn that only touched `.claude/` genuinely needs no test run, and demanding one for
    # the gate's own bookkeeping is what teaches the agent the gate is noise.
    #
    # The glob and byproduct rules are guesses about directory names, and a wrong guess
    # there hides real source. So when they are what emptied the list, run the suite:
    # "I cannot tell what changed" must resolve to checking, never to certifying.
    if not changed:
        by_path = [
            rel for rel in everything
            if not any(rel == p or rel.startswith(p.rstrip("/") + "/") for p in exempt)
        ]
        if by_path:
            changed = by_path

    if not changed:
        # A turn that wrote nothing is the commonest way to end on a block: the write was
        # refused, so there is nothing to verify and nothing above this has anything to
        # say. Asked here as well as at the verified exit, and nowhere earlier — the
        # checks between the two are about the tree and answer first.
        _refuse_to_end_on_an_unanswered_block(ctx, rec, pending_refusal)
        _allow(ctx, rec, cfg)

    # Which suites answer for these files. In a single-project repository this is the one
    # command the repository has always had; in a repository with two projects it is only
    # the suites the diff reaches, so a mobile-only branch is no longer refused over a
    # backend test it never touched (#206).
    must_pass = suites.for_changes(ctx, cfg, changed)

    problems: list[str] = []

    if cfg.scope_drift_block and gates["scope_drift"]:
        # Two things are not drift, and both of them wedged a founder for a whole session.
        # What the gate has already given up on: asking again after deciding to let it go
        # is the gate contradicting itself, and `stop_hook_active` is false on the first
        # Stop of every new message, so each message bought one more block on the same
        # paths — forever. And what is already merged: that is not this session's
        # unreviewed change, it has been through whatever review the founder runs (#106).
        forgiven = set(evidence.settled_drift(ctx, rec.session_id))
        forgiven.update(evidence.landed(ctx, changed))
        # And what is already committed on this branch: it is in the flow this plugin
        # enforces, and re-raising it at every Stop of a long session is a demand nobody
        # present can satisfy.
        forgiven.update(evidence.committed(ctx, changed))
        drift = [p for p in evidence.scope_drift(changed, rec.task_paths, exempt)
                 if p not in forgiven]
        if drift:
            shown = ", ".join(drift[:8]) + (f" (+{len(drift) - 8} more)" if len(drift) > 8 else "")
            # "or state why it was necessary" was a false promise, and it was this gate
            # making it two lines above "your description was not read". Nothing reads
            # prose here, by decision 0002 — so an agent whose work is correct and whose
            # scope reading is wrong had exactly one available move: revert correct work.
            # Reported from a real session that hit it eight times running. The remedies
            # named now are the ones that exist.
            problems.append(
                f"Scope drift: {shown} were modified but the task did not mention them.\n"
                f"Task was: {rec.task_statement[:200]}\n"
                "Revert what is out of scope. If it IS in scope, this gate cannot be told "
                "so in prose — ask the founder to name those paths in their next message.\n"
                + config.switch_advice("scope_drift_block", False)
            )

    # A question a sibling put to this session, unanswered. The same shape as an open pull
    # request and an unlisted change: something somebody is waiting on that the session
    # can otherwise walk straight past, so it is refused at the finish rather than
    # mentioned. The escalation ceiling bounds it — four turns, not forever.
    asked = inbox.open_asks(ctx, rec.session_id)
    if asked:
        first = asked[0]
        problems.append(
            f"{len(asked)} question(s) from another session are unanswered. "
            f"{str(first.get('from') or 'a sibling')[:8]} asks: {first.get('text')}\n"
            f"  Answer it: claude-bp answer {str(first.get('key') or '')[:12]} \"<your answer>\"\n"
            "  They are blocked on the reply, and a session that never answers is one "
            "the others learn to work around."
        )

    if cfg.require_task and gates["ledger"]:
        # Work that changed files while the board says nothing is in flight. The ledger was
        # advisory in a product whose premise is that the board tells the truth about what
        # the other sessions are doing — so a session could rewrite the importer for three
        # hours and appear, to every sibling, to be doing nothing at all.
        #
        # Satisfied once per session and then never seen again, which is what makes this a
        # gate rather than nagging: one `claude-bp-plan add` or `claim`, and the rest of
        # the session passes here silently.
        from claude_bestpractice import plan

        # The same fact decides both halves. While there is work the siblings cannot see,
        # a card is owed; once there is none — nothing over the base branch, nothing
        # uncommitted — the work has landed and the card that claimed it is owed a close.
        # The ledger had no closing half at all before this: `complete` had one caller, the
        # CLI, so a card left `doing` only if somebody remembered the command, and card
        # 0050 in this repository sat there for four days over merged and tagged work.
        delivered = not _work_the_siblings_cannot_see(ctx)
        if delivered:
            # `pre-tool` closes the cards of a merge it gates itself, which is the ordinary
            # route and costs no turn. This is every other one: a merge on the website, a
            # branch fast-forwarded by hand, a push straight to a trunk. Nothing is
            # inferred here — the condition above IS the delivery, so the files the session
            # changed are the files the base branch now carries.
            plan.settle_delivered(ctx, rec.session_id, everything, "the base branch")

        mine = [t for t in plan.load_all(ctx, plan.DOING) if t.owner == rec.session_id]
        # And the ones it has already closed. The demand below is "say what you are doing";
        # a card this session added, claimed, did and closed answers it, and refusing on it
        # made closing the card the thing that triggered the refusal (#220).
        closed = [t for t in plan.load_all(ctx, plan.DONE) if t.owner == rec.session_id]
        if mine and delivered:
            # What the closure above could not account for: a card whose named files are
            # not in this session's diff at all. Refused rather than noted, because a note
            # is precisely the thing that was being forgotten — and the exit is `done` or
            # `pause`, never a question put to the founder, who accepted this work when
            # they accepted the merge (decision 0010).
            problems.append(plan.closure_demand(mine))
        if not mine and not closed and not delivered:
            problems.append(
                f"Nothing on the board says this session is working: {len(changed)} file(s) "
                "changed and no task in the ledger is claimed by it.\n"
                "  Every sibling session reads the board to decide what is safe to touch, "
                "and an unlisted change is invisible to all of them.\n"
                '  claude-bp-plan add "<what this turn is doing>" --paths '
                f"{','.join(changed[:3])}\n"
                "  then: claude-bp-plan claim <id>   (or claim the task you are already on)"
            )

    if cfg.compare_dependencies:
        uncompared = options.demand(ctx, changed, rec.baseline_commit)
        if uncompared:
            problems.append(uncompared)

    if cfg.block_unfinished_work:
        unfinished = discipline.introduced(ctx, changed, rec.baseline_commit)
        if unfinished:
            problems.append(discipline.render(unfinished))

    unverified_reason = ""
    if gates["evidence_gate"]:
        try:
            verdict = evidence.verify(ctx, cfg.artifact_globs, changed, cfg.test_command, must_pass)
        except Exception as exc:  # noqa: BLE001 - deliberate: see below
            # A crash inside verification used to escape into hookio.guard, which blocks
            # WITHOUT touching the escalation counter — so one bad glob in config.json
            # ("artifact_globs": ["/tmp/junit.xml"]) blocked every Stop, in every session,
            # in that repository, forever. Failing closed is right; failing closed with a
            # frozen counter is a wedge, and a wedged founder uninstalls the plugin.
            verdict = evidence.Verdict(
                False,
                f"claude-bestpractice could not verify this turn: {type(exc).__name__}: {exc}\n"
                "This is a fault in the gate or its configuration, not in your work. "
                "Check .claude/claude-bestpractice/config.json.",
            )
        if not verdict.ok:
            # Before blaming the session, ask whether the failure is even about its change:
            # a shared checkout three commits behind failed four tests that were green on
            # the trunk, and the gate called the suite red on work that was already merged
            # (#217, #220). Appended to the refusal rather than replacing it — nothing here
            # has observed the trunk's suite, so this says what it knows and blocks anyway.
            problems.append(verdict.reason + evidence.not_this_trees_code(
                ctx, evidence.failing_files(ctx, verdict), changed))
            # A red suite is everyone's problem: the board tells them "fix it before new
            # work", but the board is injected once at session start, so a session already
            # running builds on top of the break for hours without ever being told.
            #
            # Unless the run that failed shared its database with a neighbouring tree, in
            # which case it is not yet everyone's problem — it is not yet known to be a
            # problem at all. This message reaches every live session at once and reads as
            # a hard stop, and one run in a hand-made worktree on the shared database sent
            # it to ten of them over a suite that passed on the same commit in an isolated
            # tree (#182). The record is still written and this session is still refused;
            # what waits is the broadcast, until a run nobody could perturb confirms it.
            entry = evidence.red(ctx)
            if entry and not entry.get("shared_with"):
                inbox.broadcast(
                    ctx, rec.session_id,
                    f"the suite is RED on {rec.branch} — someone else's turn just failed "
                    "it. Anything you finish on top of this is finished on a break.",
                )
        elif verdict.unverified:
            # Allowed, but never silently. The alternative to recording this is either
            # blocking a repository that has no runnable suite — which the founder
            # uninstalls — or accepting a forgeable artifact as proof, which is the hole
            # this gate exists to close.
            unverified_reason = verdict.reason
        elif gates["clean_rerun"] and (cfg.clean_rerun is not False):
            # The same plan, or the tier that catches green-in-my-directory would quietly
            # run the wide suite the plan just decided not to run.
            #
            # DECLARED suites only. A fresh checkout of a subproject has no `node_modules`
            # and no virtualenv, so a runner this gate merely INFERRED would fail there for
            # reasons that are nothing to do with the code — and a refusal invented by an
            # inference is the one thing this plugin's guessing is not allowed to produce.
            for suite in must_pass or [suites.Suite("", tuple(cfg.test_command), True)]:
                if not suite.declared:
                    continue
                clean = evidence.clean_rerun(ctx, list(suite.command), suite.path)
                if not clean.ok:
                    problems.append(clean.reason)
                    break

    if not problems:
        _refuse_to_end_on_an_unanswered_block(ctx, rec, pending_refusal)
        if unverified_reason:
            _give_up(ctx, rec, unverified_reason, changed)
            sys.stderr.write(f"claude-bestpractice: finishing UNVERIFIED — {unverified_reason}\n")
        else:
            # Last, and only where the work stands up. A turn being refused has something
            # more urgent to say, and one finishing UNVERIFIED is already on the record as
            # a failure — asking either of them for notes is the gate talking over itself.
            _ask_for_the_notes_once(ctx, rec, cfg, changed)
        _allow(ctx, rec, cfg)

    reason = "\n\n".join(problems)
    tree = evidence.tree_hash(ctx)
    repeated = bool(blocked) and _asked_and_answered(ctx, rec, reason, tree)

    if blocked >= evidence.MAX_CONSECUTIVE_BLOCKS or repeated:
        _give_up(ctx, rec, reason, changed)
        _bump_blocks(ctx, rec, 0)
        sys.stderr.write(
            "claude-bestpractice: finishing UNVERIFIED — the same refusal over a tree "
            "nothing has changed since; asking again cannot answer it differently.\n"
            if repeated else
            "claude-bestpractice: finishing UNVERIFIED after "
            f"{blocked} blocked attempts. Recorded for the next session.\n"
        )
        hookio.emit_silent()

    _bump_blocks(ctx, rec, blocked + 1, reason=reason, changed=changed, tree=tree)
    hookio.block(
        f"claude-bestpractice [{blocked + 1}/{evidence.MAX_CONSECUTIVE_BLOCKS}] — not done yet.\n\n"
        f"{reason}\n\n"
        "Your description of what you did is not evidence and was not read."
    )


if __name__ == "__main__":
    hookio.guard(main, fail_closed=True)
