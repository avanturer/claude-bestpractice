#!/usr/bin/env python3
"""Stop: the spine. Completion is accepted on evidence, never on assertion.

Order matters. Scope drift is checked first because it is free and because a session
that edited files it was never asked to touch has a problem no passing suite excuses.

Escalation: the platform overrides a Stop hook after 8 consecutive blocks, so blocking
forever just burns turns and ends the turn anyway. After MAX_CONSECUTIVE_BLOCKS we
stop blocking and write a durable failure marker instead — the next session reads it
at start. A gate that wedges a founder's workflow gets uninstalled, and an uninstalled
gate enforces nothing.

Fails CLOSED: a crash blocks. If verification cannot run, "done" has not been earned.
"""

from __future__ import annotations

import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from claude_bestpractice import attempts, board, config, discipline, drafts, evidence, hookio, options, pullrequest, sessions, stage, store  # noqa: E402
from claude_bestpractice.gitctx import changed_files, resolve  # noqa: E402

BLOCK_COUNTER = "_consecutive_blocks"
FAILURE_MARKER = "unverified.jsonl"


def _blocks(rec: sessions.SessionRecord) -> int:
    value = rec.tool_signatures.get(BLOCK_COUNTER)
    return value if isinstance(value, int) else 0


BLOCK_REASON = "_last_block_reason"
BLOCK_PATHS = "_last_block_paths"


def _bump_blocks(ctx, rec: sessions.SessionRecord, value: int,
                 reason: str = "", changed: list | None = None) -> None:
    """Count the block, and remember WHAT it was about.

    The ceiling branch had nothing to hand forward, so it wrote the literal string
    "continuation ceiling reached" over the real reason and an empty path list — and the
    empty list also skipped the attempts record entirely and left the open item with no
    subjects, so provenance could never retire it. The warning outlived the code it was
    about. Reported as issue #31.
    """
    payload = dict(rec.tool_signatures)
    payload[BLOCK_COUNTER] = value
    if reason:
        payload[BLOCK_REASON] = reason[:2000]
        payload[BLOCK_PATHS] = list(changed or [])[:64]
    sessions.touch(ctx, rec.session_id, tool_signatures=payload)


def _remembered_block(rec: sessions.SessionRecord) -> tuple:
    """(reason, paths) from the blocks that led here, or the bare fallback."""
    stored = rec.tool_signatures
    reason = stored.get(BLOCK_REASON) if isinstance(stored.get(BLOCK_REASON), str) else ""
    paths = stored.get(BLOCK_PATHS) if isinstance(stored.get(BLOCK_PATHS), list) else []
    if not reason:
        return "continuation ceiling reached", []
    return f"continuation ceiling reached after: {reason}", list(paths)


def _allow(ctx, rec: sessions.SessionRecord) -> None:
    """Let the turn end: reset the escalation counter and hand back the leases.

    Releasing matters on every allow path, including the nothing-changed one. A
    session that claimed a file and then finished without touching it would otherwise
    hold that path against its siblings for the full TTL.
    """
    _bump_blocks(ctx, rec, 0)
    sessions.release_all(ctx, rec.session_id)
    hookio.emit_silent()


def _give_up(ctx, rec: sessions.SessionRecord, reason: str, changed: list) -> None:
    """Record an unverified finish so it survives the turn and surfaces next session.

    Also files it as a failed ATTEMPT. A session that could not prove its work is the
    canonical thing a later session must not blindly redo — and the revert that usually
    follows destroys the only other trace of it.
    """
    if changed:
        attempts.record(
            ctx,
            title=(rec.task_statement or "unverified finish")[:120],
            why=f"Finished without proof. {reason[:600]}",
            paths=changed,
            outcome=attempts.FAILED,
            # `ctx.branch`, not `rec.branch` — the same fix the delivery marker below
            # already carries. The record's branch is where the session STARTED, and the
            # worktree rule pushes the agent to branch mid-session, so a dead end filed
            # against `main` is filed against a branch that never held the work. It is
            # then surfaced to sessions that cannot act on it and hidden from the one
            # that can.
            branch=ctx.branch or rec.branch,
            session_id=rec.session_id,
        )

    # `ctx.branch`, not `rec.branch`. The record's branch is where the session STARTED,
    # and an agent that branches mid-session — which is exactly what the worktree rule
    # pushes it to do — files the failure against a branch that no longer holds the work.
    # This marker is read back by `delivery.ready()` to refuse a pull request, so the
    # wrong name there blocks an innocent branch and lets the guilty one through.
    branch = ctx.branch or rec.branch

    store.append_jsonl(
        store.tier_b(ctx, FAILURE_MARKER),
        {
            "session_id": rec.session_id,
            "branch": branch,
            "baseline_commit": rec.baseline_commit,
            "reason": reason,
            "recorded_at": time.time(),
        },
    )
    board.add_open_item(
        ctx,
        item_id=f"unverified-{rec.session_id[:8]}-{int(time.time())}",
        text=f"UNVERIFIED finish on {branch}: {reason[:200]}",
        branch=branch,
        session_id=rec.session_id,
        # Stamped with the files this finish left unverified. Once they are rewritten,
        # the warning is about code that no longer exists and stops being asserted.
        subject_paths=changed[:20],
    )


def main() -> None:
    event = hookio.read_event()
    ctx = hookio.repo(event.cwd or os.getcwd())
    cfg = config.load(ctx)
    rec = sessions.get(ctx, event.session_id)
    if rec is None:
        # Re-register rather than allow. A missing record used to mean "finish freely",
        # which made the whole evidence requirement removable with `rm`.
        rec = sessions.adopt(ctx, event.session_id)

    resolved_stage, _ = stage.current(ctx, cfg.stage_override)
    gates = stage.gates_for(resolved_stage)

    # Harvest decision candidates from the turn's corrections. Cheap, textual, no model,
    # and it never blocks: drafting is a convenience and its failure must cost nothing.
    try:
        candidates = drafts.extract(
            drafts.user_turns(event.transcript_path), rec.branch, rec.session_id, rec.last_touched
        )
        if candidates:
            drafts.record(ctx, candidates)
    except Exception:  # noqa: BLE001 - a failed draft must never fail a turn
        pass

    # stop_hook_active means "this turn already blocked once". It used to allow
    # unconditionally, which made the gate fire EXACTLY ONCE per user turn: block, then
    # every subsequent Stop in that turn passed with no verification, no unverified
    # record, and leases still held. Proven in a live session — the escalation ceiling of
    # four was unreachable past one. So the flag now bounds the LOOP, not the check:
    # verification still runs, and only the escalation ceiling can end the turn.
    blocked = _blocks(rec)
    if event.stop_hook_active and blocked >= evidence.MAX_CONSECUTIVE_BLOCKS:
        # Both ceiling exits describe the same outcome, and this is the one that fires in
        # the live loop — so it carries the same detail the other one always did.
        ceiling_reason, ceiling_paths = _remembered_block(rec)
        _give_up(ctx, rec, ceiling_reason, ceiling_paths)
        _bump_blocks(ctx, rec, 0)
        sys.stderr.write("claude-bestpractice: finishing UNVERIFIED — continuation ceiling reached.\n")
        _allow(ctx, rec)
    # A pull request this session opened and then walked away from. Checked before the
    # change list, because the whole failure is a turn that ends with nothing left to do
    # and a PR still sitting there — `changed` is empty in exactly that turn.
    #
    # Raised at most ONCE per pull request, and the hand-off is written before the block
    # rather than after: a session that ignores this, crashes, or hits the escalation
    # ceiling must not meet it again on its next Stop. One unignorable interruption is the
    # entire budget. Past that the board carries it, which is what stops it being
    # forgotten across sessions without wedging the one in front of us.
    if cfg.manage_pull_requests:
        waiting = pullrequest.unhanded(ctx, ctx.branch)
        if waiting is not None:
            blocking = pullrequest.blockers(ctx, str(waiting.get("base") or "main"))
            pullrequest.hand_off(ctx, waiting, blocking)
            board.add_open_item(
                ctx,
                item_id=f"pr-{ctx.branch}-{int(time.time())}",
                text=(f"PULL REQUEST open on {ctx.branch}: "
                      + (f"blocked by {blocking[0][:150]}" if blocking else "ready to merge")),
                branch=ctx.branch,
                session_id=rec.session_id,
                subject_paths=[],
            )
            hookio.block(pullrequest.stop_demand(waiting, blocking))

    # The test artifact is exempt from scope drift because THIS GATE demands it. Without
    # this the two checks deadlock: finish without evidence and you are blocked for the
    # missing artifact, produce it and you are blocked for touching a file the task did
    # not name. Found by running a whole project lifecycle end to end, not by reading.
    exempt = (
        list(cfg.exempt_paths)
        + [".claude/claude-bestpractice/", ".claude/"]
        + list(evidence.RUN_BYPRODUCTS)
    )
    # Artifact globs are matched AS GLOBS. Truncating `reports/**/*.xml` to `reports`
    # exempted every file under reports/ — so a repository whose source lives in
    # `reports/api/` had its whole service made invisible: `changed` came back empty, the
    # suite was never run, and Stop exited 0 in silence over a genuine regression. Same
    # for `target/` and `test-results/`, which are ordinary directory names.
    everything = changed_files(ctx, rec.baseline_commit)
    changed = evidence.material_changes(everything, exempt, artifact_globs=cfg.artifact_globs)

    # A HEURISTIC must never be the reason a change list became empty. The explicit path
    # exemptions are a deliberate statement that these files cannot break anything — a
    # turn that only touched `.claude/` genuinely needs no test run, and demanding one for
    # the gate's own bookkeeping is what teaches the agent the gate is noise.
    #
    # The glob and byproduct rules are guesses about directory names, and a wrong guess
    # there hides real source. So when they are what emptied the list, run the suite:
    # "I cannot tell what changed" must resolve to checking, never to certifying.
    if not changed:
        by_path = [
            rel for rel in everything
            if not any(rel == p or rel.startswith(p.rstrip("/") + "/") for p in exempt)
        ]
        if by_path:
            changed = by_path

    if not changed:
        _allow(ctx, rec)

    problems: list[str] = []

    if cfg.scope_drift_block and gates["scope_drift"]:
        drift = evidence.scope_drift(changed, rec.task_paths, exempt)
        if drift:
            shown = ", ".join(drift[:8]) + (f" (+{len(drift) - 8} more)" if len(drift) > 8 else "")
            # "or state why it was necessary" was a false promise, and it was this gate
            # making it two lines above "your description was not read". Nothing reads
            # prose here, by decision 0002 — so an agent whose work is correct and whose
            # scope reading is wrong had exactly one available move: revert correct work.
            # Reported from a real session that hit it eight times running. The remedies
            # named now are the ones that exist.
            problems.append(
                f"Scope drift: {shown} were modified but the task did not mention them.\n"
                f"Task was: {rec.task_statement[:200]}\n"
                "Revert what is out of scope. If it IS in scope, this gate cannot be told "
                "so in prose — ask the founder to name those paths in their next message, "
                'or to set {"scope_drift_block": false} in '
                f"{store.tier_a(ctx, config.CONFIG_NAME)}."
            )

    if cfg.compare_dependencies:
        uncompared = options.demand(ctx, changed, rec.baseline_commit)
        if uncompared:
            problems.append(uncompared)

    if cfg.block_unfinished_work:
        unfinished = discipline.introduced(ctx, changed, rec.baseline_commit)
        if unfinished:
            problems.append(discipline.render(unfinished))

    unverified_reason = ""
    if gates["evidence_gate"]:
        try:
            verdict = evidence.verify(ctx, cfg.artifact_globs, changed, cfg.test_command)
        except Exception as exc:  # noqa: BLE001 - deliberate: see below
            # A crash inside verification used to escape into hookio.guard, which blocks
            # WITHOUT touching the escalation counter — so one bad glob in config.json
            # ("artifact_globs": ["/tmp/junit.xml"]) blocked every Stop, in every session,
            # in that repository, forever. Failing closed is right; failing closed with a
            # frozen counter is a wedge, and a wedged founder uninstalls the plugin.
            verdict = evidence.Verdict(
                False,
                f"claude-bestpractice could not verify this turn: {type(exc).__name__}: {exc}\n"
                "This is a fault in the gate or its configuration, not in your work. "
                "Check .claude/claude-bestpractice/config.json.",
            )
        if not verdict.ok:
            problems.append(verdict.reason)
        elif verdict.unverified:
            # Allowed, but never silently. The alternative to recording this is either
            # blocking a repository that has no runnable suite — which the founder
            # uninstalls — or accepting a forgeable artifact as proof, which is the hole
            # this gate exists to close.
            unverified_reason = verdict.reason
        elif gates["clean_rerun"] and (cfg.clean_rerun is not False):
            clean = evidence.clean_rerun(ctx, cfg.test_command)
            if not clean.ok:
                problems.append(clean.reason)

    if not problems:
        if unverified_reason:
            _give_up(ctx, rec, unverified_reason, changed)
            sys.stderr.write(f"claude-bestpractice: finishing UNVERIFIED — {unverified_reason}\n")
        _allow(ctx, rec)

    reason = "\n\n".join(problems)

    if blocked >= evidence.MAX_CONSECUTIVE_BLOCKS:
        _give_up(ctx, rec, reason, changed)
        _bump_blocks(ctx, rec, 0)
        sys.stderr.write(
            "claude-bestpractice: finishing UNVERIFIED after "
            f"{blocked} blocked attempts. Recorded for the next session.\n"
        )
        hookio.emit_silent()

    _bump_blocks(ctx, rec, blocked + 1, reason=reason, changed=changed)
    hookio.block(
        f"claude-bestpractice [{blocked + 1}/{evidence.MAX_CONSECUTIVE_BLOCKS}] — not done yet.\n\n"
        f"{reason}\n\n"
        "Your description of what you did is not evidence and was not read."
    )


if __name__ == "__main__":
    hookio.guard(main, fail_closed=True)
