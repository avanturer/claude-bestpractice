#!/usr/bin/env python3
"""One command to see everything: what is known, in flight, planned and enforced.

The transparency the founder asked for — "like in a big company, visible and
sequential" — is this view. It reads only committed files and the shared coordination
directory, so it is correct from any worktree and needs nothing running.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN.parent / "lib"))

from claude_bestpractice import __version__, board, ci, conflicts, defects, delivery, drafts, hookio, knowledge, onboard, pullrequest  # noqa: E402
from claude_bestpractice import plan, provenance, sessions, stage, upgrade  # noqa: E402
from claude_bestpractice.gitctx import resolve_for_cli  # noqa: E402

BOLD = "\033[1m" if sys.stdout.isatty() else ""
DIM = "\033[2m" if sys.stdout.isatty() else ""
OFF = "\033[0m" if sys.stdout.isatty() else ""


def heading(text: str) -> None:
    print(f"\n{BOLD}{text}{OFF}")


def cmd_status(ctx) -> int:
    # `record=False`: reading the status must not write a stage marker into the working
    # tree. It did, and left it untracked, so `git status` came back dirty after a
    # command whose entire job is to look.
    resolved_stage, signals = stage.current(ctx, record=False)
    counts = plan.summary(ctx)
    live = sessions.live_sessions(ctx)
    items = board.open_items(ctx)
    prov = provenance.summarize(items)
    layer = knowledge.load(ctx)
    problems = knowledge.validate(ctx)
    gaps = onboard.unanswered(ctx)
    pending = drafts.pending(ctx)

    print(f"{BOLD}claude-bestpractice {__version__}{OFF}  {ctx.repo_name} @ {ctx.branch}")
    print(f"{DIM}stage: {resolved_stage} — {'; '.join(signals.reasons[:3]) or 'no signals yet'}{OFF}")

    # Only when the running copy is not the installed one. `claude plugin update` says
    # "Restart to apply changes" once and is never heard from again, so a session can run
    # superseded code indefinitely with nothing anywhere saying so.
    bad = upgrade.known_bad()
    if bad:
        print(f"  {bad}")

    newer = upgrade.superseded_by()
    if newer:
        print(f"  {newer} is installed but NOT running — restart Claude Code to pick it up")
    elif upgrade.orphaned():
        print("  this copy has been superseded — restart Claude Code to pick up the new one")

    heading("CHECKS")
    for line in ci.status_lines(ctx):
        print(f"  {line}" if line else "")

    heading("SESSIONS")
    if live:
        for rec in live:
            held = sessions.leases_held_by(ctx, rec.session_id)
            print(f"  {rec.session_id[:8]}  {rec.branch:<20} {Path(rec.worktree).name}")
            if rec.task_statement:
                print(f"      task: {rec.task_statement[:100]}")
            if held:
                print(f"      holds: {', '.join(held[:4])}")
    else:
        print("  none live")

    # Never injected into a session — a defect in the tooling is not the agent's problem
    # to read about mid-task. It appears here, where the founder is already looking.
    captured = defects.line(ctx)
    if captured:
        heading("PLUGIN")
        print(f"  {captured}")

    waiting = pullrequest.outstanding(ctx)
    if waiting:
        heading("PULL REQUESTS")
        for row in waiting:
            named = f"#{row['number']}" if row.get("number") else row.get("branch", "")
            reasons = row.get("blockers") or []
            state = f"BLOCKED — {reasons[0][:90]}" if reasons else "ready to merge"
            print(f"  {named:<24} {state}")

    heading("PLAN")
    print(f"  {counts['doing']} in flight · {counts['next']} next · {counts['done']} done")
    for task in plan.load_all(ctx, plan.DOING):
        owner = f"[{task.owner[:8]}]" if task.owner else "[unclaimed]"
        print(f"    doing  {task.id}  {task.title[:70]} {owner}")
    for task in plan.load_all(ctx, plan.NEXT)[:5]:
        print(f"    next   {task.id}  {task.title[:70]}")

    heading("KNOWLEDGE")
    print(
        f"  {len(layer.entities)} entities · {len(knowledge.decision_files(ctx))} decisions · "
        f"{layer.total_bytes}/{knowledge.LAYER_MAX_BYTES} bytes"
    )
    if gaps:
        for gap in gaps:
            print(f"  {DIM}unanswered: {gap}{OFF}")
    for problem in problems[:5]:
        print(f"  problem: {problem}")
    if pending:
        print(f"  {len(pending)} decision draft(s) waiting — `claude-bp-decide list`")

    heading("MEMORY HEALTH")
    stale = prov.get(provenance.SUSPECT, 0) + prov.get(provenance.GONE, 0)
    print(f"  {prov.get(provenance.FRESH, 0)} live claim(s), {stale} stale and suppressed")
    print(f"  {DIM}{board.health_line(ctx, len(live), 0)}{OFF}")

    found = conflicts.detect(ctx)
    if found:
        heading("CONFLICTS")
        for conflict in found[:6]:
            print(f"  {conflict}")
        print(f"  {DIM}`claude-bp adopt` neutralises what can be neutralised{OFF}")

    heading("NEXT ACTION")
    if found and any(c.action == "quarantine" for c in found):
        print("  Another tool contests an event we own: `claude-bp adopt`")
    elif gaps:
        print("  Answer the placeholders in .claude/rules/product.md — nothing else derives them.")
    elif not onboard.present(ctx):
        # "Repair the knowledge layer" was the first thing a fresh install printed, about
        # a layer that had never been built. Nothing was broken; nothing was there. It
        # also named a third command, so one condition produced `claude-bp-knowledge
        # init` on one line and `claude-bp-knowledge validate` on the next, and the
        # README's own `claude-bp init` on neither.
        print("  Build the knowledge layer from this repository: `claude-bp init`")
    elif problems:
        print("  Repair the knowledge layer: `claude-bp-knowledge validate`")
    elif counts["doing"] == 0 and counts["next"] > 0:
        print("  Claim a task: `claude-bp-plan claim <id>`")
    elif pending:
        print("  Review drafted decisions: `claude-bp-decide list`")
    else:
        print("  Nothing blocking. `claude-bp-doctor` proves the gates still fire.")
    print()
    return 0


def cmd_init(ctx, force: bool) -> int:
    written = onboard.write(ctx, force=force)
    print(f"{BOLD}claude-bp init{OFF}  {ctx.worktree_root}")
    if written:
        # "derived from your code" over a file reading "No types were central enough to
        # derive automatically" is a small untruth, and small untruths in this output are
        # how a founder stops reading it. Say which files carry an answer and which
        # carry a question.
        empty = onboard.awaiting_you(ctx, written)
        derived = [rel for rel in written if rel not in empty]
        if derived:
            print("\nderived from your code:")
            for rel in derived:
                print(f"  {rel}")
        if empty:
            print("\ncreated, but nothing could be derived — they say what they need:")
            for rel in empty:
                print(f"  {rel}")
    else:
        print("\nknowledge layer already present (use --force to regenerate)")

    changed, note = ci.install(ctx)
    if changed:
        print(f"\nchecks now run before every push: {note}")

    gaps = onboard.unanswered(ctx)
    if gaps:
        print("\nwaiting on you — these cannot be derived and must not be invented:")
        for gap in gaps:
            print(f"  {gap}")
    print("\nThen: `claude-bp status`")
    return 0


def cmd_doctor(_ctx) -> int:
    return subprocess.run([sys.executable, str(BIN / "claude-bp-doctor")]).returncode


def cmd_adopt(ctx, dry_run: bool, restore: bool) -> int:
    """Take over the events we own from whatever else is contesting them.

    Contradictory instruction is the failure this exists to prevent, and the harness
    resolves a contradiction by picking one arbitrarily. Quarantine, never delete:
    another tool's configuration may be load-bearing for something unrelated, and a
    plugin that silently removes it is one that gets uninstalled in anger.
    """
    if restore:
        count = conflicts.restore_quarantined(ctx)
        print(f"restored {count} quarantined hook entr{'y' if count == 1 else 'ies'}")
        return 0

    found = conflicts.detect(ctx)
    print(conflicts.render(found))
    if not found:
        return 0

    if dry_run:
        print("\ndry run: nothing changed")
        return 0

    moved, backups = conflicts.quarantine_loose_hooks(ctx)
    if moved:
        print(f"\nquarantined {moved} contesting hook entr{'y' if moved == 1 else 'ies'}")
        for backup in backups:
            print(f"  backup: {backup}")
        print("  undo with `claude-bp adopt --restore`")

    excludes = conflicts.exclusion_settings(found)
    if excludes:
        print("\nAdd to ~/.claude/settings.json so these stop being concatenated:")
        print("  " + json.dumps(excludes))

    plugins = [c for c in found if c.kind == "competing-plugin"]
    if plugins:
        print("\nA plugin cannot disable another plugin — no such field exists. Run:")
        for conflict in plugins:
            print(f"  claude plugin disable {conflict.where}")
    return 0


def cmd_dismiss(ctx, detector: str, path: str) -> int:
    """Rule one finding false. The only exit a false positive had before this was to
    rewrite correct code or to stop using the gate (#75)."""
    from claude_bestpractice import board

    board.dismiss(ctx, detector, path)
    print(f"{detector} in {path} will not block a merge again")
    print(f"  recorded in {board.DISMISSED} — commit it, the judgement is about the code")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="claude-bp", description="claude-bestpractice control plane")
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("status", help="what is known, in flight, planned and enforced (default)")
    init = sub.add_parser("init", help="derive the knowledge layer from this repository")
    init.add_argument("--force", action="store_true")
    sub.add_parser("doctor", help="prove every gate still fires")
    adopt = sub.add_parser("adopt", help="take over events another tool is contesting")
    adopt.add_argument("--dry-run", action="store_true", help="report without changing anything")
    adopt.add_argument("--restore", action="store_true", help="undo a previous adopt")
    dismiss = sub.add_parser(
        "dismiss", help="rule a review finding false, for good — it stops blocking merges")
    dismiss.add_argument("detector", help="the name in the finding, e.g. sql-interpolation")
    dismiss.add_argument("path", help="the file it was raised against")

    args = parser.parse_args()
    ctx = resolve_for_cli()

    if args.command == "init":
        return cmd_init(ctx, args.force)
    if args.command == "doctor":
        return cmd_doctor(ctx)
    if args.command == "dismiss":
        return cmd_dismiss(ctx, args.detector, args.path)
    if args.command == "adopt":
        return cmd_adopt(ctx, args.dry_run, args.restore)
    return cmd_status(ctx)


if __name__ == "__main__":
    raise SystemExit(hookio.run_cli(main))
