{
  "$comment": [
    "Nine entries across eight events. Budget is 12 for the whole plugin; a thirteenth requires deleting one.",
    "",
    "PROTOCOL, because these are the cheap ways to ship a gate that enforces nothing:",
    "  - Exit 2 blocks. Exit 1 is a NON-blocking error and the tool RUNS.",
    "  - The event arrives on STDIN as JSON. TOOL_NAME / TOOL_INPUT env vars do not exist.",
    "  - type 'http' fails OPEN on non-2xx, timeout and connection error. Never use it for a gate.",
    "",
    "Verify with `plugin/bin/founder-os-doctor`, which proves each gate by attempting a",
    "known-bad action rather than reading this file back."
  ],

  "hooks": {
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/setup",
            "timeout": 120,
            "once": true,
            "statusMessage": "founder-os: deriving project knowledge"
          }
        ]
      }
    ],

    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/worktree-create",
            "timeout": 60,
            "statusMessage": "founder-os: provisioning worktree"
          }
        ]
      }
    ],

    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/session-start",
            "timeout": 30,
            "statusMessage": "founder-os: session board"
          }
        ]
      }
    ],

    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/prompt-capture",
            "timeout": 15
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/pre-tool",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/review-commit",
            "if": "Bash(git commit:*)",
            "timeout": 300,
            "asyncRewake": true,
            "rewakeMessage": "founder-os finished reviewing your commit.",
            "statusMessage": "founder-os: reviewing"
          }
        ]
      }
    ],

    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/subagent-brief",
            "timeout": 15
          }
        ]
      }
    ],

    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/checkpoint",
            "timeout": 60,
            "statusMessage": "founder-os: checkpoint"
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/evidence-gate",
            "timeout": 900,
            "statusMessage": "founder-os: verifying"
          }
        ]
      }
    ]
  }
}
