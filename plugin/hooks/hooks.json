{
  "modules": ["./bestpractice.ts"],
  "hooks": {
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/setup\"",
            "timeout": 120,
            "once": true,
            "statusMessage": "claude-bestpractice: deriving project knowledge"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/worktree-create\"",
            "timeout": 60,
            "statusMessage": "claude-bestpractice: provisioning worktree"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/session-start\"",
            "timeout": 30,
            "statusMessage": "claude-bestpractice: session board"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/prompt-capture\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|EnterWorktree|Agent|Task|WebSearch|CronCreate|ScheduleWakeup|SendMessage|AskUserQuestion)$|__((create|merge|update)_pull_request|enable_pr_auto_merge|pull_request_read|web_search(_advanced)?(_exa)?|web_fetch(_exa)?|web_decisions|write_file|edit_file|create_directory|move_file|create_text_file|replace_content|replace_in_files|insert_at_line|replace_symbol_body|insert_after_symbol|insert_before_symbol|rename_symbol|delete_lines|replace_lines|safe_delete_symbol)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pre-tool\"",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/review-commit\"",
            "if": "Bash(git commit:*)",
            "timeout": 300,
            "asyncRewake": true,
            "rewakeMessage": "claude-bestpractice finished reviewing your commit.",
            "statusMessage": "claude-bestpractice: reviewing"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(TaskStop|AskUserQuestion|Edit|Write|MultiEdit)$|.*((create|update|merge)_pull_request|enable_pr_auto_merge)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pr-opened\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pr-opened\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/subagent-brief\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/checkpoint\"",
            "timeout": 60,
            "statusMessage": "claude-bestpractice: checkpoint"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/evidence-gate-after-the-turn\"",
            "timeout": 3600,
            "asyncRewake": true,
            "rewakeMessage": "claude-bestpractice checked the finished turn.",
            "statusMessage": "claude-bestpractice: verifying"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/permission-denied\""
          }
        ]
      }
    ]
  }
}
